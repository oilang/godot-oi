module godot

## GDExtension handshake.

## GDExtensionInitializeCallback
pub Callback :: @c fn(userdata: ptr, level: i32)

## GDExtensionInitializationLevel
pub Level :: enum { core, servers, scene, editor }

## GDExtensionInitialization
@c Init :: struct { minimum_level: i32, userdata: ptr, initialize: Callback, deinitialize: Callback }

## What Godot hands us at load, plus the interface fns fetched from it.
## Callbacks get it back as `userdata`.
@c pub Godot :: struct {
	get_proc: GetProc,
	library: ptr,
	get_version: GetVersion,
	new_string_name: NewStringName,
	drop_string_name: Destructor,
	new_string: NewString,
	string_utf8: StringUtf8,
	drop_string: Destructor,
	variant_from_type: GetFromType,
	variant_to_type: GetToType,
	variant_type: VariantGetType,
	variant_destroy: VariantDestroy,
	variant_can_convert: CanConvert,
	register_class: RegisterClass,
	unregister_class: UnregisterClass,
	register_method: RegisterMethod,
	register_property: RegisterProperty,
	construct_object: ConstructObject,
	set_instance: SetInstance,
	get_method_bind: GetMethodBind,
	method_bind_call: MethodBindCall,
	classes: ptr,
	binds: ptr,
}

## Global, filled by `setup`.
pub gd := Godot.{}

## Fill in `GDExtensionInitialization` from the entrypoint.
pub setup :: fn(get_proc: GetProc, library: ptr, out: ptr, initialize: Callback, deinitialize: Callback) bool {
	get_version :: unsafe GetVersion(get_proc("get_godot_version2"))
	new_string_name :: unsafe NewStringName(get_proc("string_name_new_with_latin1_chars"))
	get_destructor :: unsafe GetDestructor(get_proc("variant_get_ptr_destructor"))
	drop_string_name :: unsafe Destructor(get_destructor(i32.(Type.string_name)))
	new_string :: unsafe NewString(get_proc("string_new_with_utf8_chars_and_len"))
	string_utf8 :: unsafe StringUtf8(get_proc("string_to_utf8_chars"))
	drop_string :: unsafe Destructor(get_destructor(i32.(Type.string)))
	variant_from_type :: unsafe GetFromType(get_proc("get_variant_from_type_constructor"))
	variant_to_type :: unsafe GetToType(get_proc("get_variant_to_type_constructor"))
	variant_type :: unsafe VariantGetType(get_proc("variant_get_type"))
	variant_destroy :: unsafe VariantDestroy(get_proc("variant_destroy"))
	variant_can_convert :: unsafe CanConvert(get_proc("variant_can_convert_strict"))
	register_class :: unsafe RegisterClass(get_proc("classdb_register_extension_class6"))
	unregister_class :: unsafe UnregisterClass(get_proc("classdb_unregister_extension_class"))
	register_method :: unsafe RegisterMethod(get_proc("classdb_register_extension_class_method"))
	register_property :: unsafe RegisterProperty(get_proc("classdb_register_extension_class_property"))
	construct_object :: unsafe ConstructObject(get_proc("classdb_construct_object3"))
	set_instance :: unsafe SetInstance(get_proc("object_set_instance"))
	get_method_bind :: unsafe GetMethodBind(get_proc("classdb_get_method_bind"))
	method_bind_call :: unsafe MethodBindCall(get_proc("object_method_bind_call"))
	classes :: unsafe malloc(ptr.size)
	binds :: unsafe calloc(usize.(MAX_BINDS), ptr.size)
	godot :: unsafe malloc(Godot.size)

	gd = Godot.{
		get_proc, library, get_version, new_string_name, drop_string_name,
		new_string, string_utf8, drop_string, variant_from_type, variant_to_type, variant_type,
		variant_destroy, variant_can_convert,
		register_class, unregister_class, register_method, register_property, construct_object, set_instance,
		get_method_bind, method_bind_call, classes, binds,
	}
	unsafe godot.write(gd)
	unsafe classes.write(ptr(0))
	unsafe out.write(Init.{ i32.(Level.scene), godot, initialize, deinitialize })

	true
}

## Recover the handle from a callback's `userdata`.
pub of :: fn(userdata: ptr) Godot {
	unsafe userdata.read[Godot]()
}

pub level :: fn(n: i32) Level {
	Level.from(n) or .editor
}

Godot :< {
	## Fetch an interface fn by name.
	pub proc :: fn(self, name: cstr) ptr {
		self.get_proc(name)
	}
}
