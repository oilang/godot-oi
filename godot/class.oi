module godot

## Register classes.
## TODO: most of these types will get replaced once I generate types like I did in gdext-v

pub OnReady :: @c fn(inst: ptr)
pub OnProcess :: @c fn(inst: ptr, delta: f64)
pub OnMethod :: @c fn(inst: ptr, args: ptr, ret: ptr)

## Unpacks Godot's raw virtual call and forwards it to the game's `target`.
Trampoline :: @c fn(inst: ptr, target: ptr, args: ptr, ret: ptr)

## GDExtensionClassCreateInstance3
CreateInstance :: @c fn(class: ptr, notify: u8) ptr

## GDExtensionClassFreeInstance
FreeInstance :: @c fn(class: ptr, inst: ptr)

## GDExtensionClassGetVirtualCallData2
GetVirtualCallData :: @c fn(class: ptr, name: ptr, hash: u32) ptr

## GDExtensionClassCallVirtualWithData
CallVirtualWithData :: @c fn(inst: ptr, name: ptr, data: ptr, args: ptr, ret: ptr)

## GDExtensionClassMethodCall
MethodCall :: @c fn(userdata: ptr, inst: ptr, args: ptr, argc: i64, ret: ptr, err: ptr)

## GDExtensionClassMethodPtrCall
MethodPtrCall :: @c fn(userdata: ptr, inst: ptr, args: ptr, ret: ptr)

## GDExtensionClassCreationInfo6
@c Info :: struct {
	is_virtual: u8,
	is_abstract: u8,
	is_exposed: u8,
	is_runtime: u8,
	icon_path: ptr,
	set: ptr,
	get: ptr,
	get_property_list: ptr,
	free_property_list: ptr,
	property_can_revert: ptr,
	property_get_revert: ptr,
	validate_property: ptr,
	notification: ptr,
	to_string: ptr,
	reference: ptr,
	unreference: ptr,
	create_instance: CreateInstance,
	free_instance: FreeInstance,
	recreate_instance: ptr,
	get_virtual: ptr,
	get_virtual_call_data: GetVirtualCallData,
	call_virtual_with_data: CallVirtualWithData,
	class_userdata: ptr,
}

## GDExtensionClassMethodInfo
@c MethodInfo :: struct {
	name: ptr,
	userdata: ptr,
	call: MethodCall,
	ptrcall: MethodPtrCall,
	flags: u32,
	has_return: u8,
	return_info: ptr,
	return_metadata: i32,
	argument_count: u32,
	arguments_info: ptr,
	arguments_metadata: ptr,
	default_argument_count: u32,
	default_arguments: ptr,
}

## GDExtensionPropertyInfo
@c PropertyInfo :: struct { type: i32, name: ptr, class_name: ptr, hint: u32, hint_string: ptr, usage: u32 }

## GDExtensionCallError
@c CallError :: struct { error: i32, argument: i32, expected: i32 }

## GDEXTENSION_METHOD_FLAGS_DEFAULT
METHOD_DEFAULT :: 1

## PROPERTY_USAGE_DEFAULT | PROPERTY_USAGE_NIL_IS_VARIANT, an untyped `Variant` slot
USAGE_VARIANT :: 131078

## GDEXTENSION_CALL_ERROR_TOO_MANY_ARGUMENTS
TOO_MANY :: 3
## GDEXTENSION_CALL_ERROR_TOO_FEW_ARGUMENTS
TOO_FEW :: 4

## A virtual the class overrides. Build with `ready` or `process`.
@c pub Virtual :: struct { name: cstr, call: Trampoline, target: ptr }

## A method scripts can call, every arg and the return an untyped `Variant`.
pub Method :: struct { name: cstr, call: OnMethod, args: []cstr, ret: bool }

pub ready :: fn(cb: OnReady) Virtual { Virtual.{ "_ready", call_ready, ptr(cb) } }
pub process :: fn(cb: OnProcess) Virtual { Virtual.{ "_process", call_process, ptr(cb) } }
pub method :: fn(name: cstr, cb: OnMethod, args: []cstr, ret: bool) Method { Method.{ name, cb, args, ret } }

## The nth `Variant` of a method's `args`.
pub arg :: fn(args: ptr, n: int) Variant {
	Variant.{ unsafe ptr(args.0 + ptr.size * usize(n)).read[ptr]() }
}

## A method's `ret` slot as a `Variant`.
pub ret :: fn(at: ptr) Variant { Variant.{ at } }

## A `Virtual` or `Method` once registered.
@c Bound :: struct { name: StringName, call: ptr, target: ptr, argc: i32 }

## Per-class state, handed to Godot as `class_userdata`. Classes chain through `next`.
@c pub Class :: struct {
	gd: Godot,
	name: StringName,
	parent: StringName,
	state: usize,
	virtuals: ptr,
	nvirtuals: int,
	methods: ptr,
	nmethods: int,
	next: ptr,
}

## Per-object header, what Godot calls `GDExtensionClassInstancePtr`.
@c pub Instance :: struct {
	pub class: ptr,
	pub object: ptr,
}

## The handle behind an instance callback.
pub of_inst :: fn(inst: ptr) Godot {
	unsafe inst.read[Instance]().class.read[Class]().gd
}

## The game's state behind `inst`.
pub state[T] :: fn(inst: ptr) T {
	unsafe ptr(inst.0 + Instance.size).read[T]()
}

pub set_state[T] :: fn(inst: ptr, s: T) {
	unsafe ptr(inst.0 + Instance.size).write(s)
}

## The nth entry of a `Bound` table.
bound :: fn(table: ptr, n: int) ptr {
	ptr(table.0 + Bound.size * usize(n))
}

## The nth entry of a `PropertyInfo` table.
slot :: fn(table: ptr, n: int) ptr {
	ptr(table.0 + PropertyInfo.size * usize(n))
}

Godot :< {
	pub register :: fn(self, name: cstr, parent: cstr, state: usize, virtuals: []Virtual, methods: []Method) {
		vt := unsafe malloc(Bound.size * usize(virtuals.len))
		loop i in 0..virtuals.len {
			v := virtuals[i]
			unsafe bound(vt, i).write(Bound.{ self.string_name(v.name), ptr(v.call), v.target })
		}
		mt := unsafe malloc(Bound.size * usize(methods.len))
		loop i in 0..methods.len {
			m := methods[i]
			unsafe bound(mt, i).write(Bound.{ self.string_name(m.name), ptr(m.call), ptr(0), i32(m.args.len) })
		}
		class := unsafe malloc(Class.size)
		unsafe class.write(Class.{
			self, self.string_name(name), self.string_name(parent), state,
			vt, virtuals.len, mt, methods.len, self.classes.read[ptr](),
		})
		unsafe self.classes.write(class)
		c := unsafe class.read[Class]()
		info := unsafe malloc(Info.size)
		unsafe info.write(Info.{
			is_exposed = 1,
			create_instance = create_instance, free_instance = free_instance,
			get_virtual_call_data = get_virtual_call_data, call_virtual_with_data = call_virtual_with_data,
			class_userdata = class,
		})
		self.register_class(self.library, c.name.at, c.parent.at, info)
		unsafe free(info)
		minfo := unsafe malloc(MethodInfo.size)
		loop i in 0..methods.len {
			m := methods[i]
			b := bound(mt, i)
			args := unsafe malloc(PropertyInfo.size * usize(m.args.len))
			meta := unsafe calloc(usize(m.args.len), 4)
			loop j in 0..m.args.len { unsafe slot(args, j).write(self.variant_slot(m.args[j])) }
			ret := unsafe malloc(PropertyInfo.size)
			unsafe ret.write(self.variant_slot(""))
			unsafe minfo.write(MethodInfo.{
				b.read[Bound]().name.at, b, call_method, ptrcall_method, u32(METHOD_DEFAULT),
				u8(if m.ret { 1 } else { 0 }), ret, 0, u32(m.args.len), args, meta,
			})
			self.register_method(self.library, c.name.at, minfo)
			loop j in 0..m.args.len { self.drop_slot(unsafe slot(args, j).read[PropertyInfo]()) }
			self.drop_slot(unsafe ret.read[PropertyInfo]())
			unsafe free(args)
			unsafe free(meta)
			unsafe free(ret)
		}
		unsafe free(minfo)
	}

	## Unregister every class, newest first.
	pub unregister_all :: fn(self) {
		class := unsafe self.classes.read[ptr]()
		loop !class.is_null() {
			c := unsafe class.read[Class]()
			self.unregister_class(self.library, c.name.at)
			c.name.destroy(self)
			c.parent.destroy(self)
			self.unbind(c.virtuals, c.nvirtuals)
			self.unbind(c.methods, c.nmethods)
			unsafe free(class)
			class = c.next
		}
		unsafe self.classes.write(ptr(0))
	}

	## A `PropertyInfo` for an untyped `Variant` slot.
	variant_slot :: fn(self, name: cstr) PropertyInfo {
		hint := unsafe malloc(usize(STRING_SIZE))
		self.new_string(hint, "".ptr, 0)
		PropertyInfo.{ i32(Type.nil), self.string_name(name).at, self.string_name("").at, 0, hint, u32(USAGE_VARIANT) }
	}

	drop_slot :: fn(self, p: PropertyInfo) {
		StringName.{ p.name }.destroy(self)
		StringName.{ p.class_name }.destroy(self)
		self.drop_string(p.hint_string)
		unsafe free(p.hint_string)
	}

	unbind :: fn(self, table: ptr, n: int) {
		loop i in 0..n {
			unsafe bound(table, i).read[Bound]().name.destroy(self)
		}
		unsafe free(table)
	}
}

@c create_instance :: fn(class: ptr, notify: u8) ptr {
	c := unsafe class.read[Class]()
	object := c.gd.construct_object(c.parent.at)
	inst := unsafe calloc(1, Instance.size + c.state)
	unsafe inst.write(Instance.{ class, object })
	c.gd.set_instance(object, c.name.at, inst)
	object
}

@c free_instance :: fn(class: ptr, inst: ptr) {
	unsafe free(inst)
}

## Hand back the matching `Bound` entry, which Godot passes to `call_virtual_with_data`.
@c get_virtual_call_data :: fn(class: ptr, name: ptr, hash: u32) ptr {
	c := unsafe class.read[Class]()
	loop i in 0..c.nvirtuals {
		at := bound(c.virtuals, i)
		b := unsafe at.read[Bound]()
		if b.name.same(name) { return at }
	}
	ptr(0)
}

@c call_virtual_with_data :: fn(inst: ptr, name: ptr, data: ptr, args: ptr, ret: ptr) {
	b := unsafe data.read[Bound]()
	call := unsafe Trampoline(b.call)
	call(inst, b.target, args, ret)
}

@c call_ready :: fn(inst: ptr, target: ptr, args: ptr, ret: ptr) {
	on_ready := unsafe OnReady(target)
	on_ready(inst)
}

@c call_process :: fn(inst: ptr, target: ptr, args: ptr, ret: ptr) {
	delta := unsafe args.read[ptr]().read[f64]()
	on_process := unsafe OnProcess(target)
	on_process(inst, delta)
}

## The `Variant` call path.
@c call_method :: fn(userdata: ptr, inst: ptr, args: ptr, argc: i64, ret: ptr, err: ptr) {
	b := unsafe userdata.read[Bound]()
	if argc != i64(b.argc) {
		unsafe err.write(CallError.{ i32(if argc > i64(b.argc) { TOO_MANY } else { TOO_FEW }), 0, b.argc })
		return
	}
	on_method := unsafe OnMethod(b.call)
	on_method(inst, args, ret)
}

## The typed call path.
@c ptrcall_method :: fn(userdata: ptr, inst: ptr, args: ptr, ret: ptr) {
	on_method := unsafe OnMethod(userdata.read[Bound]().call)
	on_method(inst, args, ret)
}
