module godot

## Register classes. Each carries a table of virtuals and methods and picks its own parent.

pub OnReady :: @c fn(inst: ptr)
pub OnProcess :: @c fn(inst: ptr, delta: f64)
pub OnMethod :: @c fn(inst: ptr)

## Unpacks Godot's raw virtual call and forwards it to the game's `target`.
Trampoline :: @c fn(inst: ptr, target: ptr, args: ptr, ret: ptr)

## GDExtensionClassCreateInstance3
CreateInstance :: @c fn(class: ptr, notify: u8) ptr

## GDExtensionClassFreeInstance
FreeInstance :: @c fn(class: ptr, inst: ptr)

## GDExtensionClassGetVirtualCallData2
GetVirtualCallData :: @c fn(class: ptr, name: ptr, hash: u32) ptr

## GDExtensionClassCallVirtualWithData
CallVirtualWithData :: @c fn(inst: ptr, name: ptr, data: ptr, args: ptr, ret: ptr)

## GDExtensionClassMethodCall
MethodCall :: @c fn(userdata: ptr, inst: ptr, args: ptr, argc: i64, ret: ptr, err: ptr)

## GDExtensionClassMethodPtrCall
MethodPtrCall :: @c fn(userdata: ptr, inst: ptr, args: ptr, ret: ptr)

## GDExtensionClassCreationInfo6
@c Info :: struct {
	is_virtual: u8,
	is_abstract: u8,
	is_exposed: u8,
	is_runtime: u8,
	icon_path: ptr,
	set: ptr,
	get: ptr,
	get_property_list: ptr,
	free_property_list: ptr,
	property_can_revert: ptr,
	property_get_revert: ptr,
	validate_property: ptr,
	notification: ptr,
	to_string: ptr,
	reference: ptr,
	unreference: ptr,
	create_instance: CreateInstance,
	free_instance: FreeInstance,
	recreate_instance: ptr,
	get_virtual: ptr,
	get_virtual_call_data: GetVirtualCallData,
	call_virtual_with_data: CallVirtualWithData,
	class_userdata: ptr,
}

## GDExtensionClassMethodInfo
@c MethodInfo :: struct {
	name: ptr,
	userdata: ptr,
	call: MethodCall,
	ptrcall: MethodPtrCall,
	flags: u32,
	has_return: u8,
	return_info: ptr,
	return_metadata: i32,
	argument_count: u32,
	arguments_info: ptr,
	arguments_metadata: ptr,
	default_argument_count: u32,
	default_arguments: ptr,
}

## GDEXTENSION_METHOD_FLAGS_DEFAULT
METHOD_DEFAULT :: 1

## A virtual the class overrides. Build with `ready` or `process`.
@c pub Virtual :: struct { name: cstr, call: Trampoline, target: ptr }

## A method scripts can call. Build with `method`.
@c pub Method :: struct { name: cstr, call: OnMethod }

pub ready :: fn(cb: OnReady) Virtual { Virtual.{ "_ready", call_ready, ptr(cb) } }
pub process :: fn(cb: OnProcess) Virtual { Virtual.{ "_process", call_process, ptr(cb) } }
pub method :: fn(name: cstr, cb: OnMethod) Method { Method.{ name, cb } }

## A `Virtual` or `Method` once registered: name interned, `call` and `target` as given.
@c Bound :: struct { name: StringName, call: ptr, target: ptr }

## Per-class state, handed to Godot as `class_userdata`. Classes chain through `next`.
@c pub Class :: struct {
	gd: Godot,
	name: StringName,
	parent: StringName,
	virtuals: ptr,
	nvirtuals: int,
	methods: ptr,
	nmethods: int,
	next: ptr,
}

## Per-object state, what Godot calls `GDExtensionClassInstancePtr`.
@c pub Instance :: struct {
	pub class: ptr,
	pub object: ptr,
	pub frames: u64,
}

## The `i`th entry of a `Bound` table.
bound :: fn(table: ptr, i: int) ptr {
	ptr(table.0 + Bound.size * usize(i))
}

Godot :< {
	pub register :: fn(self, name: cstr, parent: cstr, virtuals: []Virtual, methods: []Method) {
		vt := unsafe malloc(Bound.size * usize(virtuals.len))
		loop i in 0..virtuals.len {
			v := virtuals[i]
			unsafe bound(vt, i).write(Bound.{ self.string_name(v.name), ptr(v.call), v.target })
		}
		mt := unsafe malloc(Bound.size * usize(methods.len))
		loop i in 0..methods.len {
			m := methods[i]
			unsafe bound(mt, i).write(Bound.{ self.string_name(m.name), ptr(m.call), ptr(0) })
		}
		class := unsafe malloc(Class.size)
		unsafe class.write(Class.{
			self, self.string_name(name), self.string_name(parent),
			vt, virtuals.len, mt, methods.len, self.classes.read[ptr](),
		})
		unsafe self.classes.write(class)
		c := unsafe class.read[Class]()
		info := unsafe malloc(Info.size)
		unsafe info.write(Info.{
			is_exposed = 1,
			create_instance = create_instance, free_instance = free_instance,
			get_virtual_call_data = get_virtual_call_data, call_virtual_with_data = call_virtual_with_data,
			class_userdata = class,
		})
		self.register_class(self.library, c.name.at, c.parent.at, info)
		unsafe free(info)
		minfo := unsafe malloc(MethodInfo.size)
		loop i in 0..methods.len {
			b := bound(mt, i)
			unsafe minfo.write(MethodInfo.{ b.read[Bound]().name.at, b, call_method, ptrcall_method, u32(METHOD_DEFAULT) })
			self.register_method(self.library, c.name.at, minfo)
		}
		unsafe free(minfo)
	}

	## Unregister every class, newest first.
	pub unregister_all :: fn(self) {
		class := unsafe self.classes.read[ptr]()
		loop !class.is_null() {
			c := unsafe class.read[Class]()
			self.unregister_class(self.library, c.name.at)
			c.name.destroy(self)
			c.parent.destroy(self)
			self.unbind(c.virtuals, c.nvirtuals)
			self.unbind(c.methods, c.nmethods)
			unsafe free(class)
			class = c.next
		}
		unsafe self.classes.write(ptr(0))
	}

	unbind :: fn(self, table: ptr, n: int) {
		loop i in 0..n {
			unsafe bound(table, i).read[Bound]().name.destroy(self)
		}
		unsafe free(table)
	}
}

@c create_instance :: fn(class: ptr, notify: u8) ptr {
	c := unsafe class.read[Class]()
	object := c.gd.construct_object(c.parent.at)
	inst := unsafe malloc(Instance.size)
	unsafe inst.write(Instance.{ class, object, 0 })
	c.gd.set_instance(object, c.name.at, inst)
	object
}

@c free_instance :: fn(class: ptr, inst: ptr) {
	unsafe free(inst)
}

## Hand back the matching `Bound` entry, which Godot passes to `call_virtual_with_data`.
@c get_virtual_call_data :: fn(class: ptr, name: ptr, hash: u32) ptr {
	c := unsafe class.read[Class]()
	loop i in 0..c.nvirtuals {
		at := bound(c.virtuals, i)
		b := unsafe at.read[Bound]()
		if b.name.same(name) { return at }
	}
	ptr(0)
}

@c call_virtual_with_data :: fn(inst: ptr, name: ptr, data: ptr, args: ptr, ret: ptr) {
	b := unsafe data.read[Bound]()
	call := unsafe Trampoline(b.call)
	call(inst, b.target, args, ret)
}

@c call_ready :: fn(inst: ptr, target: ptr, args: ptr, ret: ptr) {
	on_ready := unsafe OnReady(target)
	on_ready(inst)
}

@c call_process :: fn(inst: ptr, target: ptr, args: ptr, ret: ptr) {
	i := unsafe inst.read[Instance]()
	unsafe inst.write(Instance.{ i.class, i.object, i.frames + 1 })
	delta := unsafe args.read[ptr]().read[f64]()
	on_process := unsafe OnProcess(target)
	on_process(inst, delta)
}

@c call_method :: fn(userdata: ptr, inst: ptr, args: ptr, argc: i64, ret: ptr, err: ptr) {
	on_method := unsafe OnMethod(userdata.read[Bound]().call)
	on_method(inst)
}

@c ptrcall_method :: fn(userdata: ptr, inst: ptr, args: ptr, ret: ptr) {
	on_method := unsafe OnMethod(userdata.read[Bound]().call)
	on_method(inst)
}
