module godot

## Register classes.
## TODO: most of these types will get replaced once I generate types like I did in gdext-v

pub OnMethod :: @c fn(inst: ptr, args: ptr, ret: ptr)

## Fills a new instance's payload, before any property default is set.
pub OnInit :: @c fn(inst: ptr)

## GDExtensionClassCreateInstance3
CreateInstance :: @c fn(class: ptr, notify: u8) ptr

## GDExtensionClassFreeInstance
FreeInstance :: @c fn(class: ptr, inst: ptr)

## GDExtensionClassRecreateInstance
RecreateInstance :: @c fn(class: ptr, object: ptr) ptr

## GDExtensionClassGetVirtualCallData2
GetVirtualCallData :: @c fn(class: ptr, name: ptr, hash: u32) ptr

## GDExtensionClassCallVirtualWithData
CallVirtualWithData :: @c fn(inst: ptr, name: ptr, data: ptr, args: ptr, ret: ptr)

## GDExtensionClassNotification2
pub Notification :: @c fn(inst: ptr, what: i32, reversed: b8)

## GDExtensionClassToString
pub ToString :: @c fn(inst: ptr, valid: ptr, out: ptr)

## GDExtensionClassMethodCall
MethodCall :: @c fn(userdata: ptr, inst: ptr, args: ptr, argc: i64, ret: ptr, err: ptr)

## GDExtensionClassMethodPtrCall
MethodPtrCall :: @c fn(userdata: ptr, inst: ptr, args: ptr, ret: ptr)

## GDExtensionClassCreationInfo6
@c Info :: struct {
	is_virtual: b8,
	is_abstract: b8,
	is_exposed: b8,
	is_runtime: b8,
	icon_path: ptr,
	set: ptr,
	get: ptr,
	get_property_list: ptr,
	free_property_list: ptr,
	property_can_revert: ptr,
	property_get_revert: ptr,
	validate_property: ptr,
	notification: ptr,
	to_string: ptr,
	reference: ptr,
	unreference: ptr,
	create_instance: CreateInstance,
	free_instance: FreeInstance,
	recreate_instance: RecreateInstance,
	get_virtual: ptr,
	get_virtual_call_data: GetVirtualCallData,
	call_virtual_with_data: CallVirtualWithData,
	class_userdata: ptr,
}

## GDExtensionClassMethodInfo
@c MethodInfo :: struct {
	name: ptr,
	userdata: ptr,
	call: MethodCall,
	ptrcall: MethodPtrCall,
	flags: u32,
	has_return: b8,
	return_info: ptr,
	return_metadata: i32,
	argument_count: u32,
	arguments_info: ptr,
	arguments_metadata: ptr,
	default_argument_count: u32,
	default_arguments: ptr,
}

## GDExtensionPropertyInfo
@c PropertyInfo :: struct {
	type: i32,
	name: ptr,
	class_name: ptr,
	hint: u32,
	hint_string: ptr,
	usage: u32
}

## GDExtensionClassVirtualMethodInfo
@c VirtualMethodInfo :: struct {
	name: ptr,
	flags: u32,
	return_value: PropertyInfo,
	return_metadata: i32,
	argument_count: u32,
	arguments: ptr,
	arguments_metadata: ptr,
}

## GDExtensionCallError
@c CallError :: struct { error: i32, argument: i32, expected: i32 }

## GDEXTENSION_METHOD_FLAGS_DEFAULT
METHOD_DEFAULT :: 1

## GDEXTENSION_METHOD_FLAGS_DEFAULT | GDEXTENSION_METHOD_FLAG_STATIC
METHOD_STATIC :: 33

## PROPERTY_USAGE_DEFAULT
USAGE_DEFAULT :: 6

## PROPERTY_USAGE_DEFAULT | PROPERTY_USAGE_NIL_IS_VARIANT, an untyped `Variant` slot
USAGE_VARIANT :: 131078

## GDEXTENSION_CALL_ERROR_INVALID_ARGUMENT
INVALID_ARG :: 2
## GDEXTENSION_CALL_ERROR_TOO_MANY_ARGUMENTS
TOO_MANY :: 3
## GDEXTENSION_CALL_ERROR_TOO_FEW_ARGUMENTS
TOO_FEW :: 4

## A method arg. `.nil` is an untyped `Variant`.
pub Slot :: struct { name: cstr, type: Type, default: ptr = ptr.(0) }

## A method scripts can call, or a virtual the engine calls.
pub Method :: struct {
	name: cstr,
	call: OnMethod,
	args: []Slot,
	ret: ?Type,
	hash: u32,
	static: bool,
}

pub Property :: struct {
	name: cstr,
	type: Type,
	get: OnMethod,
	set: OnMethod,
	exported: bool,
	hint: PropertyHint,
	hint_string: string,
	default: ?Variant,
	groups: []Group,
}

## An inspector group or subgroup.
pub Group :: struct { pub name: string, pub prefix: string, pub sub: bool }

## A signal a class declares.
pub Sig :: struct { name: cstr, args: []Slot }

pub slot :: fn(name: cstr, t: Type, default: ?Variant = none) Slot {
	d := default or return Slot.{ name, t }
	Slot.{ name, t, gd.dup(d.at) }
}
pub sig :: fn(name: cstr, args: []Slot) Sig {
	Sig.{ name, args }
}
## A `static` one takes no instance, called as `Class.name(..)`.
pub method :: fn(name: cstr, cb: OnMethod, args: []Slot, ret: ?Type, static: bool = false) Method {
	Method.{ name, cb, args, ret, 0, static }
}

## A virtual the engine calls.
## `hash` is the signature hash from `extension_api.json`.
pub virtual :: fn(name: cstr, cb: OnMethod, args: []Slot, ret: ?Type, hash: int) Method {
	Method.{ name, cb, args, ret, u32.(hash), false }
}

## A virtual scripts override, with no callback.
pub script_virtual :: fn(name: cstr, args: []Slot, ret: ?Type) Method {
	Method.{ name, unsafe OnMethod.(ptr.(0)), args, ret, 0, false }
}

pub property :: fn(
	name: cstr, t: Type, get: OnMethod, set: OnMethod, exported: bool,
	hint: PropertyHint = .none_, hint_string: string = "", default: ?Variant = none, groups: []Group = [],
) Property {
	Property.{ name, t, get, set, exported, hint, hint_string, default, groups }
}

## The cell of `args` holding the nth slot's address.
cell :: fn(args: ptr, n: int) ptr {
	ptr.(args.0 + ptr.size * usize.(n))
}

## The nth of a method's `args` as `T`, read from the slot Godot owns.
pub arg[T] :: fn(args: ptr, n: int) T {
	unsafe unbox[T](Variant.(cell(args, n)))
}

## Copy `v` into a method's nil `ret` slot.
pub ret :: fn(at: ptr, v: Variant) {
	gd.variant_copy(at, v.at)
}

## A `Method` once registered.
@c Bound :: struct {
	default: ptr,
	name: ptr,
	call: ptr,
	argc: i32,
	types: ptr,
	ret: i32,
	hash: u32,
	ndefaults: i32,
	defaults: ptr,
}

## Per-class state, handed to Godot as `class_userdata`. Classes chain through `next`.
@c pub Class :: struct {
	name: ptr,
	parent: ptr,
	state: usize,
	virtuals: ptr,
	nvirtuals: int,
	methods: ptr,
	nmethods: int,
	init: OnInit,
	onready: OnInit,
	dispose: OnInit,
	next: ptr,
}

## Per-object header, what Godot calls `GDExtensionClassInstancePtr`.
@c pub Instance :: struct {
	pub class: ptr,
	pub object: ptr,
}

## The engine object behind `inst`.
pub object :: fn(inst: ptr) ptr {
	unsafe inst.read[Instance]().object
}

## The instance behind a `Variant` holding an object of a registered class.
pub instance :: fn(v: Variant) ptr {
	get := unsafe GetBinding.(gd.proc("object_get_instance_binding"))
	inst := get(Object.(v).object, gd.library, ptr.(0))
	if inst.is_null() do panic!("godot: not an oi class instance")
	inst
}

## Bind `inst` to `object` for `instance`, replacing any binding a hot reload left behind.
bind_instance :: fn(object: ptr, inst: ptr) {
	unsafe FreeBinding.(gd.proc("object_free_instance_binding"))(object, gd.library)
	# GDExtensionInstanceBindingCallbacks, all null, copied out by Godot
	callbacks := unsafe calloc(3, ptr.size)
	unsafe SetBinding.(gd.proc("object_set_instance_binding"))(object, gd.library, inst, callbacks)
	unsafe free(callbacks)
}

## The game's struct behind `inst`, reached through the `T.(payload(inst))` view.
pub payload :: fn(inst: ptr) ptr {
	ptr.(inst.0 + Instance.size)
}

## Drop a payload's fields in place, handed its `T.(payload(inst))` view.
pub dispose[T] :: fn(move x: T) {}

## Hand `s` back from a `ToString` through its `valid` and `out`.
pub put_string :: fn(valid: ptr, out: ptr, s: string) {
	unsafe valid.write(u8.(1))
	gd.drop_string(out)
	gd.new_string(out, s.ptr, i64.(s.len()))
}

## Resolve `path` against the object, for `@godot.onready` fields.
## Nil when it does not resolve.
pub node_at :: fn(inst: ptr, path: string) ptr {
	n := Node.from_ptr(object(inst)).get_node(path) or {
		err("godot: onready path {path} did not resolve, left nil")
		return ptr.(0)
	}
	n.object
}

## The nth entry of a `Bound` table.
bound :: fn(table: ptr, n: int) ptr {
	ptr.(table.0 + Bound.size * usize.(n))
}

## The nth entry of a `PropertyInfo` table.
prop :: fn(table: ptr, n: int) ptr {
	ptr.(table.0 + PropertyInfo.size * usize.(n))
}

type_at :: fn(table: ptr, n: int) Type {
	Type.from(unsafe ptr.(table.0 + usize.(4 * n)).read[i32]()) or .nil
}

Godot :< {
	pub register :: fn(
		self; name: cstr, parent: cstr, state: usize, tool: bool, virtuals: []Method, own: []Method, props: []Property,
		signals: []Sig, init: OnInit, onready: OnInit, dispose: OnInit, notification: ptr, to_string: ptr,
	) {
		methods: []Method
		methods << own
		# `cstr` borrows the buffer, so the accessor names live here for now
		names: []string
		loop p, i in props {
			n := unsafe p.name.str()
			names << "get_{n}"
			names << "set_{n}"
			methods << method(names[2 * i].cstr(), p.get, [], p.type)
			methods << method(names[2 * i + 1].cstr(), p.set, [slot(p.name, p.type)], none)
		}

		vt := self.table(virtuals)
		mt := self.table(methods)
		# the setter's `Bound` owns a raw copy of the default until `unbind`
		loop p, i in props {
			d := p.default or continue
			unsafe bound(mt, own.len() + 2 * i + 1).write(self.dup(d.at))
		}

		class := unsafe malloc(Class.size)
		unsafe class.write(Class.{
			self.string_name(name), self.string_name(parent), state,
			vt, virtuals.len(), mt, methods.len(), init, onready, dispose, self.classes.read[ptr](),
		})
		unsafe self.classes.write(class)
		c := unsafe class.read[Class]()
		info := unsafe malloc(Info.size)
		unsafe info.write(Info.{
			is_exposed = true,
			is_runtime = !tool,
			notification = notification, to_string = to_string,
			create_instance = create_instance, free_instance = free_instance, recreate_instance = recreate_instance,
			get_virtual_call_data = get_virtual_call_data, call_virtual_with_data = call_virtual_with_data,
			class_userdata = class,
		})
		self.register_class(self.library, c.name, c.parent, info)
		unsafe free(info)

		minfo := unsafe malloc(MethodInfo.size)
		loop m, i in methods {
			at := bound(mt, i)
			b := unsafe at.read[Bound]()
			args := unsafe malloc(PropertyInfo.size * usize.(m.args.len()))
			meta := unsafe calloc(usize.(m.args.len()), 4)
			loop a, j in m.args {
				unsafe prop(args, j).write(self.slot_info(a))
			}

			ret := unsafe malloc(PropertyInfo.size)
			unsafe ret.write(self.slot_info(Slot.{ "", m.ret or .nil }))

			unsafe minfo.write(MethodInfo.{
				name = b.name,
				userdata = at,
				call = call_method,
				ptrcall = ptrcall_method,
				flags = u32.(if m.static { METHOD_STATIC } else { METHOD_DEFAULT }),
				has_return = m.ret != none,
				return_info = ret,
				return_metadata = 0,
				argument_count = u32.(m.args.len()),
				arguments_info = args,
				arguments_metadata = meta,
				default_argument_count = u32.(b.ndefaults),
				default_arguments = b.defaults,
			})

			if ptr.(m.call).is_null() {
				vinfo := unsafe malloc(VirtualMethodInfo.size)
				unsafe vinfo.write(VirtualMethodInfo.{
					b.name, u32.(METHOD_DEFAULT), ret.read[PropertyInfo](), 0, u32.(m.args.len()), args, meta,
				})
				on := unsafe RegisterVirtualMethod.(self.proc("classdb_register_extension_class_virtual_method"))
				on(self.library, c.name, vinfo)
				unsafe free(vinfo)
			} else {
				self.register_method(self.library, c.name, minfo)
			}

			loop j in ..m.args.len() {
				self.drop_slot(unsafe prop(args, j).read[PropertyInfo]())
			}

			self.drop_slot(unsafe ret.read[PropertyInfo]())

			unsafe free(args)
			unsafe free(meta)
			unsafe free(ret)
		}
		unsafe free(minfo)

		pinfo := unsafe malloc(PropertyInfo.size)
		loop p, i in props {
			info := self.slot_info(Slot.{ p.name, p.type }, p.hint, p.hint_string)
			if !p.exported do info.usage = 0

			# Godot files each property under the group opened last
			loop g in p.groups do self.group(c.name, g)

			unsafe pinfo.write(info)
			get := unsafe bound(mt, own.len() + 2 * i).read[Bound]().name
			set := unsafe bound(mt, own.len() + 2 * i + 1).read[Bound]().name
			self.register_property(self.library, c.name, pinfo, set, get)
			self.drop_slot(info)
		}
		unsafe free(pinfo)

		loop sg, i in signals {
			args := unsafe malloc(PropertyInfo.size * usize.(sg.args.len()))
			loop a, j in sg.args {
				unsafe prop(args, j).write(self.slot_info(a))
			}
			sn := self.string_name(sg.name)
			self.register_signal(self.library, c.name, sn, args, i64.(sg.args.len()))
			self.free_name(sn)
			loop j in ..sg.args.len() {
				self.drop_slot(unsafe prop(args, j).read[PropertyInfo]())
			}
			unsafe free(args)
		}
	}

	## Register an integer constant of `class`, a value of enum `group` unless that is empty.
	pub constant :: fn(self; class, group, name: cstr, value: i64, bitfield: bool) {
		names := [self.string_name(class), self.string_name(group), self.string_name(name)]
		on := unsafe RegisterConstant.(self.proc("classdb_register_extension_class_integer_constant"))
		on(self.library, names[0], names[1], names[2], value, bitfield)
		loop n in names do self.free_name(n)
	}

	## Open `g` on `class` for the properties registered after it.
	group :: fn(self; class: ptr, g: Group) {
		at := loop s in [g.name, g.prefix] {
			str := unsafe malloc(usize.(STRING_SIZE))
			self.new_string(str, s.ptr, i64.(s.len()))
			str
		}
		sub := if g.sub do "sub" else do ""
		proc := "classdb_register_extension_class_property_{sub}group"
		unsafe RegisterGroup.(self.proc(proc.cstr()))(self.library, class, at[0], at[1])
		loop str in at {
			self.drop_string(str)
			unsafe free(str)
		}
	}

	## Unregister every class, newest first.
	pub unregister_all :: fn(self) {
		class := unsafe self.classes.read[ptr]()
		loop !class.is_null() {
			c := unsafe class.read[Class]()
			self.unregister_class(self.library, c.name)
			self.free_name(c.name)
			self.free_name(c.parent)
			self.unbind(c.virtuals, c.nvirtuals)
			self.unbind(c.methods, c.nmethods)
			unsafe free(class)
			class = c.next
		}
		unsafe self.classes.write(ptr.(0))
	}

	## A `Bound` per method.
	table :: fn(self; methods: []Method) ptr {
		t := unsafe malloc(Bound.size * usize.(methods.len()))
		loop m, i in methods {
			types := unsafe malloc(usize.(4 * m.args.len()))
			defaults := unsafe malloc(ptr.size * usize.(m.args.len()))
			nd := 0
			loop a, j in m.args {
				unsafe ptr.(types.0 + usize.(4 * j)).write(i32.(a.type))
				if a.default.is_null() do continue

				unsafe cell(defaults, nd).write(a.default)
				nd += 1
			}

			unsafe bound(t, i).write(Bound.{
				default = ptr.(0),
				name = self.string_name(m.name),
				call = ptr.(m.call),
				argc = i32.(m.args.len()),
				types = types,
				ret = i32.(m.ret or .nil),
				hash = m.hash,
				ndefaults = i32.(nd),
				defaults = defaults,
			})
		}
		t
	}

	slot_info :: fn(self; s: Slot, hint: PropertyHint = .none_, hint_string: string = "") PropertyInfo {
		hs := unsafe malloc(usize.(STRING_SIZE))
		self.new_string(hs, hint_string.ptr, i64.(hint_string.len()))
		usage := if s.type == .nil { USAGE_VARIANT } else { USAGE_DEFAULT }
		PropertyInfo.{
			i32.(s.type),
			self.string_name(s.name),
			self.string_name(""),
			u32.(hint),
			hs,
			u32.(usage)
		}
	}

	drop_slot :: fn(self; p: PropertyInfo) {
		self.free_name(p.name)
		self.free_name(p.class_name)
		self.drop_string(p.hint_string)
		unsafe free(p.hint_string)
	}

	unbind :: fn(self; table: ptr, n: int) {
		loop i in ..n {
			b := unsafe bound(table, i).read[Bound]()
			self.free_name(b.name)
			unsafe free(b.types)

			if !b.default.is_null() do self.release(b.default)
			loop j in ..int.(b.ndefaults) {
				self.release(unsafe cell(b.defaults, j).read[ptr]())
			}

			unsafe free(b.defaults)
		}
		unsafe free(table)
	}
}

## Fill each property's default into a fresh payload.
fill_defaults :: fn(inst: ptr, c: Class) {
	loop i in ..c.nmethods {
		at := bound(c.methods, i)
		b := unsafe at.read[Bound]()
		if !b.default.is_null() {
			unsafe OnMethod.(b.call)(inst, at, ptr.(0))
		}
	}
}

create_instance :: fn(class: ptr, notify: u8) ptr {
	c := unsafe class.read[Class]()
	object := gd.construct_object(c.parent)
	inst := unsafe calloc(1, Instance.size + c.state)
	unsafe inst.write(Instance.{ class, object })
	gd.set_instance(object, c.name, inst)
	bind_instance(object, inst)
	init := c.init
	init(inst)
	if notify != 0 {
		Object.from_ptr(object).notification(0)
	}
	fill_defaults(inst, c)
	object
}

free_instance :: fn(class: ptr, inst: ptr) {
	c := unsafe class.read[Class]()
	c.dispose(inst)
	unsafe free(inst)
}

## Rebuild an instance's payload on the same engine object, for a hot-reloaded class.
## Godot restores stored property values afterward through the registered setters.
recreate_instance :: fn(class: ptr, object: ptr) ptr {
	c := unsafe class.read[Class]()
	inst := unsafe calloc(1, Instance.size + c.state)
	unsafe inst.write(Instance.{ class, object })
	bind_instance(object, inst)
	c.init(inst)
	fill_defaults(inst, c)

	# a node not yet ready resolves its onready fields at `ready`
	n := Node.cast(Object.from_ptr(object)) or return inst

	if n.is_node_ready() do c.onready(inst)
	inst
}

## Hand back the matching `Bound` entry, which Godot passes to `call_virtual_with_data`.
get_virtual_call_data :: fn(class: ptr, name: ptr, hash: u32) ptr {
	c := unsafe class.read[Class]()
	loop i in ..c.nvirtuals {
		at := bound(c.virtuals, i)
		b := unsafe at.read[Bound]()
		if b.hash == hash && (unsafe b.name.read[u64]() == name.read[u64]()) do return at
	}
	ptr.(0)
}

call_virtual_with_data :: fn(inst: ptr, name: ptr, data: ptr, args: ptr, ret: ptr) {
	ptrcall_method(data, inst, args, ret)
}

## The `Variant` call path.
## A short call is padded with the trailing defaults.
call_method :: fn(userdata: ptr, inst: ptr, given: ptr, argc: i64, ret: ptr, err: ptr) {
	b := unsafe userdata.read[Bound]()
	lo := i64.(b.argc - b.ndefaults)
	want := if argc < lo { lo } else { i64.(b.argc) }
	if argc < lo || argc > want {
		unsafe err.write(CallError.{
			i32.(if argc < lo { TOO_FEW } else { TOO_MANY }),
			0,
			i32.(want)
		})
		return
	}

	args := unsafe malloc(ptr.size * usize.(b.argc))
	defer unsafe free(args)
	loop i in ..int.(b.argc) {
		src := if i64.(i) < argc { cell(given, i) } else { cell(b.defaults, i - int.(lo)) }
		unsafe cell(args, i).write(unsafe src.read[ptr]())
		t := type_at(b.types, i)
		if t != .nil && !gd.variant_can_convert(i32.(unsafe Variant.(cell(args, i)).type()), i32.(t)) {
			unsafe err.write(CallError.{
				i32.(INVALID_ARG),
				i32.(i),
				i32.(t)
			})
			return
		}
	}
	on_method := unsafe OnMethod.(b.call)
	on_method(inst, args, ret)
}

## The typed call path.
## Godot's raw values are boxed into temporary `Variant`s, raw in `boxed`, the args then the return.
ptrcall_method :: fn(userdata: ptr, inst: ptr, args: ptr, ret: ptr) {
	b := unsafe userdata.read[Bound]()
	n := int.(b.argc)
	types := loop i in ..n do type_at(b.types, i)
	types << (Type.from(b.ret) or .nil)
	boxed := unsafe malloc(ptr.size * usize.(n + 1))
	loop t, i in types {
		raw := if i < n { unsafe cell(args, i).read[ptr]() } else { ret }
		unsafe cell(boxed, i).write(if t == .nil { raw } else { unsafe calloc(1, usize.(VARIANT_SIZE)) })
		if t != .nil && i < n do gd.from_type(t, unsafe Variant.(cell(boxed, i)), raw)
	}
	on_method := unsafe OnMethod.(b.call)
	on_method(inst, boxed, unsafe cell(boxed, n).read[ptr]())
	if types[n] != .nil do gd.to_type(types[n], unsafe Variant.(cell(boxed, n)), ret)
	loop t, i in types {
		if t != .nil do gd.release(unsafe cell(boxed, i).read[ptr]())
	}
	unsafe free(boxed)
}
