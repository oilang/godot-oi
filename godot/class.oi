module godot

## Register classes.
## TODO: most of these types will get replaced once I generate types like I did in gdext-v

pub OnMethod :: @c fn(inst: ptr, args: ptr, ret: ptr)

## Fills a new instance's payload, before any property default is set.
pub OnInit :: @c fn(inst: ptr)

## GDExtensionClassCreateInstance3
CreateInstance :: @c fn(class: ptr, notify: u8) ptr

## GDExtensionClassFreeInstance
FreeInstance :: @c fn(class: ptr, inst: ptr)

## GDExtensionClassRecreateInstance
RecreateInstance :: @c fn(class: ptr, object: ptr) ptr

## GDExtensionClassGetVirtualCallData2
GetVirtualCallData :: @c fn(class: ptr, name: ptr, hash: u32) ptr

## GDExtensionClassCallVirtualWithData
CallVirtualWithData :: @c fn(inst: ptr, name: ptr, data: ptr, args: ptr, ret: ptr)

## GDExtensionClassMethodCall
MethodCall :: @c fn(userdata: ptr, inst: ptr, args: ptr, argc: i64, ret: ptr, err: ptr)

## GDExtensionClassMethodPtrCall
MethodPtrCall :: @c fn(userdata: ptr, inst: ptr, args: ptr, ret: ptr)

## GDExtensionClassCreationInfo6
@c Info :: struct {
	is_virtual: u8,
	is_abstract: u8,
	is_exposed: u8,
	is_runtime: u8,
	icon_path: ptr,
	set: ptr,
	get: ptr,
	get_property_list: ptr,
	free_property_list: ptr,
	property_can_revert: ptr,
	property_get_revert: ptr,
	validate_property: ptr,
	notification: ptr,
	to_string: ptr,
	reference: ptr,
	unreference: ptr,
	create_instance: CreateInstance,
	free_instance: FreeInstance,
	recreate_instance: RecreateInstance,
	get_virtual: ptr,
	get_virtual_call_data: GetVirtualCallData,
	call_virtual_with_data: CallVirtualWithData,
	class_userdata: ptr,
}

## GDExtensionClassMethodInfo
@c MethodInfo :: struct {
	name: ptr,
	userdata: ptr,
	call: MethodCall,
	ptrcall: MethodPtrCall,
	flags: u32,
	has_return: u8,
	return_info: ptr,
	return_metadata: i32,
	argument_count: u32,
	arguments_info: ptr,
	arguments_metadata: ptr,
	default_argument_count: u32,
	default_arguments: ptr,
}

## GDExtensionPropertyInfo
@c PropertyInfo :: struct {
	type: i32,
	name: ptr,
	class_name: ptr,
	hint: u32,
	hint_string: ptr,
	usage: u32
}

## GDExtensionCallError
@c CallError :: struct { error: i32, argument: i32, expected: i32 }

## GDEXTENSION_METHOD_FLAGS_DEFAULT
METHOD_DEFAULT :: 1

## PROPERTY_USAGE_DEFAULT
USAGE_DEFAULT :: 6

## PROPERTY_USAGE_DEFAULT | PROPERTY_USAGE_NIL_IS_VARIANT, an untyped `Variant` slot
USAGE_VARIANT :: 131078

## GDEXTENSION_CALL_ERROR_INVALID_ARGUMENT
INVALID_ARG :: 2
## GDEXTENSION_CALL_ERROR_TOO_MANY_ARGUMENTS
TOO_MANY :: 3
## GDEXTENSION_CALL_ERROR_TOO_FEW_ARGUMENTS
TOO_FEW :: 4

## A method arg. `.nil` is an untyped `Variant`.
pub Slot :: struct { name: cstr, type: Type }

## A method scripts can call, or a virtual the engine calls.
pub Method :: struct {
	name: cstr,
	call: OnMethod,
	args: []Slot,
	ret: ?Type,
	hash: u32
}

## PropertyHint, the few we use until generated.
pub Hint :: enum { nil, range, options, file = 13 }

pub Property :: struct {
	name: cstr,
	type: Type,
	get: OnMethod,
	set: OnMethod,
	exported: bool,
	hint: Hint,
	hint_string: string,
	default: ?Variant,
}

## A signal a class declares.
pub Sig :: struct { name: cstr, args: []Slot }

pub slot :: fn(name: cstr, t: Type) Slot {
	Slot.{ name, t }
}
pub sig :: fn(name: cstr, args: []Slot) Sig {
	Sig.{ name, args }
}
pub method :: fn(name: cstr, cb: OnMethod, args: []Slot, ret: ?Type) Method {
	Method.{ name, cb, args, ret, 0 }
}

## A virtual the engine calls.
## `hash` is the signature hash from `extension_api.json`.
pub virtual :: fn(name: cstr, cb: OnMethod, args: []Slot, ret: ?Type, hash: int) Method {
	Method.{ name, cb, args, ret, u32.(hash) }
}

pub property :: fn(
	name: cstr, t: Type, get: OnMethod, set: OnMethod, exported: bool,
	hint: Hint = .nil, hint_string: string = "", default: ?Variant = none,
) Property {
	Property.{ name, t, get, set, exported, hint, hint_string, default }
}

## The nth `Variant` of a method's `args`.
pub arg :: fn(args: ptr, n: int) Variant {
	Variant.{ unsafe ptr(args.0 + ptr.size * usize.(n)).read[ptr]() }
}

## A method's `ret` slot as a `Variant`.
pub ret :: fn(at: ptr) Variant { Variant.{ at } }

## A `Method` once registered.
@c Bound :: struct {
	default: ptr,
	name: StringName,
	call: ptr,
	argc: i32,
	types: ptr,
	ret: i32,
	hash: u32
}

## Per-class state, handed to Godot as `class_userdata`. Classes chain through `next`.
@c pub Class :: struct {
	name: StringName,
	parent: StringName,
	state: usize,
	virtuals: ptr,
	nvirtuals: int,
	methods: ptr,
	nmethods: int,
	init: OnInit,
	next: ptr,
}

## Per-object header, what Godot calls `GDExtensionClassInstancePtr`.
@c pub Instance :: struct {
	pub class: ptr,
	pub object: ptr,
}

## The engine object behind `inst`.
pub object :: fn(inst: ptr) ptr {
	unsafe inst.read[Instance]().object
}

## The game's struct behind `inst`.
pub payload :: fn(inst: ptr) ptr {
	ptr(inst.0 + Instance.size)
}

## Resolve `path` against the object and store it in the payload, for `@godot.onready` fields.
pub bind_node :: fn(inst: ptr, at: int, path: string) {
	np := NodePath.(path)
	n := Node.from_ptr(object(inst)).get_node(np) or {
		err("godot: onready path {path} did not resolve, left null")
		return
	}
	unsafe ptr(payload(inst).0 + usize.(at)).write(n.object)
}

## The nth entry of a `Bound` table.
bound :: fn(table: ptr, n: int) ptr {
	ptr(table.0 + Bound.size * usize.(n))
}

## The nth entry of a `PropertyInfo` table.
prop :: fn(table: ptr, n: int) ptr {
	ptr(table.0 + PropertyInfo.size * usize.(n))
}

type_at :: fn(table: ptr, n: int) Type {
	Type.from(unsafe ptr(table.0 + usize.(4 * n)).read[i32]()) or .nil
}

Godot :< {
	pub register :: fn(
		self, name: cstr, parent: cstr, state: usize, virtuals: []Method, own: []Method, props: []Property,
		signals: []Sig, init: OnInit,
	) {
		methods: []Method
		methods << own
		loop i in 0..props.len {
			p := props[i]
			n := unsafe p.name.str()
			methods << method(("get_" + n).cstr(), p.get, [], p.type)
			methods << method(("set_" + n).cstr(), p.set, [slot(p.name, p.type)], none)
		}
		vt := self.table(virtuals)
		mt := self.table(methods)
		loop i in 0..props.len {
			unsafe bound(mt, own.len + 2 * i + 1).write((props[i].default or Variant.{ ptr(0) }).at)
		}
		class := unsafe malloc(Class.size)
		unsafe class.write(Class.{
			self.string_name(name), self.string_name(parent), state,
			vt, virtuals.len, mt, methods.len, init, self.classes.read[ptr](),
		})
		unsafe self.classes.write(class)
		c := unsafe class.read[Class]()
		info := unsafe malloc(Info.size)
		unsafe info.write(Info.{
			is_exposed = 1,
			create_instance = create_instance, free_instance = free_instance, recreate_instance = recreate_instance,
			get_virtual_call_data = get_virtual_call_data, call_virtual_with_data = call_virtual_with_data,
			class_userdata = class,
		})
		self.register_class(self.library, c.name.at, c.parent.at, info)
		unsafe free(info)
		minfo := unsafe malloc(MethodInfo.size)
		loop i in 0..methods.len {
			m := methods[i]
			b := bound(mt, i)
			args := unsafe malloc(PropertyInfo.size * usize.(m.args.len))
			meta := unsafe calloc(usize.(m.args.len), 4)
			loop j in 0..m.args.len {
				unsafe prop(args, j).write(self.slot_info(m.args[j]))
			}
			ret := unsafe malloc(PropertyInfo.size)
			unsafe ret.write(self.slot_info(Slot.{ "", m.ret or .nil }))
			unsafe minfo.write(MethodInfo.{
				b.read[Bound]().name.at, b, call_method, ptrcall_method, u32.(METHOD_DEFAULT),
				u8.(if m.ret == none { 0 } else { 1 }), ret, 0, u32.(m.args.len), args, meta,
			})
			self.register_method(self.library, c.name.at, minfo)
			loop j in 0..m.args.len {
				self.drop_slot(unsafe prop(args, j).read[PropertyInfo]())
			}
			self.drop_slot(unsafe ret.read[PropertyInfo]())
			unsafe free(args)
			unsafe free(meta)
			unsafe free(ret)
		}
		unsafe free(minfo)
		pinfo := unsafe malloc(PropertyInfo.size)
		loop i in 0..props.len {
			p := props[i]
			info := self.slot_info(Slot.{ p.name, p.type }, p.hint, p.hint_string)
			info.usage = u32.(if p.exported { USAGE_DEFAULT } else { 0 })
			unsafe pinfo.write(info)
			get := unsafe bound(mt, own.len + 2 * i).read[Bound]().name.at
			set := unsafe bound(mt, own.len + 2 * i + 1).read[Bound]().name.at
			self.register_property(self.library, c.name.at, pinfo, set, get)
			self.drop_slot(info)
		}
		unsafe free(pinfo)
		loop i in 0..signals.len {
			sg := signals[i]
			args := unsafe malloc(PropertyInfo.size * usize.(sg.args.len))
			loop j in 0..sg.args.len {
				unsafe prop(args, j).write(self.slot_info(sg.args[j]))
			}
			sn := self.string_name(sg.name)
			self.register_signal(self.library, c.name.at, sn.at, args, i64.(sg.args.len))
			sn.destroy()
			loop j in 0..sg.args.len {
				self.drop_slot(unsafe prop(args, j).read[PropertyInfo]())
			}
			unsafe free(args)
		}
	}

	## Unregister every class, newest first.
	pub unregister_all :: fn(self) {
		class := unsafe self.classes.read[ptr]()
		loop !class.is_null() {
			c := unsafe class.read[Class]()
			self.unregister_class(self.library, c.name.at)
			c.name.destroy()
			c.parent.destroy()
			self.unbind(c.virtuals, c.nvirtuals)
			self.unbind(c.methods, c.nmethods)
			unsafe free(class)
			class = c.next
		}
		unsafe self.classes.write(ptr(0))
	}

	## A `Bound` per method.
	table :: fn(self, methods: []Method) ptr {
		t := unsafe malloc(Bound.size * usize.(methods.len))
		loop i in 0..methods.len {
			m := methods[i]
			types := unsafe malloc(usize.(4 * m.args.len))
			loop j in 0..m.args.len {
				unsafe ptr(types.0 + usize.(4 * j)).write(i32.(m.args[j].type))
			}
			unsafe bound(t, i).write(Bound.{
				ptr(0), self.string_name(m.name), ptr(m.call), i32.(m.args.len), types, i32.(m.ret or .nil), m.hash
			})
		}
		t
	}

	slot_info :: fn(self, s: Slot, hint: Hint = .nil, hint_string: string = "") PropertyInfo {
		hs := unsafe malloc(usize.(STRING_SIZE))
		self.new_string(hs, hint_string.ptr, i64.(hint_string.len))
		usage := if s.type == .nil { USAGE_VARIANT } else { USAGE_DEFAULT }
		PropertyInfo.{
			i32.(s.type),
			self.string_name(s.name).at,
			self.string_name("").at,
			u32.(hint),
			hs,
			u32.(usage)
		}
	}

	drop_slot :: fn(self, p: PropertyInfo) {
		StringName.{ p.name }.destroy()
		StringName.{ p.class_name }.destroy()
		self.drop_string(p.hint_string)
		unsafe free(p.hint_string)
	}

	unbind :: fn(self, table: ptr, n: int) {
		loop i in 0..n {
			b := unsafe bound(table, i).read[Bound]()
			b.name.destroy()
			unsafe free(b.types)
			if !b.default.is_null() {
				Variant.{ b.default }.drop()
			}
		}
		unsafe free(table)
	}
}

## Fill each property's default into a fresh payload.
fill_defaults :: fn(inst: ptr, c: Class) {
	loop i in 0..c.nmethods {
		at := bound(c.methods, i)
		b := unsafe at.read[Bound]()
		if !b.default.is_null() {
			unsafe OnMethod(b.call)(inst, at, ptr(0))
		}
	}
}

@c create_instance :: fn(class: ptr, notify: u8) ptr {
	c := unsafe class.read[Class]()
	object := gd.construct_object(c.parent.at)
	inst := unsafe calloc(1, Instance.size + c.state)
	unsafe inst.write(Instance.{ class, object })
	gd.set_instance(object, c.name.at, inst)
	init := c.init
	init(inst)
	if notify != 0 {
		Object.from_ptr(object).notification(0)
	}
	fill_defaults(inst, c)
	object
}

@c free_instance :: fn(class: ptr, inst: ptr) {
	unsafe free(inst)
}

## Rebuild an instance's payload on the same engine object, for a hot-reloaded class.
## Godot restores stored property values afterward through the registered setters.
@c recreate_instance :: fn(class: ptr, object: ptr) ptr {
	c := unsafe class.read[Class]()
	inst := unsafe calloc(1, Instance.size + c.state)
	unsafe inst.write(Instance.{ class, object })
	c.init(inst)
	fill_defaults(inst, c)
	inst
}

## Hand back the matching `Bound` entry, which Godot passes to `call_virtual_with_data`.
@c get_virtual_call_data :: fn(class: ptr, name: ptr, hash: u32) ptr {
	c := unsafe class.read[Class]()
	loop i in 0..c.nvirtuals {
		at := bound(c.virtuals, i)
		b := unsafe at.read[Bound]()
		if b.hash == hash && b.name.same(name) do return at
	}
	ptr(0)
}

@c call_virtual_with_data :: fn(inst: ptr, name: ptr, data: ptr, args: ptr, ret: ptr) {
	ptrcall_method(data, inst, args, ret)
}

## The `Variant` call path.
@c call_method :: fn(userdata: ptr, inst: ptr, args: ptr, argc: i64, ret: ptr, err: ptr) {
	b := unsafe userdata.read[Bound]()
	if argc != i64.(b.argc) {
		unsafe err.write(CallError.{
			i32.(if argc > i64.(b.argc) { TOO_MANY } else { TOO_FEW }),
			0,
			b.argc
		})
		return
	}
	loop i in 0..int.(b.argc) {
		t := type_at(b.types, i)
		if t != .nil && gd.variant_can_convert(i32.(arg(args, i).type()), i32.(t)) == 0 {
			unsafe err.write(CallError.{
				i32.(INVALID_ARG),
				i32.(i),
				i32.(t)
			})
			return
		}
	}
	on_method := unsafe OnMethod(b.call)
	on_method(inst, args, ret)
}

## The typed call path.
@c ptrcall_method :: fn(userdata: ptr, inst: ptr, args: ptr, ret: ptr) {
	b := unsafe userdata.read[Bound]()
	n := int.(b.argc)
	boxed := unsafe malloc(ptr.size * usize.(n))
	loop i in 0..n {
		t := type_at(b.types, i)
		v := if t == .nil { arg(args, i) } else { gd.variant() }
		if t != .nil {
			gd.from_type(t, v, arg(args, i).at)
		}
		unsafe ptr(boxed.0 + ptr.size * usize.(i)).write(v.at)
	}
	rt := Type.from(b.ret) or .nil
	out := if rt == .nil { Variant.{ ret } } else { gd.variant() }
	on_method := unsafe OnMethod(b.call)
	on_method(inst, boxed, out.at)
	if rt != .nil {
		gd.to_type(rt, out, ret)
		out.drop()
	}
	loop i in 0..n {
		if type_at(b.types, i) != .nil {
			arg(boxed, i).drop()
		}
	}
	unsafe free(boxed)
}
