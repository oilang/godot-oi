module godot

## Godot builtins.

## GDExtensionInterfaceVariantGetPtrConstructor
GetConstructor :: @c fn(variant_type: i32, index: i32) ptr

## GDExtensionPtrConstructor
Constructor :: @c fn(base: ptr, args: ptr)

## GDExtensionInterfaceVariantGetPtrOperatorEvaluator
GetEvaluator :: @c fn(op: i32, left: i32, right: i32) ptr

## GDExtensionPtrOperatorEvaluator
Evaluator :: @c fn(left: ptr, right: ptr, result: ptr)

## GDExtensionInterfaceVariantGetPtrBuiltinMethod
GetBuiltinMethod :: @c fn(variant_type: i32, method: ptr, hash: i64) ptr

## GDExtensionPtrBuiltInMethod
pub BuiltinMethod :: @c fn(base: ptr, args: ptr, ret: ptr, argc: i32)

## GDExtensionInterfaceVariantCall
VariantCall :: @c fn(base: ptr, method: ptr, args: ptr, argc: i64, ret: ptr, err: ptr)

## GDExtensionInterfaceVariantGetPtrUtilityFunction
GetUtilityFunction :: @c fn(function: ptr, hash: i64) ptr

## GDExtensionPtrUtilityFunction
pub UtilityFunction :: @c fn(ret: ptr, args: ptr, argc: i32)

## GDExtensionVariantOperator
EQUAL :: 0

@c Procs :: struct {
	constructor: ptr,
	destructor: ptr,
	evaluator: ptr,
	builtin_method: ptr,
	utility: ptr,
	call: ptr,
	callable_custom: ptr,
}
procs := Procs.{}

lookups :: fn() Procs {
	if procs.constructor.is_null() {
		procs = Procs.{
			gd.proc("variant_get_ptr_constructor"),
			gd.proc("variant_get_ptr_destructor"),
			gd.proc("variant_get_ptr_operator_evaluator"),
			gd.proc("variant_get_ptr_builtin_method"),
			gd.proc("variant_get_ptr_utility_function"),
			gd.proc("variant_call"),
			gd.proc("callable_custom_create2"),
		}
	}
	procs
}

Godot :< {
	pub variant_call :: fn(self; base: Variant, method: ptr, args: []Variant) Variant {
		packed := unsafe malloc(ptr.size * usize.(args.len()))
		defer unsafe free(packed)

		# indexed, since a loop binding would be a copy
		loop i in ..args.len() {
			unsafe ptr.(packed.0 + ptr.size * usize.(i)).write(args[i].at)
		}

		out := self.variant()
		err := unsafe malloc(CallError.size)
		defer unsafe free(err)

		unsafe VariantCall.(lookups().call)(base.at, method, packed, i64.(args.len()), out.at, err)
		out
	}

	## `PtrBuiltInMethod` / `PtrUtilityFunction`.
	pub ptr_bind :: fn(self; slot: int, type: Type, name: cstr, hash: i64) ptr {
		cell := ptr.(self.binds.0 + ptr.size * usize.(slot))
		fp := unsafe cell.read[ptr]()
		if !fp.is_null() do return fp

		sn := self.string_name(name)
		fp = if type == .nil {
			unsafe GetUtilityFunction.(lookups().utility)(sn, hash)
		} else {
			unsafe GetBuiltinMethod.(lookups().builtin_method)(i32.(type), sn, hash)
		}
		self.free_name(sn)
		unsafe cell.write(fp)

		fp
	}

	pub op_bind :: fn(self; slot: int, op: VariantOperator, left: Type, right: Type) ptr {
		cell := ptr.(self.binds.0 + ptr.size * usize.(slot))
		fp := unsafe cell.read[ptr]()
		if fp.is_null() {
			fp = unsafe GetEvaluator.(lookups().evaluator)(i32.(op), i32.(left), i32.(right))
			unsafe cell.write(fp)
		}
		fp
	}
}

## Constructor `index` of `type` over `args` into fresh storage taken on by the caller.
## Frees `args`.
pub construct :: fn(type: Type, size: usize, index: int, args: []ptr) ptr {
	get := unsafe GetConstructor.(lookups().constructor)
	ctor := unsafe Constructor.(get(i32.(type), i32.(index)))
	packed := unsafe malloc(ptr.size * usize.(args.len()))
	defer unsafe free(packed)

	loop a, i in args {
		unsafe packed.offset(i * int.(ptr.size)).write(a)
	}

	base := unsafe malloc(size)
	ctor(base, packed)
	loop a in args do unsafe free(a)

	base
}

## Run the destructor of `type` on `b` and free it.
pub destroy :: fn(type: Type, b: ptr) {
	get := unsafe GetDestructor.(lookups().destructor)
	dtor := unsafe Destructor.(get(i32.(type)))
	dtor(b)
	unsafe free(b)
}

## Equality check through the engine's Equal operator.
pub equal :: fn(type: Type, left: ptr, right: ptr) bool {
	get :: unsafe GetEvaluator.(lookups().evaluator)
	eval :: unsafe Evaluator.(get(i32.(EQUAL), i32.(type), i32.(type)))
	out := unsafe malloc(1)
	defer unsafe free(out)
	defer unsafe free(left)
	defer unsafe free(right)

	eval(left, right, out)
	unsafe out.read[bool]()
}

## An oi fn behind a custom `Callable`.
pub Fn :: fn(args: []Variant)

## The boxed fns, indexed by the slot handed to Godot as `callable_userdata`.
Registry :: struct { fns: []?Fn }
registry := Registry.{}

box :: fn(f: Fn) int {
	fns := registry.fns
	loop i in ..fns.len() {
		if fns[i] is .none {
			fns[i] = f
			registry.fns = fns
			return i
		}
	}
	fns << f
	registry.fns = fns
	fns.len() - 1
}

callable_call :: fn(userdata: ptr, args: ptr, argc: i64, ret: ptr, err: ptr) {
	unsafe err.write(CallError.{ 0, 0, 0 })
	fns := registry.fns
	f := fns[int.(userdata.0)] or do return
	all: []Variant = []
	loop i in ..int.(argc) {
		all << arg[Variant](args, i)
	}
	f(all)
}

callable_free :: fn(userdata: ptr) {
	fns := registry.fns
	fns[int.(userdata.0)] = none
	registry.fns = fns
}

Callable :< {
	## A `Callable` over an oi fn, boxed until Godot frees the callable.
	pub of :: fn(f: Fn) Callable {
		info := unsafe malloc(CallableCustomInfo2.size)
		defer unsafe free(info)

		unsafe info.write(CallableCustomInfo2.{
			callable_userdata = ptr.(usize.(box(f))),
			token = gd.library,
			call_func = callable_call,
			free_func = callable_free,
		})

		at := unsafe malloc(Callable.size)
		unsafe CallableCustomCreate2.(lookups().callable_custom)(at, info)
		Callable.from_bytes(at)
	}
}

Signal :< {
	## `Signal(object, name)`.
	pub of :: fn(object: ptr, name: string) Signal {
		sn := StringName.(name)
		o := unsafe malloc(8)
		unsafe o.write(object)
		Signal.from_bytes(construct(.signal, Signal.size, 2, [ o, sn.bytes() ]))
	}
}

String :< {
	pub str :: fn(self) string {
		b := self.bytes()
		defer unsafe free(b)

		n := gd.string_utf8(b, ptr.(0), 0)
		buf := unsafe malloc(usize.(n))
		defer unsafe free(buf)

		_ := gd.string_utf8(b, buf, n)
		unsafe buf.string(int.(n))
	}
}

String : From[string] < {
	from :: fn(v: string) String {
		b := unsafe malloc(String.size)
		gd.new_string(b, v.ptr, i64.(v.len()))
		String.from_bytes(b)
	}
}

NodePath :< {
	pub str :: fn(self) string {
		s := String.from_node_path(self)
		s.str()
	}
}

NodePath : From[string] < {
	from :: fn(v: string) NodePath {
		NodePath.from_string(String.(v))
	}
}

StringName :< {
	pub str :: fn(self) string {
		s := String.from_string_name(self)
		s.str()
	}
}

StringName : From[string] < {
	from :: fn(v: string) StringName {
		StringName.from_string(String.(v))
	}
}
