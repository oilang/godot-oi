module godot

## Godot builtins.

## GDExtensionInterfaceVariantGetPtrConstructor
GetConstructor :: @c fn(variant_type: i32, index: i32) ptr

## GDExtensionPtrConstructor
Constructor :: @c fn(base: ptr, args: ptr)

## GDExtensionInterfaceVariantGetPtrOperatorEvaluator
GetEvaluator :: @c fn(op: i32, left: i32, right: i32) ptr

## GDExtensionPtrOperatorEvaluator
Evaluator :: @c fn(left: ptr, right: ptr, result: ptr)

## GDExtensionInterfaceVariantGetPtrBuiltinMethod
GetBuiltinMethod :: @c fn(variant_type: i32, method: ptr, hash: i64) ptr

## GDExtensionPtrBuiltInMethod
pub BuiltinMethod :: @c fn(base: ptr, args: ptr, ret: ptr, argc: i32)

## GDExtensionInterfaceVariantCall
VariantCall :: @c fn(base: ptr, method: ptr, args: ptr, argc: i64, ret: ptr, err: ptr)

## GDExtensionInterfaceVariantGetPtrUtilityFunction
GetUtilityFunction :: @c fn(function: ptr, hash: i64) ptr

## GDExtensionPtrUtilityFunction
pub UtilityFunction :: @c fn(ret: ptr, args: ptr, argc: i32)

## GDExtensionVariantOperator
EQUAL :: 0

STRING_NAME_SIZE :: 8

@c Procs :: struct {
	constructor: ptr,
	destructor: ptr,
	evaluator: ptr,
	builtin_method: ptr,
	utility: ptr,
	call: ptr,
}
procs := Procs.{}

lookups :: fn() Procs {
	if procs.constructor.is_null() {
		procs = Procs.{
			gd.proc("variant_get_ptr_constructor"),
			gd.proc("variant_get_ptr_destructor"),
			gd.proc("variant_get_ptr_operator_evaluator"),
			gd.proc("variant_get_ptr_builtin_method"),
			gd.proc("variant_get_ptr_utility_function"),
			gd.proc("variant_call"),
		}
	}
	procs
}

Godot :< {
	pub variant_call :: fn(self, base: Variant, method: StringName, args: []Variant) Variant {
		packed := unsafe malloc(ptr.size * usize.(args.len))
		loop i in 0..args.len {
			unsafe ptr(packed.0 + ptr.size * usize.(i)).write(args[i].at)
		}
		out := self.variant()
		err := unsafe malloc(CallError.size)
		unsafe VariantCall(lookups().call)(base.at, method.at, packed, i64.(args.len), out.at, err)
		unsafe free(err)
		unsafe free(packed)
		out
	}

	## `PtrBuiltInMethod` / `PtrUtilityFunction`.
	pub ptr_bind :: fn(self, slot: int, type: Type, name: cstr, hash: i64) ptr {
		cell := ptr(self.binds.0 + ptr.size * usize.(slot))
		fp := unsafe cell.read[ptr]()
		if !fp.is_null() do return fp

		sn := self.string_name(name)
		fp = if type == .nil {
			unsafe GetUtilityFunction(lookups().utility)(sn.at, hash)
		} else {
			unsafe GetBuiltinMethod(lookups().builtin_method)(i32.(type), sn.at, hash)
		}
		sn.destroy()
		unsafe cell.write(fp)

		fp
	}
}

## Constructor `index` of `type` over `args` into fresh storage taken on by the caller.
## Frees `args`.
pub construct :: fn(type: Type, size: usize, index: int, args: []ptr) ptr {
	get := unsafe GetConstructor(lookups().constructor)
	ctor := unsafe Constructor(get(i32.(type), i32.(index)))
	packed := unsafe malloc(ptr.size * usize.(args.len))
	loop i in 0..args.len {
		unsafe packed.offset(i * int.(ptr.size)).write(args[i])
	}
	base := unsafe malloc(size)
	ctor(base, packed)
	loop a in args {
		unsafe free(a)
	}
	unsafe free(packed)
	base
}

## Run the destructor of `type` on `b` and free it.
pub destroy :: fn(type: Type, b: ptr) {
	get := unsafe GetDestructor(lookups().destructor)
	dtor := unsafe Destructor(get(i32.(type)))
	dtor(b)
	unsafe free(b)
}

## Equality check through the engine's Equal operator.
pub equal :: fn(type: Type, left: ptr, right: ptr) bool {
	get :: unsafe GetEvaluator(lookups().evaluator)
	eval :: unsafe Evaluator(get(i32.(EQUAL), i32.(type), i32.(type)))
	out := unsafe malloc(1)
	eval(left, right, out)
	hit := unsafe out.read[u8]()
	unsafe free(out)
	unsafe free(left)
	unsafe free(right)
	hit != 0
}

String :< {
	pub str :: fn(self) string {
		b := self.bytes()
		n := gd.string_utf8(b, ptr(0), 0)
		buf := unsafe malloc(usize.(n))
		_ := gd.string_utf8(b, buf, n)
		s := unsafe buf.string(int.(n))
		unsafe free(buf)
		unsafe free(b)
		s
	}
}

String : From[string] < {
	from :: fn(v: string) String {
		b := unsafe malloc(String.size)
		gd.new_string(b, v.ptr, i64.(v.len))
		String.from_bytes(b)
	}
}

NodePath :< {
	pub str :: fn(self) string {
		s := String.from_node_path(self)
		s.str()
	}
}

NodePath : From[string] < {
	from :: fn(v: string) NodePath {
		NodePath.from_string(String.(v))
	}
}

StringName :< {
	## A malloc'd copy of the engine's 8 bytes, the shape `construct` takes.
	pub bytes :: fn(self) ptr {
		b := unsafe malloc(usize.(STRING_NAME_SIZE))
		word := unsafe self.at.read[u64]()
		unsafe b.write(word)
		b
	}

	pub str :: fn(self) string {
		s := String.from_string_name(self)
		s.str()
	}
}

StringName : From[string] < {
	from :: fn(v: string) StringName {
		s := String.(v)
		StringName.{ construct(.string_name, usize.(STRING_NAME_SIZE), 2, [ s.bytes() ]) }
	}
}
