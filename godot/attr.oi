module godot

use fs
use os
use json.{ Obj, parse, from_json }

## Marks a struct `class!` registered, for `init!` to find.
pub class :: ()
pub func :: ()
pub signal :: ()

## Marks a fn in a fill as a private helper: neither a virtual nor a method.
pub hidden :: ()

pub export :: struct { range: string = "" }

## Marks a field as a scene-relative node path, resolved by `get_node`.
pub onready :: struct { path: string = "" }

## The `Type` variant a field boxes as.
## `f64` -> `float`, `godot.PackedInt32Array` -> `packed_int32_array`
pub vtype :: fn(t: Ast) out: string {
	s := t.str()
	if s == "f64" || s == "f32" do return "float"
	if s in [ "int", "i64", "i32", "i16", "i8", "u64", "u32", "u16", "u8" ] do return "int"
	parts := s.split(".")
	n := parts[parts.len() - 1]
	if n == "Variant" do return "nil"
	low := fn(j: int) bool { j < n.len() && n[j] >= 'a' && n[j] <= 'z' }
	loop i in ..n.len() {
		up := n[i] >= 'A' && n[i] <= 'Z'
		if i > 0 && up && (low(i - 1) || low(i + 1)) do out += "_"
		out += n[i..i + 1].lower()
	}
	out
}

pub noted :: fn(item: Ast, name: string) bool {
	loop a in item.notes {
		if a.name.str() == "godot." + name do return true
	}
	false
}

## The parent class a struct's first field embeds.
pub parent_of :: fn(fields: []Ast) string {
	if fields.len() > 0 && fields[0].typ == fields[0].name.str() do return fields[0].typ.str()
	""
}

## `godot/api_index.json`, parsed once into plain structs
index :: comp load_index()

load_index :: fn() out: []Entry {
	home := os.env("OI_HOME") or {
		(os.env("HOME") or "") + "/.oi"
	}
	path := "{home}/lib/godot/api_index.json"
	src := fs.read(path) or {
		panic!("godot: cannot read {path}, run `just api`")
	}
	parsed :: parse(src) or {
		panic!("godot: {path}: {$.message()}")
	}
	root: Obj = match v := parsed {
		is Obj => v,
		_ => []
	}
	loop c in root.keys {
		e := from_json[Entry](root[c]) or panic!("godot: api_index.json {c}: {$.message()}")
		e.name = c
		out << e
	}
	return
}

## A class's `api_index.json` entry, keyed by `name`.
Entry :: struct { pub name: string = "", pub parent: string, pub virtuals: []Virtual }
Virtual :: struct { pub name: string, pub hash: int, pub required: bool }

## Every virtual class and its ancestors declare, nearest first.
inherited :: fn(class: string) out: []Virtual {
	c := class
	loop c != "" {
		next := ""
		loop e in index {
			if e.name == c {
				out << e.virtuals
				next = e.parent
				break
			}
		}
		c = next
	}
	return
}

## The signature hash of virtual name on class or an ancestor.
pub virtual_hash :: fn(class: string, name: string) int {
	loop v in inherited(class) {
		if v.name == name do return v.hash
	}
	return -1
}

## Fail the build: `fname` names no virtual on `parent`'s chain.
pub reject :: fn(class: string, fname: string, parent: string) {
	if parent == "" {
		panic!("godot: {class} fill has no `@godot.class!` struct before it, cannot check its virtuals")
	}
	panic!("godot: {class}.{fname} is not a virtual of {parent} or its ancestors")
}

## @godot.class! has no shape for `fname` yet.
pub unsupported :: fn(class: string, fname: string) {
	panic!("godot: {class}.{fname} is a virtual class! cannot marshal yet, only ready/process/physics_process")
}

## Fail the build when an ancestor of `class` marks a virtual required that `have` does not list.
pub require_all :: fn(class: string, parent: string, have: []string) {
	loop v in inherited(parent) {
		if v.required && !(v.name in have) {
			panic!("godot: {class} must implement {v.name}, {parent} requires it")
		}
	}
}
