module godot

use fs
use os
use json.{ Arr, Obj, parse }

pub func :: ()
pub signal :: ()
pub export :: struct { range: string = "" }

## Marks a field as a scene-relative node path, resolved by `get_node`.
pub onready :: struct { path: string = "" }

pub kind :: fn(t: Ast) string {
	if t == "f64" do return "float"
	if t == "bool" do return "bool"
	if t == "i64" || t == "int" || t == "u64" do return "int"
	""
}

pub width :: fn(f: Ast) int {
	if f.name.str() == f.typ.str() do return 8
	if noted(f, "onready") do return 8
	t := f.typ.str()
	if t == "f64" || t == "i64" || t == "int" || t == "u64" || t == "usize" || t == "ptr" do return 8
	if t == "f32" || t == "i32" || t == "u32" do return 4
	if t == "i16" || t == "u16" do return 2
	if t == "bool" || t == "u8" || t == "i8" do return 1
	0
}

pub noted :: fn(item: Ast, name: string) bool {
	loop a in item.notes {
		if a.name.str() == "godot." + name do return true
	}
	false
}

last_class := ""
last_parent := ""

## Remember a struct's parent.
pub note_parent :: fn(name: string, parent: string) {
	last_class = name
	last_parent = parent
}

pub parent_of :: fn(name: string) string {
	if last_class == name { last_parent } else { "" }
}

## `godot/api/index.json`
## TODO: move to comp
index :: fn() Obj {
	home := os.env("OI_HOME") or {
		(os.env("HOME") or "") + "/.oi"
	}
	path := "{home}/lib/godot/api/index.json"
	src := fs.read(path) or {
		panic!("godot: cannot read {path}, run `just api`")
	}
	parsed :: parse(src) or {
		panic!("godot: {path}: {$.message()}")
	}
	match parsed {
		v @ Obj => v,
		_ => []
	}
}

## Every virtual class and its ancestors declare, nearest first.
inherited :: fn(class: string) out: []Obj {
	root := index()
	c := class
	loop c != "" && c in root.keys {
		o: Obj = match root[c] {
			v @ Obj => v,
			_ => []
		}
		vs: Arr = match o["virtuals"] {
			v @ Arr => v,
			_ => []
		}
		loop it in vs {
			out << match it {
				v @ Obj => v,
				_ => []
			}
		}
		c = match o["parent"] {
			v @ string => v,
			_ => ""
		}
	}
	return
}

named :: fn(v: Obj) string {
	match v["name"] {
		s @ string => s,
		_ => ""
	}
}

## The signature hash of virtual name on class or an ancestor.
pub virtual_hash :: fn(class: string, name: string) int {
	loop v in inherited(class) {
		if named(v) == name {
			return match v["hash"] {
				h @ float => int.(h),
				_ => 0
			}
		}
	}
	return -1
}

## Fail the build: `fname` names no virtual on `parent`'s chain.
pub reject :: fn(class: string, fname: string, parent: string) {
	if parent == "" {
		panic!("godot: {class} fill has no `@godot.class!` struct before it, cannot check its virtuals")
	}
	panic!("godot: {class}.{fname} is not a virtual of {parent} or its ancestors")
}

## @godot.class! has no shape for `fname` yet.
pub unsupported :: fn(class: string, fname: string) {
	panic!("godot: {class}.{fname} is a virtual class! cannot marshal yet, only ready/process/physics_process")
}

## Fail the build when an ancestor of `class` marks a virtual required that `have` does not list.
pub require_all :: fn(class: string, parent: string, have: []string) {
	loop v in inherited(parent) {
		n := named(v)
		req := match v["required"] {
			b @ bool => b,
			_ => false
		}
		if req && !(n in have) {
			panic!("godot: {class} must implement {n}, {parent} requires it")
		}
	}
}
