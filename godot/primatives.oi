module godot

## Raw `GDExtensionStringNamePtr`s for the interface calls and the records that outlive a call.
Godot :< {
	pub string_name :: fn(self; s: cstr) ptr {
		at := unsafe malloc(StringName.size)
		self.new_string_name(at, s, 0)
		at
	}

	pub free_name :: fn(self; at: ptr) {
		self.drop_string_name(at)
		unsafe free(at)
	}
}
