module godot

## Hand-written arithmetic on the generated math builtins.

Vector2 : Add, Sub, Neg, Mul, Div < {
	add :: fn(self, other: Self) Self { .{ self.x + other.x, self.y + other.y } }
	sub :: fn(self, other: Self) Self { .{ self.x - other.x, self.y - other.y } }
	neg :: fn(self) Self { .{ -self.x, -self.y } }
	mul :: fn(self, other: Self) Self { .{ self.x * other.x, self.y * other.y } }
	div :: fn(self, other: Self) Self { .{ self.x / other.x, self.y / other.y } }
}

Vector2i : Add, Sub, Neg, Mul, Div < {
	add :: fn(self, other: Self) Self { .{ self.x + other.x, self.y + other.y } }
	sub :: fn(self, other: Self) Self { .{ self.x - other.x, self.y - other.y } }
	neg :: fn(self) Self { .{ -self.x, -self.y } }
	mul :: fn(self, other: Self) Self { .{ self.x * other.x, self.y * other.y } }
	div :: fn(self, other: Self) Self { .{ self.x / other.x, self.y / other.y } }
}

Vector3 : Add, Sub, Neg, Mul, Div < {
	add :: fn(self, other: Self) Self { .{ self.x + other.x, self.y + other.y, self.z + other.z } }
	sub :: fn(self, other: Self) Self { .{ self.x - other.x, self.y - other.y, self.z - other.z } }
	neg :: fn(self) Self { .{ -self.x, -self.y, -self.z } }
	mul :: fn(self, other: Self) Self { .{ self.x * other.x, self.y * other.y, self.z * other.z } }
	div :: fn(self, other: Self) Self { .{ self.x / other.x, self.y / other.y, self.z / other.z } }
}

