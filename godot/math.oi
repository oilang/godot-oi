Color : Add, Sub, Neg, Mul, Div < {
	add :: fn(self, other: Self) Self { .{ self.r + other.r, self.g + other.g, self.b + other.b, self.a + other.a } }
	sub :: fn(self, other: Self) Self { .{ self.r - other.r, self.g - other.g, self.b - other.b, self.a - other.a } }
	neg :: fn(self) Self { .{ -self.r, -self.g, -self.b, -self.a } }
	mul :: fn(self, other: Self) Self { .{ self.r * other.r, self.g * other.g, self.b * other.b, self.a * other.a } }
	div :: fn(self, other: Self) Self { .{ self.r / other.r, self.g / other.g, self.b / other.b, self.a / other.a } }
}
