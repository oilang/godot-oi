Vector4 : Add, Sub, Neg, Mul, Div < {
	add :: fn(self, other: Self) Self { .{ self.x + other.x, self.y + other.y, self.z + other.z, self.w + other.w } }
	sub :: fn(self, other: Self) Self { .{ self.x - other.x, self.y - other.y, self.z - other.z, self.w - other.w } }
	neg :: fn(self) Self { .{ -self.x, -self.y, -self.z, -self.w } }
	mul :: fn(self, other: Self) Self { .{ self.x * other.x, self.y * other.y, self.z * other.z, self.w * other.w } }
	div :: fn(self, other: Self) Self { .{ self.x / other.x, self.y / other.y, self.z / other.z, self.w / other.w } }
}

Vector4i : Add, Sub, Neg, Mul, Div < {
	add :: fn(self, other: Self) Self { .{ self.x + other.x, self.y + other.y, self.z + other.z, self.w + other.w } }
	sub :: fn(self, other: Self) Self { .{ self.x - other.x, self.y - other.y, self.z - other.z, self.w - other.w } }
	neg :: fn(self) Self { .{ -self.x, -self.y, -self.z, -self.w } }
	mul :: fn(self, other: Self) Self { .{ self.x * other.x, self.y * other.y, self.z * other.z, self.w * other.w } }
	div :: fn(self, other: Self) Self { .{ self.x / other.x, self.y / other.y, self.z / other.z, self.w / other.w } }
