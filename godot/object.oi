module godot

## Call engine methods on an object.

## An engine object, the root of `api/classes/`.
## Its own methods are generated into `api/classes/object.oi`.
@c pub Object :: struct { pub object: ptr }

Object :< {
	pub from_ptr :: fn(p: ptr) Object { .{ p } }

	pub is_a :: fn(self; class: string) bool { self.is_class(class) }
}

GodotError :< Error

## A bitfield crosses as the bitmask.
Bits[E] :< {
	pub mask :: fn(self) i64 {
		m := 0
		loop e in self do m |= 1 << ord(e)
		m
	}
}

## The flags set in a bitmask.
pub bits_of[E: Ordinal] :: fn(m: i64) out: Bits[E] {
	loop i in ..E.count {
		e := E.from_index(i) or continue
		if m & 1 << ord(e) != 0 do out[e] = ()
	}
	out
}

Godot :< {
	## `MethodBind`.
	pub bind :: fn(self; slot: int, class: cstr, method: cstr, hash: i64) ptr {
		cell := ptr.(self.binds.0 + ptr.size * usize.(slot))
		bind := unsafe cell.read[ptr]()
		if !bind.is_null() do return bind

		class_name := self.string_name(class)
		method_name := self.string_name(method)
		bind = self.get_method_bind(class_name.at, method_name.at, hash)

		class_name.destroy()
		method_name.destroy()
		unsafe cell.write(bind)

		bind
	}

	## Call `bind` on the engine `object`.
	pub call :: fn(self; object: ptr, bind: ptr, args: []Variant) Variant {
		packed := unsafe malloc(ptr.size * usize.(args.len()))
		defer unsafe free(packed)

		loop a, i in args {
			unsafe ptr.(packed.0 + ptr.size * usize.(i)).write(a.at)
		}

		out := self.variant()
		err := unsafe malloc(CallError.size)
		defer unsafe free(err)

		self.method_bind_call(bind, object, packed, i64.(args.len()), out.at, err)
		out
	}
}
