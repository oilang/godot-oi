module godot

## Marshal primitives in and out of `Variant`.

## GDExtensionVariantType
pub Type :: enum {
	nil, bool, int, float, string,
	vector2, vector2i, rect2, rect2i, vector3, vector3i, transform2d, vector4, vector4i,
	plane, quaternion, aabb, basis, transform3d, projection, color,
	string_name, node_path, rid, object, callable, signal, dictionary, array,
	packed_byte_array, packed_int32_array, packed_int64_array, packed_float32_array, packed_float64_array,
	packed_string_array, packed_vector2_array, packed_vector3_array, packed_color_array, packed_vector4_array,
}

## Variant in extension_api.json builtin_class_sizes
VARIANT_SIZE :: 24

## String in extension_api.json builtin_class_sizes
STRING_SIZE :: 8

## GDExtensionVariantPtr, owning the heap bytes behind `at`.
## Not `@c`, so `Variant.(cell)` views a slot Godot owns, read from the cell holding its address, without owning it.
pub Variant :: struct { pub at: ptr }

Variant : Drop, Copy < {
	drop :: fn(mut self) { gd.release(self.at) }

	copy :: fn(mut self) { self.at = gd.dup(self.at) }
}

Godot :< {
	## A fresh nil `Variant` on the heap.
	pub variant :: fn(self) Variant {
		Variant.{ unsafe calloc(1, usize.(VARIANT_SIZE)) }
	}

	## Build Variant from raw typed storage, and write Variant back out as that type.
	pub from_type :: fn(self; t: Type, v: Variant, value: ptr) {
		ctor := unsafe FromType.(self.variant_from_type(i32.(t)))
		ctor(v.at, value)
	}

	pub to_type :: fn(self; t: Type, v: Variant, out: ptr) {
		ctor := unsafe ToType.(self.variant_to_type(i32.(t)))
		ctor(out, v.at)
	}

	## A raw copy of the `Variant` at `at`.
	dup :: fn(self; at: ptr) ptr {
		d := unsafe malloc(usize.(VARIANT_SIZE))
		self.variant_copy(d, at)
		d
	}

	## Destroy and free a raw `Variant`.
	release :: fn(self; at: ptr) {
		self.variant_destroy(at)
		unsafe free(at)
	}
}

## Fresh `Variant`s holding a value, `Variant.(1)`.
Variant : From[bool] < {
	from :: fn(b: bool) Variant {
		v := gd.variant()
		v.set_bool(b)
		v
	}
}

Variant : From[i64] < {
	from :: fn(n: i64) Variant {
		v := gd.variant()
		v.set_int(n)
		v
	}
}

Variant : From[f64] < {
	from :: fn(f: f64) Variant {
		v := gd.variant()
		v.set_float(f)
		v
	}
}

Variant : From[string] < {
	from :: fn(s: string) Variant {
		v := gd.variant()
		v.set_string(s)
		v
	}
}

## The sized ints and `f32` box as Godot's `int` and `float`, `u64` wrapping past `i64`.
Variant : From[i32] < { from :: fn(n: i32) Variant do Variant.(i64.(n)) }
Variant : From[i16] < { from :: fn(n: i16) Variant do Variant.(i64.(n)) }
Variant : From[i8] < { from :: fn(n: i8) Variant do Variant.(i64.(n)) }
Variant : From[u64] < { from :: fn(n: u64) Variant do Variant.(i64.(n)) }
Variant : From[u32] < { from :: fn(n: u32) Variant do Variant.(i64.(n)) }
Variant : From[u16] < { from :: fn(n: u16) Variant do Variant.(i64.(n)) }
Variant : From[u8] < { from :: fn(n: u8) Variant do Variant.(i64.(n)) }
Variant : From[f32] < { from :: fn(f: f32) Variant do Variant.(f64.(f)) }

## Unbox a Varaint as `T`.
pub unbox[T] :: fn(v: Variant) T {
	comp match T {
		bool => v.bool(),
		i64 => v.int(),
		f64 => v.float(),
		i32, i16, i8, u64, u32, u16, u8 => T.(v.int()),
		f32 => f32.(v.float()),
		Variant => v,
		string => v.string(),
		_ => T.from(v),
	}
}

Variant :< {
	pub type :: fn(self) Type {
		Type.from(gd.variant_type(self.at)) or .nil
	}

	pub bool :: fn(self) bool {
		buf := unsafe malloc(1)
		defer unsafe free(buf)

		gd.to_type(.bool, self, buf)
		unsafe buf.read[bool]()
	}

	pub int :: fn(self) i64 {
		buf := unsafe malloc(8)
		defer unsafe free(buf)

		gd.to_type(.int, self, buf)
		unsafe buf.read[i64]()
	}

	pub float :: fn(self) f64 {
		buf := unsafe malloc(8)
		defer unsafe free(buf)

		gd.to_type(.float, self, buf)
		unsafe buf.read[f64]()
	}

	pub string :: fn(self) string {
		str := unsafe malloc(usize.(STRING_SIZE))
		defer unsafe free(str)

		gd.to_type(.string, self, str)
		defer gd.drop_string(str)

		n := gd.string_utf8(str, ptr.(0), 0)
		buf := unsafe malloc(usize.(n))
		defer unsafe free(buf)

		gd.string_utf8(str, buf, n)
		unsafe buf.string(int.(n))
	}

	## Godot's own rendering of the value, which feeds `Display`.
	pub str :: fn(self) string {
		b := unsafe malloc(String.size)
		gd.variant_stringify(self.at, b)
		s := String.from_bytes(b)
		s.str()
	}

	## Setters overwrite in place.
	pub set_bool :: fn(self; b: bool) {
		buf := unsafe malloc(1)
		defer unsafe free(buf)

		unsafe buf.write(b8.(b))
		gd.from_type(.bool, self, buf)
	}

	pub set_int :: fn(self; n: i64) {
		buf := unsafe malloc(8)
		defer unsafe free(buf)

		unsafe buf.write(n)
		gd.from_type(.int, self, buf)
	}

	pub set_float :: fn(self; f: f64) {
		buf := unsafe malloc(8)
		defer unsafe free(buf)

		unsafe buf.write(f)
		gd.from_type(.float, self, buf)
	}

	pub set_string :: fn(self; s: string) {
		str := unsafe malloc(usize.(STRING_SIZE))
		defer unsafe free(str)

		gd.new_string(str, s.ptr, i64.(s.len()))
		defer gd.drop_string(str)

		gd.from_type(.string, self, str)
	}
}
