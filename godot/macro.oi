module godot

use fs
use json

pub class! :: fn(input: Ast) Ast {
	n := input.name
	name := n.str()
	items := input.items
	params := [`inst: ptr`, `args: ptr`, `ret: ptr`]

	parent := parent_of(items)
	if parent != "" {
		reg := ident(name + "_register")
		on := ident(name + "_onready")
		edit := gensym("edit")
		xml := ident("{name}_xml")
		props: []Ast
		members := ""
		ons: []Ast

		loop f in items {
			fd := f.name
			ty := f.typ
			path := ""
			loop p in note(f, "onready") {
				path = p.str()
			}
			if path != "" {
				ons << `unsafe %n.(godot.payload(inst)).%edit(fn(mut x: %n) () {
					x.%fd = %ty.from_ptr(godot.node_at(inst, %path))
				})`
			}
			if !noted(f, "export") do continue

			# an exported embed, like the parent class, exports its promoted fields
			embed := ty.kind.str() == "ident" && leaf(ty.str()) == fd.str()
			loop sub in if embed do def(ty).items else do [f] {
				sd := sub.name
				sname := sd.str()
				st := sub.typ
				t := parse("." + vtype(st))
				hint := note(sub, "export")

				# an embed hints its own fields by name, `game.Level @gd.export.{ .file, "*.tscn", field = "scene" }`
				if embed do loop a in f.notes {
					field := """field = "{sname}\""""
					lit := leaf(a.name.str()) == "export" && a.kind.str() == "structlit"
					named := lit && a.items.any { $.str() == field }
					if named do hint = a.items.filter { $.str() != field }
				}
				c := if st.kind.str() == "array" do "" else do leaf(st.str())

				# only Node declares `_ready` and only Resource `_setup_local_to_scene`
				if hint.len() == 0 && virtual_hash(c, "_ready") >= 0 do hint = [`.node_type`, `%c`]
				if hint.len() == 0 && virtual_hash(c, "_setup_local_to_scene") >= 0 do hint = [`.resource_type`, `%c`]

				gt := gtype(st)
				sdoc := doc(sub)
				members += """<member name="{sname}" type="{gt}" setter="set_{sname}" getter="get_{sname}">{sdoc}</member>"""

				props << `godot.property(%sname, %t, fn(%{..params}) {
					godot.ret(ret, godot.Variant.(unsafe %n.(godot.payload(inst)).%sd))
				}, fn(%{..params}) {
					unsafe %n.(godot.payload(inst)).%edit(fn(mut x: %n) () { x.%sd = godot.arg[%st](args, 0) })
				}, true, %{..hint})`
			}
		}

		# Godot names the class bare, while a submodule keys it as `module::Name`.
		path := name.split("::")
		class_name := path[path.len() - 1]

		# the first paragraph is the brief
		paras := doc(input).split("\n\n")
		brief := paras[0]
		rest := paras[1..].join("\n\n")
		head := """<class name="{class_name}" inherits="{parent}"><brief_description>{brief}</brief_description>"""
		head += "<description>{rest}</description><members>{members}</members>"

		`@class %input
		## The class's doc XML up to its methods, which the fill's `_help` appends.
		%xml :: fn() string do %head

		%n :< {
			## Run `f` on the payload in place, since a view field write as a fn tail yields the field.
			%edit :: fn(mut self; f: fn(mut x: %n)) { f(mut self) }
		}

		## A copy of the payload behind a class arg.
		%n : From[godot.Variant] < { from :: fn(v: godot.Variant) %n do unsafe %n.(godot.payload(godot.instance(v))) }
		%on :: fn(inst: ptr) {
			%{..ons}
		}

		%reg :: fn(virtuals: []godot.Method, methods: []godot.Method, signals: []godot.Sig) {
			godot.gd.register(%class_name, %parent, %n.size, virtuals, methods, [%{..props}], signals, fn(%{params[0]}) {
				p := godot.payload(inst)
				unsafe p.write(%n.{})
				unsafe %n.(p).%edit(fn(mut x: %n) () { x.object = godot.object(inst) })
			}, %on, fn(%{params[0]}) {
				p := godot.payload(inst)
				# the parent handle is borrowed, so a RefCounted one must not unreference itself mid-free
				unsafe %n.(p).%edit(fn(mut x: %n) () { x.object = ptr.(0) })
				godot.dispose(unsafe %n.(p))
			})
		}`
	} else {
		cls := ident("{name}_class")
		reg := ident("{name}_register")
		on := ident("{name}_onready")
		xml := ident("{name}_xml")
		help := ident("{name}_help")
		mdocs := ""
		sdocs := ""
		fields := def(n).items
		up := parent_of(fields)
		wired := false
		loop f in fields {
			if noted(f, "onready") do wired = true
		}
		virtuals: []Ast
		methods: []Ast
		signals: []Ast
		done: []string
		has_ready := false
		loop it in items {
			if noted(it, "hidden") do continue
			fname := it.name.str()
			if noted(it, "signal") {
				sslots := loop j in 1..it.items.len() {
					a := it.items[j]
					aname := a.name.str()
					ty := parse("." + vtype(a.typ))
					`godot.slot(%aname, %ty)`
				}
				signals << `godot.sig(%fname, [%{..sslots}])`
				ps := params_xml(it)
				sd := doc(it)
				sdocs += """<signal name="{fname}">{ps}<description>{sd}</description></signal>"""
				continue
			}
			virtual := !noted(it, "func")
			vname := "_" + fname
			h := virtual_hash(up, vname)

			m := ident(fname)
			slots: []Ast
			pre: []Ast
			argv: []Ast
			if virtual {
				if h < 0 do reject(name, fname, up)
				if fname != "ready" && fname != "process" && fname != "physics_process" do unsupported(name, fname)
				if fname == "ready" {
					has_ready = true
					if wired do pre << `%on(inst)`
				} else {
					slots << `godot.slot("delta", .float)`
					argv << `godot.arg[f64](args, 0)`
				}
				done << vname
			} else {
				loop j in 1..it.items.len() {
					a := it.items[j]
					aname := a.name.str()
					i := j - 1
					at := a.typ
					ty := parse("." + vtype(at))
					argv << `godot.arg[%at](args, %i)`
					slots << `godot.slot(%aname, %ty)`
				}
			}

			call := `unsafe %n.(godot.payload(inst)).%m(%{..argv})`
			void := it.typ.kind == "tuple"
			body := if void do call else do `godot.ret(ret, godot.Variant.(%call))`
			cb := `fn(%{..params}) {
				%{..pre}
				%body
			}`
			if virtual {
				virtuals << `godot.virtual(%vname, %cb, [%{..slots}], none, %h)`
			} else {
				rt := if void do `none` else do parse("." + vtype(it.typ))
				methods << `godot.method(%fname, %cb, [%{..slots}], %rt)`
				gt := if void do "void" else do gtype(it.typ)
				ps := params_xml(it)
				md := doc(it)
				mdocs += """<method name="{fname}"><return type="{gt}" />{ps}<description>{md}</description></method>"""
			}
		}
		rh := virtual_hash(up, "_ready")
		if wired && !has_ready && rh >= 0 {
			done << "_ready"
			virtuals << `godot.virtual("_ready", fn(%{..params}) { %on(inst) }, [], none, %rh)`
		}
		require_all(name, up, done)

		tail := "<methods>{mdocs}</methods><signals>{sdocs}</signals></class>"

		`%input
		%cls :: fn() {
			%reg([%{..virtuals}], [%{..methods}], [%{..signals}])
		}
		%help :: fn() {
			godot.help(%xml() + %tail)
		}`
	}
}

pub init! :: fn() Ast {
	calls := loop c in defs(class) do `%{ident(c.name.str() + "_class")}()`
	helps := loop c in defs(class) do `%{ident(c.name.str() + "_help")}()`

	`@core.export.{"godot_oi_init"}
	godot_oi_init :: fn(get_proc: godot.GetProc, library: ptr, out: ptr) bool {
		godot.setup(get_proc, library, out, godot_oi_initialize, godot_oi_deinitialize)
	}

	godot_oi_initialize :: fn(userdata: ptr, level: i32) {
		if godot.level(level) == .scene {
			%{..calls}
		}
		if godot.level(level) == .editor {
			%{..helps}
		}
	}

	godot_oi_deinitialize :: fn(userdata: ptr, level: i32) {
		if godot.level(level) == .scene {
			godot.gd.unregister_all()
		}
	}`
}

## Marks a struct `class!` registered, for `init!` to find.
pub class :: ()
pub func :: ()
pub signal :: ()

## Marks a fn in a fill as a private helper: neither a virtual nor a method.
pub hidden :: ()

## A `PropertyHint` and its string (`.{ .range, "0,10,0.5" }`), on the field or, on an embedded struct, its own `field`.
pub export :: struct { hint: PropertyHint, hint_string: string, field: string }

## Marks a field as a scene-relative node path, resolved by `get_node`.
pub onready :: struct { path: string }

## The `Type` variant a field boxes as, `object` for any class.
## `f64` -> `float`, `godot.PackedInt32Array` -> `packed_int32_array`, `[]string` -> `packed_string_array`
pub vtype :: fn(t: Ast) out: string {
	if t.kind.str() == "array" && t.typ.str() == "string" do return "packed_string_array"
	s := t.str()
	if s == "float" || s == "f64" || s == "f32" do return "float"
	if s in [ "int", "i64", "i32", "i16", "i8", "u64", "u32", "u16", "u8" ] do return "int"
	parts := s.split(".")
	n := parts[parts.len() - 1]
	if n == "Variant" do return "nil"
	low := fn(j: int) bool { j < n.len() && n[j] >= 'a' && n[j] <= 'z' }
	loop i in ..n.len() {
		up := n[i] >= 'A' && n[i] <= 'Z'
		if i > 0 && up && (low(i - 1) || low(i + 1)) do out += "_"
		out += n[i..i + 1].lower()
	}
	known := def(Type).items.any { $.str() == out }
	if known do out else do "object"
}

## The type name a field or arg shows in the editor help.
## `f64` -> `float`, `[]string` -> `PackedStringArray`, `gd.Sprite2D` -> `Sprite2D`
pub gtype :: fn(t: Ast) string {
	v := vtype(t)
	if v in [ "int", "float", "bool" ] do return v
	if v == "packed_string_array" do return "PackedStringArray"
	if v == "string" do return "String"
	leaf(t.str())
}

## An item's `##` markdown as editor help BBCode, escaped for the XML, like gdext's.
pub doc :: fn(item: Ast) string {
	paras: []string = []
	cur := ""
	fence := false

	loop line in item.doc.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").split("\n") {
		t := line.trim()
		mark := t.starts_with("```")
		if fence && !mark {
			cur += "\n" + line
		} else if fence || mark || t == "" || t.starts_with("# ") {
			if fence do paras << "[codeblock]{cur}\n[/codeblock]" else if cur != "" do paras << spans(cur.trim())
			if t.starts_with("# ") do paras << "[b]{spans(t[2..])}[/b]"
			cur = ""
			fence = !fence && mark
		} else if t.starts_with("- ") || t.starts_with("* ") {
			cur += "\n• " + t[2..]
		} else {
			cur += " " + t
		}
	}

	if cur != "" do paras << spans(cur.trim())
	paras.join("\n\n")
}

## `code`, and outside it [text](url), **bold**, and *italic*. A bare `[Node]` is already a class link.
spans :: fn(s: string) string {
	tag(s, "`", "code", fn(text: string) string { tag(tag(links(text), "**", "b"), "*", "i") })
}

## Every other `mark`-delimited run as `[name]run[/name]`, the rest through `rest`. An unpaired mark stays text.
tag :: fn(s, mark, name: string, rest: fn(string) string = fn(s: string) string { s }) out: string {
	parts := s.split(mark)
	if parts.len() % 2 == 0 do return rest(s)
	loop part, i in parts do out += if i % 2 == 1 do "[{name}]{part}[/{name}]" else do rest(part)
	return
}

links :: fn(s: string) out: string {
	loop part, i in s.split("[") {
		link := part.split("](")
		url := link[1..].join("](").split(")")
		rest := url[1..].join(")")
		out += if i == 0 do part else if url.len() < 2 do "[" + part else do "[url={url[0]}]{link[0]}[/url]{rest}"
	}
	return
}

## The `<param>` entries of a method or signal, skipping `self`.
pub params_xml :: fn(f: Ast) out: string {
	loop j in 1..f.items.len() {
		a := f.items[j]
		name := a.name.str()
		ty := gtype(a.typ)
		out += """<param index="{j - 1}" name="{name}" type="{ty}" />"""
	}
	return
}

## The last segment of a path, `gd.export` -> `export`.
pub leaf :: fn(s: string) string {
	parts := s.split(".")
	parts[parts.len() - 1]
}

pub noted :: fn(item: Ast, name: string) bool {
	loop a in item.notes {
		if leaf(a.name.str()) == name do return true
	}
	false
}

## The entries of an item's `@godot.<name>.{ .. }` note.
pub note :: fn(item: Ast, name: string) []Ast {
	loop a in item.notes {
		if leaf(a.name.str()) == name && a.kind.str() == "structlit" {
			return a.items
		}
	}
	[]
}

## The parent class a struct's first field embeds, bare or module-qualified.
pub parent_of :: fn(fields: []Ast) string {
	if fields.len() == 0 || fields[0].typ.kind.str() != "ident" do return ""
	name := fields[0].name.str()
	if leaf(fields[0].typ.str()) == name do return name
	""
}

## `godot/api_index.json`, parsed once into plain structs
index :: comp load_index()

load_index :: fn() out: []Entry {
	dir := fs.Path.(src!().file).parent() or do fs.Path.(".")
	path := dir / "api_index.json"
	src := fs.read(path) or {
		panic!("godot: cannot read {path}, run `just api`")
	}
	parsed :: json.parse(src) or {
		panic!("godot: {path}: {$.message()}")
	}
	root: json.Obj = match v := parsed {
		is json.Obj => v,
		_ => []
	}
	loop c in root.keys {
		e := json.from_json[Entry](root[c]) or panic!("godot: api_index.json {c}: {$.message()}")
		e.name = c
		out << e
	}
	return
}

## A class's `api_index.json` entry, keyed by `name`.
Entry :: struct { pub name: string = "", pub parent: string, pub virtuals: []Virtual }
Virtual :: struct { pub name: string, pub hash: int, pub required: bool }

## Every virtual class and its ancestors declare, nearest first.
inherited :: fn(class: string) out: []Virtual {
	c := class
	loop c != "" {
		next := ""
		loop e in index {
			if e.name == c {
				out << e.virtuals
				next = e.parent
				break
			}
		}
		c = next
	}
	return
}

## The signature hash of virtual name on class or an ancestor.
pub virtual_hash :: fn(class: string, name: string) int {
	loop v in inherited(class) {
		if v.name == name do return v.hash
	}
	return -1
}

## Fail the build: `fname` names no virtual on `parent`'s chain.
pub reject :: fn(class: string, fname: string, parent: string) {
	if parent == "" {
		panic!("godot: {class} fill has no `@godot.class!` struct before it, cannot check its virtuals")
	}
	panic!("godot: {class}.{fname} is not a virtual of {parent} or its ancestors")
}

## @godot.class! has no shape for `fname` yet.
pub unsupported :: fn(class: string, fname: string) {
	panic!("godot: {class}.{fname} is a virtual class! cannot marshal yet, only ready/process/physics_process")
}

## Fail the build when an ancestor of `class` marks a virtual required that `have` does not list.
pub require_all :: fn(class: string, parent: string, have: []string) {
	loop v in inherited(parent) {
		if v.required && !(v.name in have) {
			panic!("godot: {class} must implement {v.name}, {parent} requires it")
		}
	}
}
