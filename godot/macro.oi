module godot

pub class! :: fn(input: Ast) Ast {
	n := input.name
	name := n.str()
	items := input.items
	params := [`inst: ptr`, `args: ptr`, `ret: ptr`]

	parent := parent_of(items)
	if parent != "" {
		reg := ident(name + "_register")
		on := ident(name + "_onready")
		x := ident("x")
		v := ident("v")
		props: []Ast
		ons: []Ast

		loop f in items {
			fd := f.name
			fname := fd.str()
			put := parse("x.{fname} = v")
			ty := f.typ
			path := ""
			loop a in f.notes {
				path = match a {
					`godot.onready.{ %p }` => p.str(),
					_ => path
				}
			}
			if path != "" {
				ons << `{
					%v := %ty.from_ptr(godot.node_at(inst, %path))
					%put
				}`
			}
			if !noted(f, "export") do continue

			t := parse("." + vtype(ty))
			range := ""
			loop a in f.notes {
				range = match a {
					`godot.export.{ range = %r }` => r.str(),
					_ => range
				}
			}

			hint := if range == "" do `.nil` else do `.range`
			props << `godot.property(%fname, %t, fn(%{..params}) {
				%x := %n.from_payload(inst)
				godot.ret(ret, godot.Variant.(%x.%fd))
			}, fn(%{..params}) {
				%x := %n.from_payload(inst)
				%v := godot.arg[%ty](args, 0)
				%put
				unsafe godot.payload(inst).write(%x)
			}, true, %hint, %range)`
		}

		`@c @class %input
		%n :< {
			pub from_payload :: fn(inst: ptr) %n {
				unsafe godot.payload(inst).read[Self]()
			}
		}
		%on :: fn(inst: ptr) {
			%x := %n.from_payload(inst)
			%{..ons}
			unsafe godot.payload(inst).write(%x)
		}
		%reg :: fn(virtuals: []godot.Method, methods: []godot.Method, signals: []godot.Sig) {
			godot.gd.register(%name, %parent, %n.size, virtuals, methods, [%{..props}], signals, fn(%{params[0]}) {
				p := godot.payload(inst)
				unsafe p.write(%n.{})
				unsafe p.write(godot.object(inst))
			}, %on)
		}`
	} else {
		cls := ident(name + "_class")
		reg := ident(name + "_register")
		rd := ident(name + ".from_payload")
		on := ident(name + "_onready")
		x := ident("x")
		fields := def(n).items
		up := parent_of(fields)
		wired := false
		loop f in fields {
			if noted(f, "onready") do wired = true
		}
		virtuals: []Ast
		methods: []Ast
		signals: []Ast
		done: []string
		has_ready := false
		loop it in items {
			if noted(it, "hidden") do continue
			fname := it.name.str()
			if noted(it, "signal") {
				sslots := loop j in 1..it.items.len() {
					a := it.items[j]
					aname := a.name.str()
					ty := match kind(a.typ) {
						"float" => `.float`,
						"int" => `.int`,
						_ => `.bool`
					}
					`godot.slot(%aname, %ty)`
				}
				signals << `godot.sig(%fname, [%{..sslots}])`
				continue
			}
			virtual := !noted(it, "func")
			vname := "_" + fname
			h := virtual_hash(up, vname)

			m := ident(fname)
			slots: []Ast
			pre: []Ast
			argv: []Ast
			if virtual {
				if h < 0 do reject(name, fname, up)
				if fname != "ready" && fname != "process" && fname != "physics_process" do unsupported(name, fname)
				if fname == "ready" {
					has_ready = true
					if wired do pre << `%on(inst)`
				} else {
					slots << `godot.slot("delta", .float)`
					argv << `godot.arg[f64](args, 0)`
				}
				done << vname
			} else {
				loop j in 1..it.items.len() {
					a := it.items[j]
					aname := a.name.str()
					i := j - 1
					k := kind(a.typ)
					ty := match k {
						"float" => `.float`,
						"int" => `.int`,
						_ => `.bool`
					}
					g := ident(match k { "float" => "f64", "int" => "i64", _ => "bool" })
					argv << `godot.arg[%g](args, %i)`
					slots << `godot.slot(%aname, %ty)`
				}
			}

			call := `%x.%m(%{..argv})`
			k := kind(it.typ)
			body := if k == "" do call else do `godot.ret(ret, godot.Variant.(%call))`
			cb := `fn(%{..params}) {
				%{..pre}
				%x := %rd(inst)
				%body
				unsafe godot.payload(inst).write(%x)
			}`
			if virtual {
				virtuals << `godot.virtual(%vname, %cb, [%{..slots}], none, %h)`
			} else {
				rt := match k {
					"float" => `.float`,
					"int" => `.int`,
					"bool" => `.bool`,
					_ => `none`
				}
				methods << `godot.method(%fname, %cb, [%{..slots}], %rt)`
			}
		}
		rh := virtual_hash(up, "_ready")
		if wired && !has_ready && rh >= 0 {
			done << "_ready"
			virtuals << `godot.virtual("_ready", fn(%{..params}) { %on(inst) }, [], none, %rh)`
		}
		require_all(name, up, done)

		`%input
		%cls :: fn() {
			%reg([%{..virtuals}], [%{..methods}], [%{..signals}])
		}`
	}
}

pub init! :: fn() Ast {
	calls := loop c in defs(class) do `%{ident(c.name.str() + "_class")}()`

	`@export.{"godot_oi_init"}
	godot_oi_init :: fn(get_proc: godot.GetProc, library: ptr, out: ptr) bool {
		godot.setup(get_proc, library, out, godot_oi_initialize, godot_oi_deinitialize)
	}

	godot_oi_initialize :: fn(userdata: ptr, level: i32) {
		if godot.level(level) == .scene {
			%{..calls}
		}
	}

	godot_oi_deinitialize :: fn(userdata: ptr, level: i32) {
		if godot.level(level) == .scene {
			godot.gd.unregister_all()
		}
	}`
}
