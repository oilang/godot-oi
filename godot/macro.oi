module godot

pub class! :: fn(input: Ast) Ast {
	n := input.name
	name := n.str()
	items := input.items
	params := [`inst: ptr`, `args: ptr`, `ret: ptr`]

	parent := parent_of(items)
	if parent != "" {
		reg := ident(name + "_register")
		on := ident(name + "_onready")
		edit := gensym("edit")
		xml := ident("{name}_xml")
		props: []Ast
		members := ""
		ons: []Ast

		loop f in items {
			fd := f.name
			ty := f.typ
			path := ""
			loop p in note(f, "onready") {
				path = p.str()
			}
			if path != "" {
				ons << `unsafe %n.(godot.payload(inst)).%edit(fn(mut x: %n) () {
					x.%fd = %ty.from_ptr(godot.node_at(inst, %path))
				})`
			}
			if !noted(f, "export") do continue

			# an exported embed, like the parent class, exports its promoted fields
			embed := ty.kind.str() == "ident" && leaf(ty.str()) == fd.str()
			loop sub in if embed do def(ty).items else do [f] {
				sd := sub.name
				sname := sd.str()
				st := sub.typ
				t := parse("." + vtype(st))
				hint := note(sub, "export")

				# an embed hints its own fields by name, `game.Level @gd.export.{ .file, "*.tscn", field = "scene" }`
				if embed do loop a in f.notes {
					field := """field = "{sname}\""""
					lit := leaf(a.name.str()) == "export" && a.kind.str() == "structlit"
					named := lit && a.items.any { $.str() == field }
					if named do hint = a.items.filter { $.str() != field }
				}
				c := if st.kind.str() == "array" do "" else do leaf(st.str())

				# only Node declares `_ready` and only Resource `_setup_local_to_scene`
				if hint.len() == 0 && virtual_hash(c, "_ready") >= 0 do hint = [`.node_type`, `%c`]
				if hint.len() == 0 && virtual_hash(c, "_setup_local_to_scene") >= 0 do hint = [`.resource_type`, `%c`]

				gt := gtype(st)
				sdoc := doc(sub)
				members += """<member name="{sname}" type="{gt}" setter="set_{sname}" getter="get_{sname}">{sdoc}</member>"""

				props << `godot.property(%sname, %t, fn(%{..params}) {
					godot.ret(ret, godot.Variant.(unsafe %n.(godot.payload(inst)).%sd))
				}, fn(%{..params}) {
					unsafe %n.(godot.payload(inst)).%edit(fn(mut x: %n) () { x.%sd = godot.arg[%st](args, 0) })
				}, true, %{..hint})`
			}
		}

		# Godot names the class bare, while a submodule keys it as `module::Name`.
		path := name.split("::")
		class_name := path[path.len() - 1]

		# the first paragraph is the brief
		paras := doc(input).split("\n\n")
		brief := paras[0]
		rest := paras[1..].join("\n\n")
		head := """<class name="{class_name}" inherits="{parent}"><brief_description>{brief}</brief_description>"""
		head += "<description>{rest}</description><members>{members}</members>"

		`@class %input
		## The class's doc XML up to its methods, which the fill's `_help` appends.
		%xml :: fn() string do %head

		%n :< {
			## Run `f` on the payload in place, since a view field write as a fn tail yields the field.
			%edit :: fn(mut self; f: fn(mut x: %n)) { f(mut self) }
		}

		## A copy of the payload behind a class arg.
		%n : From[godot.Variant] < { from :: fn(v: godot.Variant) %n do unsafe %n.(godot.payload(godot.instance(v))) }
		%on :: fn(inst: ptr) {
			%{..ons}
		}

		%reg :: fn(virtuals: []godot.Method, methods: []godot.Method, signals: []godot.Sig) {
			godot.gd.register(%class_name, %parent, %n.size, virtuals, methods, [%{..props}], signals, fn(%{params[0]}) {
				p := godot.payload(inst)
				unsafe p.write(%n.{})
				unsafe %n.(p).%edit(fn(mut x: %n) () { x.object = godot.object(inst) })
			}, %on, fn(%{params[0]}) {
				p := godot.payload(inst)
				# the parent handle is borrowed, so a RefCounted one must not unreference itself mid-free
				unsafe %n.(p).%edit(fn(mut x: %n) () { x.object = ptr.(0) })
				godot.dispose(unsafe %n.(p))
			})
		}`
	} else {
		cls := ident("{name}_class")
		reg := ident("{name}_register")
		on := ident("{name}_onready")
		xml := ident("{name}_xml")
		help := ident("{name}_help")
		mdocs := ""
		sdocs := ""
		fields := def(n).items
		up := parent_of(fields)
		wired := false
		loop f in fields {
			if noted(f, "onready") do wired = true
		}
		virtuals: []Ast
		methods: []Ast
		signals: []Ast
		done: []string
		has_ready := false
		loop it in items {
			if noted(it, "hidden") do continue
			fname := it.name.str()
			if noted(it, "signal") {
				sslots := loop j in 1..it.items.len() {
					a := it.items[j]
					aname := a.name.str()
					ty := parse("." + vtype(a.typ))
					`godot.slot(%aname, %ty)`
				}
				signals << `godot.sig(%fname, [%{..sslots}])`
				ps := params_xml(it)
				sd := doc(it)
				sdocs += """<signal name="{fname}">{ps}<description>{sd}</description></signal>"""
				continue
			}
			virtual := !noted(it, "func")
			vname := "_" + fname
			h := virtual_hash(up, vname)

			m := ident(fname)
			slots: []Ast
			pre: []Ast
			argv: []Ast
			if virtual {
				if h < 0 do reject(name, fname, up)
				if fname != "ready" && fname != "process" && fname != "physics_process" do unsupported(name, fname)
				if fname == "ready" {
					has_ready = true
					if wired do pre << `%on(inst)`
				} else {
					slots << `godot.slot("delta", .float)`
					argv << `godot.arg[f64](args, 0)`
				}
				done << vname
			} else {
				loop j in 1..it.items.len() {
					a := it.items[j]
					aname := a.name.str()
					i := j - 1
					at := a.typ
					ty := parse("." + vtype(at))
					argv << `godot.arg[%at](args, %i)`
					slots << `godot.slot(%aname, %ty)`
				}
			}

			call := `unsafe %n.(godot.payload(inst)).%m(%{..argv})`
			void := it.typ.kind == "tuple"
			body := if void do call else do `godot.ret(ret, godot.Variant.(%call))`
			cb := `fn(%{..params}) {
				%{..pre}
				%body
			}`
			if virtual {
				virtuals << `godot.virtual(%vname, %cb, [%{..slots}], none, %h)`
			} else {
				rt := if void do `none` else do parse("." + vtype(it.typ))
				methods << `godot.method(%fname, %cb, [%{..slots}], %rt)`
				gt := if void do "void" else do gtype(it.typ)
				ps := params_xml(it)
				md := doc(it)
				mdocs += """<method name="{fname}"><return type="{gt}" />{ps}<description>{md}</description></method>"""
			}
		}
		rh := virtual_hash(up, "_ready")
		if wired && !has_ready && rh >= 0 {
			done << "_ready"
			virtuals << `godot.virtual("_ready", fn(%{..params}) { %on(inst) }, [], none, %rh)`
		}
		require_all(name, up, done)

		tail := "<methods>{mdocs}</methods><signals>{sdocs}</signals></class>"

		`%input
		%cls :: fn() {
			%reg([%{..virtuals}], [%{..methods}], [%{..signals}])
		}
		%help :: fn() {
			godot.help(%xml() + %tail)
		}`
	}
}

pub init! :: fn() Ast {
	calls := loop c in defs(class) do `%{ident(c.name.str() + "_class")}()`
	helps := loop c in defs(class) do `%{ident(c.name.str() + "_help")}()`

	`@export.{"godot_oi_init"}
	godot_oi_init :: fn(get_proc: godot.GetProc, library: ptr, out: ptr) bool {
		godot.setup(get_proc, library, out, godot_oi_initialize, godot_oi_deinitialize)
	}

	godot_oi_initialize :: fn(userdata: ptr, level: i32) {
		if godot.level(level) == .scene {
			godot.check_sizes()
			%{..calls}
		}
		if godot.level(level) == .editor {
			%{..helps}
		}
	}

	godot_oi_deinitialize :: fn(userdata: ptr, level: i32) {
		if godot.level(level) == .scene {
			godot.gd.unregister_all()
		}
	}`
}
