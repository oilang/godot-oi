use godot
use godot.{ String, NodePath, StringName, Vector2, Vector2i, Transform2D, Color, Array, PackedInt32Array, Variant, Node, Node2D }

godot.init!()

@godot.class!
OiNode :: struct {
	Node,
	frames: u64,
	speed: f64 = 1.0 @godot.export.{ range = "0,10,0.5" },
}

@godot.class!
OiNode :< {
	ready :: fn(mut self) {
		gd := godot.gd
		v := gd.version()
		status := unsafe v.status.str()
		print("oi: hello from Godot {v.major}.{v.minor}.{v.patch} {status}")
		print("oi: ready")

		v := gd.variant()
		v.set_int(42)
		i := v.int()
		v.set_float(2.5)
		f := v.float()
		v.set_bool(true)
		b := v.bool()
		v.set_string("hi")
		s := v.string()
		t := v.type()
		v.drop()
		print("oi: variant {i} {f} {b} {s} {t}")

		name := gd.call(self.object, gd.bind(0, "Object", "get_class", 201670096), [])
		class := name.string()
		name.drop()
		print("oi: class {class}")

		hi: String = "hi there"
		same := hi == String.("hi there")
		path: NodePath = "Player/Sprite"
		sn: StringName = "ready"
		print("oi: string {hi} {same} {path} {sn}")

		z := Vector2.ZERO
		w := Color.WHITE
		print("oi: const {z.x} {z.y} {w.r} {w.g} {w.b} {w.a}")
		print("oi: enum alias {godot.InlineAlignment.top() == godot.InlineAlignment.to_top()}")

		p := Vector2.{ 1.0, 2.0 }
		q := Vector2.{ 3.0, 4.0 }
		sum := p + q
		neg := -(p - q)
		scaled := sum * Vector2.{ 2.0, 2.0 } / Vector2.{ 4.0, 4.0 }
		two: f32 = 2.0
		dbl := p * two
		half := q / two
		sumi := Vector2i.{ 1, 2 } + Vector2i.{ 3, 4 }
		tint := Color.{ 1.0, 0.5, 0.25, 1.0 } - Color.{ 0.5, 0.25, 0.0, 0.5 }
		print("oi: math {sum.x} {sum.y} {neg.y} {scaled.x} {sumi.x} {sumi.y} {tint.r} {tint.g} {dbl.y} {half.x}")

		mixed := Vector2i.{ 1, 2 } * 2.5
		moved := Transform2D.{ Vector2.{ 2.0, 0.0 }, Vector2.{ 0.0, 2.0 }, Vector2.{ 1.0, 1.0 } } * p
		print("oi: ops {mixed.y} {moved.x} {moved.y}")

		up := hi.to_upper()
		v2 := Vector2.{ 3.0, 4.0 }
		list := Array.new()
		seven := Variant.(7)
		list.push_back(seven)
		seven.drop()
		print("oi: builtin {hi.length()} {up} {v2.length()} {list.size()}")

		ints: PackedInt32Array = .[1 2 3]
		total: i64 = 0
		loop x in ints do total += x
		print("oi: packed {total} {2 in ints} {ints[1]} {ints.len()}")

		godot.printl("oi: utility print")
		godot.warn("oi: warn")
		print("oi: utility {godot.deg_to_rad(180.0)} {godot.type_string(2)}")

		o := godot.Object.from_ptr(self.object)
		o.add_user_signal("boom")
		boom := o.has_signal("boom")
		print("oi: default {boom}")

		json := godot.JSON.new()
		good := json.parse("[1]") and "ok" or "bad"
		json.parse("[") or { print("oi: error {good} {$.message()}") }

		query := godot.NavigationPathQueryParameters2D.new()
		all := query.get_metadata_flags()
		query.set_metadata_flags(.[.types .owners])
		got := query.get_metadata_flags()
		print("oi: bits {.rids in all} {got} {got.mask()} {(all - got).mask()}")
		print("oi: hidden {self.tag()}")
	}

	@godot.hidden
	tag :: fn(self) string { "helper" }

	process :: fn(mut self; delta: f64) {
		if self.frames == 0 {
			print("oi: process {delta}")
		}
		self.frames += 1
	}

	@godot.func
	hello :: fn(self) {
		print("oi: hello")
	}

	@godot.func
	add :: fn(self; a, b: i64) i64 { a + b }

	@godot.func
	add4 :: fn(self; a, b, c, d: i64) i64 { a + b + c + d }
}
