gd :: use godot

## Per-instance state.
@c State :: struct { frames: u64, speed: f64 }

@export.{"godot_oi_init"}
init :: fn(get_proc: godot.GetProc, library: ptr, out: ptr) bool {
	godot.setup(get_proc, library, out, initialize, deinitialize)
}

@c initialize :: fn(userdata: ptr, level: i32) {
	if godot.level(level) == .scene {
		gd := godot.of(userdata)
		v := gd.version()
		status := unsafe v.status.str()
		print("oi: hello from Godot {v.major}.{v.minor}.{v.patch} {status}")
		speed := gd.variant()
		speed.set_float(1.0)
		gd.register(
			"OiNode",
			"Node",
			State.size,
			[godot.ready(ready), godot.process(process)],
			[godot.method("hello", hello, [], none), godot.method("add", add, [godot.slot("a", .int), godot.slot("b", .int)], .int)],
			[godot.property("speed", .float, get_speed, set_speed, true, .range, "0,10,0.5", speed)],
		)
		gd.register("OiNode2D", "Node2D", 0, [godot.ready(ready2d)], [], [])
	}
}

@c deinitialize :: fn(userdata: ptr, level: i32) {
	if godot.level(level) == .scene {
		godot.of(userdata).unregister_all()
		print("oi: bye")
	}
}

@c ready :: fn(inst: ptr) {
	print("oi: ready")
	gd := godot.gd
	v := gd.variant()
	v.set_int(42)
	i := v.int()
	v.set_float(2.5)
	f := v.float()
	v.set_bool(true)
	b := v.bool()
	v.set_string("hi")
	s := v.string()
	t := v.type()
	v.drop()
	print("oi: variant {i} {f} {b} {s} {t}")
	name := gd.call(godot.object(inst), gd.bind(0, "Object", "get_class", 201670096), [])
	class := name.string()
	name.drop()
	print("oi: class {class}")
	hi := gd.String.("hi there")
	same := hi == gd.String.("hi there")
	path := gd.NodePath.("Player/Sprite")
	sn := gd.StringName.("ready")
	print("oi: string {hi} {same} {path} {sn}")
	z := gd.Vector2.ZERO
	w := gd.Color.WHITE
	print("oi: const {z.x} {z.y} {w.r} {w.g} {w.b} {w.a}")
	up := hi.to_upper()
	v2 := gd.Vector2.{ 3.0, 4.0 }
	list := gd.Array.new()
	seven := gd.int(7)
	list.push_back(seven)
	seven.drop()
	print("oi: builtin {hi.length()} {up} {v2.length()} {list.size()}")
	hello := gd.string("oi: utility print")
	godot.print([ hello ])
	hello.drop()
	print("oi: utility {godot.deg_to_rad(180.0)} {godot.type_string(2)}")
}

@c ready2d :: fn(inst: ptr) {
	print("oi: ready 2d")
	o := godot.Object.from_ptr(godot.object(inst))
	n := gd.Node2D.from_ptr(o.object)
	v := gd.Vector2.{ 1.0, 2.0 }
	n.set_position(v)
	p := n.get_position()
	print("oi: position {p.x} {p.y}")
	print("oi: physics ticks {godot.Engine.singleton().get_physics_ticks_per_second()}")
	same := o.is_a("Node2D")
	yes := gd.Node2D.cast(o) != none
	no := godot.Node3D.cast(o) == none
	static := godot.PortableCompressedTexture2D.is_keeping_all_compressed_buffers()
	print("oi: is_a {same} cast {yes} {no} static {static}")
	kid := godot.Node.new()
	n.add_child(kid)
	print("oi: children {n.get_child_count()}")
	pt := gd.Vector2.{ 3.0, 4.0 }
	vv := gd.Variant.(pt)
	w := gd.Vector2.(vv)
	vo := gd.Variant.(n)
	back := gd.Node2D.(vo)
	print("oi: from {vv.type()} {w.x} {vo.type()} {back.get_child_count()}")
	vv.drop()
	vo.drop()
}

@c process :: fn(inst: ptr, delta: f64) {
	s := godot.state[State](inst)
	godot.set_state(inst, State.{ s.frames + 1, s.speed })
	if s.frames == 0 {
		print("oi: process {delta}")
	}
}

@c hello :: fn(inst: ptr, args: ptr, ret: ptr) {
	print("oi: hello")
}

@c add :: fn(inst: ptr, args: ptr, ret: ptr) {
	godot.ret(ret).set_int(godot.arg(args, 0).int() + godot.arg(args, 1).int())
}

@c get_speed :: fn(inst: ptr, args: ptr, ret: ptr) {
	godot.ret(ret).set_float(godot.state[State](inst).speed)
}

@c set_speed :: fn(inst: ptr, args: ptr, ret: ptr) {
	godot.set_state(inst, State.{
		godot.state[State](inst).frames,
		godot.arg(args, 0).float()
	})
}
