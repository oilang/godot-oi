use godot

## Per-instance state.
@c State :: struct { frames: u64, speed: f64 }

@export.{"godot_oi_init"}
init :: fn(get_proc: godot.GetProc, library: ptr, out: ptr) bool {
	godot.setup(get_proc, library, out, initialize, deinitialize)
}

@c initialize :: fn(userdata: ptr, level: i32) {
	if godot.level(level) == .scene {
		gd := godot.of(userdata)
		v := gd.version()
		status := unsafe v.status.str()
		print("oi: hello from Godot {v.major}.{v.minor}.{v.patch} {status}")
		speed := gd.variant()
		speed.set_float(gd, 1.0)
		gd.register(
			"OiNode",
			"Node",
			State.size,
			[godot.ready(ready), godot.process(process)],
			[godot.method("hello", hello, [], none), godot.method("add", add, [godot.slot("a", .int), godot.slot("b", .int)], .int)],
			[godot.property("speed", .float, get_speed, set_speed, true, .range, "0,10,0.5", speed)],
		)
		gd.register("OiNode2D", "Node2D", 0, [godot.ready(ready2d)], [], [])
	}
}

@c deinitialize :: fn(userdata: ptr, level: i32) {
	if godot.level(level) == .scene {
		godot.of(userdata).unregister_all()
		print("oi: bye")
	}
}

@c ready :: fn(inst: ptr) {
	print("oi: ready")
	gd := godot.of_inst(inst)
	v := gd.variant()
	v.set_int(gd, 42)
	i := v.int(gd)
	v.set_float(gd, 2.5)
	f := v.float(gd)
	v.set_bool(gd, true)
	b := v.bool(gd)
	v.set_string(gd, "hi")
	s := v.string(gd)
	t := v.type(gd)
	v.drop(gd)
	print("oi: variant {i} {f} {b} {s} {t}")
	name := gd.call(godot.object(inst), gd.bind(0, "Object", "get_class", 201670096), [])
	class := name.string(gd)
	name.drop(gd)
	print("oi: class {class}")
}

@c ready2d :: fn(inst: ptr) {
	print("oi: ready 2d")
}

@c process :: fn(inst: ptr, delta: f64) {
	s := godot.state[State](inst)
	godot.set_state(inst, State.{ s.frames + 1, s.speed })
	if s.frames == 0 { print("oi: process {delta}") }
}

@c hello :: fn(inst: ptr, args: ptr, ret: ptr) {
	print("oi: hello")
}

@c add :: fn(inst: ptr, args: ptr, ret: ptr) {
	gd := godot.of_inst(inst)
	godot.ret(ret).set_int(gd, godot.arg(args, 0).int(gd) + godot.arg(args, 1).int(gd))
}

@c get_speed :: fn(inst: ptr, args: ptr, ret: ptr) {
	godot.ret(ret).set_float(godot.of_inst(inst), godot.state[State](inst).speed)
}

@c set_speed :: fn(inst: ptr, args: ptr, ret: ptr) {
	godot.set_state(inst, State.{
		godot.state[State](inst).frames,
		godot.arg(args, 0).float(godot.of_inst(inst))
	})
}
