use godot

@export.{"godot_oi_init"}
init :: fn(get_proc: godot.GetProc, library: ptr, out: ptr) bool {
	godot.setup(get_proc, library, out, initialize, deinitialize)
}

@c initialize :: fn(userdata: ptr, level: i32) {
	if godot.level(level) == .scene {
		gd := godot.of(userdata)
		v := gd.version()
		status := unsafe v.status.str()
		print("oi: hello from Godot {v.major}.{v.minor}.{v.patch} {status}")
		gd.register("OiNode", "Node", [godot.ready(ready), godot.process(process)], [godot.method("hello", hello)])
		gd.register("OiNode2D", "Node2D", [godot.ready(ready2d)], [])
	}
}

@c deinitialize :: fn(userdata: ptr, level: i32) {
	if godot.level(level) == .scene {
		godot.of(userdata).unregister_all()
		print("oi: bye")
	}
}

@c ready :: fn(inst: ptr) {
	print("oi: ready")
}

@c ready2d :: fn(inst: ptr) {
	print("oi: ready 2d")
}

@c process :: fn(inst: ptr, delta: f64) {
	if unsafe inst.read[godot.Instance]().frames == 1 {
		print("oi: process {delta}")
	}
}

@c hello :: fn(inst: ptr) {
	print("oi: hello")
}
