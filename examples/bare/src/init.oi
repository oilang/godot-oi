use godot
use godot.{ String, NodePath, StringName, Vector2, Vector2i, Color, Array, Variant, Node, Node2D }

godot.init!([OiNode, OiNode2D])

@godot.class!
OiNode :: struct {
	Node,
	frames: u64,
	speed: f64 = 1.0 @godot.export.{ range = "0,10,0.5" },
}

@godot.class!
OiNode :< {
	ready :: fn(mut self) {
		gd := godot.gd
		v := gd.version()
		status := unsafe v.status.str()
		print("oi: hello from Godot {v.major}.{v.minor}.{v.patch} {status}")
		print("oi: ready")
		v := gd.variant()
		v.set_int(42)
		i := v.int()
		v.set_float(2.5)
		f := v.float()
		v.set_bool(true)
		b := v.bool()
		v.set_string("hi")
		s := v.string()
		t := v.type()
		v.drop()
		print("oi: variant {i} {f} {b} {s} {t}")
		name := gd.call(self.object, gd.bind(0, "Object", "get_class", 201670096), [])
		class := name.string()
		name.drop()
		print("oi: class {class}")
		hi := String.("hi there")
		same := hi == String.("hi there")
		path := NodePath.("Player/Sprite")
		sn := StringName.("ready")
		print("oi: string {hi} {same} {path} {sn}")
		z := Vector2.ZERO
		w := Color.WHITE
		print("oi: const {z.x} {z.y} {w.r} {w.g} {w.b} {w.a}")
		print("oi: enum alias {godot.InlineAlignment.top() == godot.InlineAlignment.to_top()}")
		p := Vector2.{ 1.0, 2.0 }
		q := Vector2.{ 3.0, 4.0 }
		sum := p + q
		neg := -(p - q)
		scaled := sum * Vector2.{ 2.0, 2.0 } / Vector2.{ 4.0, 4.0 }
		sumi := Vector2i.{ 1, 2 } + Vector2i.{ 3, 4 }
		tint := Color.{ 1.0, 0.5, 0.25, 1.0 } - Color.{ 0.5, 0.25, 0.0, 0.5 }
		print("oi: math {sum.x} {sum.y} {neg.y} {scaled.x} {sumi.x} {sumi.y} {tint.r} {tint.g}")
		up := hi.to_upper()
		v2 := Vector2.{ 3.0, 4.0 }
		list := Array.new()
		seven := gd.int(7)
		list.push_back(seven)
		seven.drop()
		print("oi: builtin {hi.length()} {up} {v2.length()} {list.size()}")
		godot.printl("oi: utility print")
		godot.warn("oi: warn")
		print("oi: utility {godot.deg_to_rad(180.0)} {godot.type_string(2)}")
		o := godot.Object.from_ptr(self.object)
		o.add_user_signal("boom")
		boom := o.has_signal("boom")
		print("oi: default {boom}")
		print("oi: hidden {self.tag()}")
	}

	@godot.hidden
	tag :: fn(self) string { "helper" }

	process :: fn(mut self, delta: f64) {
		if self.frames == 0 {
			print("oi: process {delta}")
		}
		self.frames += 1
	}

	@godot.func
	hello :: fn(self) {
		print("oi: hello")
	}

	@godot.func
	add :: fn(self, a: i64, b: i64) i64 { a + b }
}
