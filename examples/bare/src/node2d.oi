gd :: use godot

@gd.class!
OiNode2D :: struct {
	gd.Node2D,
	sprite: gd.Sprite2D @gd.onready.{ "../Sprite" },
	hp: i64 = 3 @gd.export @gd.group.{ "Combat" },
	aim: gd.Vector2 = gd.Vector2.{ 1.0, 2.0 } @gd.export,
	label: gd.String = "hi" @gd.export,
	loot: gd.Variant @gd.export,
	Stats @gd.export @gd.group.{ "Stats" },
}

@gd.constant.{ "OiNode2D", bitfield = true }
Layers :: enum { ground, air, water }

Stats :: struct { armor: i64 = 2, reach: float = 1.5 @gd.subgroup.{ "Range", "re" } }

@gd.class!
OiNode2D :< {
	ready :: fn(mut self) {
		print("oi: ready 2d")
		sp := self.sprite.get_position()
		print("oi: onready {self.sprite.get_name()} {sp.x} {sp.y}")
		o := gd.Object.from_ptr(self.object)
		v := gd.Vector2.{ 1.0, 2.0 }
		self.set_position(v)
		p := self.get_position()
		print("oi: position {p.x} {p.y}")
		print("oi: physics ticks {gd.Engine.singleton().get_physics_ticks_per_second()}")
		same := o.is_a("Node2D")
		yes := gd.Node2D.cast(o) != none
		no := gd.Node3D.cast(o) == none
		static := gd.PortableCompressedTexture2D.is_keeping_all_compressed_buffers()
		print("oi: is_a {same} cast {yes} {no} static {static}")
		entered := self.child_entered_tree()
		_ := entered.connect(gd.Callable.of(fn(args: []gd.Variant) {
			who := gd.Node.(args[0])
			print("oi: entered {who.get_name()}")
		}))
		kid := gd.Node.new()
		kid.set_name("Kid")
		self.add_child(kid)
		print("oi: children {self.get_child_count()}")
		pt := gd.Vector2.{ 3.0, 4.0 }
		vv := gd.Variant.(pt)
		w := gd.Vector2.(vv)
		vo := gd.Variant.(gd.Node2D.from_ptr(o.object))
		back := gd.Node2D.(vo)
		print("oi: from {vv.type()} {w.x} {vo.type()} {back.get_child_count()}")
		c := gd.Callable.create(gd.Variant.(o), "add")
		r := c.call(1, 2)
		b := c.bind(9)
		print("oi: callable {r.int()} {b.get_bound_arguments_count()}")

		# rc testing
		rc := gd.RefCounted.new()
		rc_before := rc.get_reference_count()
		rc_boxed := {
			_v := gd.Variant.(rc)
			rc.get_reference_count()
		}
		rc_after := rc.get_reference_count()
		print("oi: refcount variant {rc_before} {rc_boxed} {rc_after}")
		rc2 := gd.RefCounted.new()
		rc2_before := rc2.get_reference_count()
		raw := gd.Object.from_ptr(rc2.object)
		rc2_boxed := {
			_v := gd.Variant.(raw)
			rc2.get_reference_count()
		}
		rc2_after := rc2.get_reference_count()
		print("oi: refcount object {rc2_before} {rc2_boxed} {rc2_after}")
		ex := gd.Expression.new()
		print("oi: refcount new {ex.get_reference_count()}")
	}

	@gd.func
	add :: fn(self; a, b: i64) i64 { a + b }

	@gd.func
	doubled :: fn(self; v: gd.Vector2) gd.Vector2 { v + v }

	@gd.func
	greet :: fn(self; name: string) string do "hi {name}"

	@gd.func
	echo :: fn(self; v: gd.Variant) gd.Variant do v

	@gd.func
	shout :: fn(self; xs: []string) []string do loop x in xs do x + "!"

	@gd.func
	hp_of :: fn(self; other: OiNode2D) i64 do other.hp

	@gd.signal
	hit :: fn(self; damage: i64) {}

	notification :: fn(mut self; what: i64) {
		if what == 9001 do print("oi: notification {what}")
	}

	to_string :: fn(self) string do "OiNode2D hp {self.hp}"

	@gd.func
	fire :: fn(self; damage: i64) {
		o := gd.Object.from_ptr(self.object)
		known := o.has_signal("hit")
		print("oi: has_signal {known}")
		sg := gd.Signal.of(self.object, "hit")
		sg.emit(damage)
	}
}
