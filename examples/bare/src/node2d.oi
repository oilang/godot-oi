@godot.class!
OiNode2D :: struct {
	Node2D,
	sprite: godot.Sprite2D @godot.onready.{ "../Sprite" },
}

@godot.class!
OiNode2D :< {
	ready :: fn(mut self) {
		print("oi: ready 2d")
		sp := self.sprite.get_position()
		print("oi: onready {self.sprite.get_name()} {sp.x} {sp.y}")
		gd := godot.gd
		o := godot.Object.from_ptr(self.object)
		v := Vector2.{ 1.0, 2.0 }
		self.set_position(v)
		p := self.get_position()
		print("oi: position {p.x} {p.y}")
		print("oi: physics ticks {godot.Engine.singleton().get_physics_ticks_per_second()}")
		same := o.is_a("Node2D")
		yes := Node2D.cast(o) != none
		no := godot.Node3D.cast(o) == none
		static := godot.PortableCompressedTexture2D.is_keeping_all_compressed_buffers()
		print("oi: is_a {same} cast {yes} {no} static {static}")
		entered := self.child_entered_tree()
		_ := entered.connect(godot.Callable.of(fn(args: []Variant) {
			who := godot.Node.(args[0])
			print("oi: entered {who.get_name().str()}")
		}))
		kid := godot.Node.new()
		kid.set_name("Kid")
		self.add_child(kid)
		print("oi: children {self.get_child_count()}")
		pt := Vector2.{ 3.0, 4.0 }
		vv := Variant.(pt)
		w := Vector2.(vv)
		vo := Variant.(Node2D.from_ptr(o.object))
		back := Node2D.(vo)
		print("oi: from {vv.type()} {w.x} {vo.type()} {back.get_child_count()}")
		vv.drop()
		vo.drop()
		ov := Variant.(o)
		c := godot.Callable.create(ov, "add")
		ov.drop()
		one := gd.int(1)
		two := gd.int(2)
		nine := gd.int(9)
		r := c.call([one, two])
		b := c.bind([nine])
		print("oi: callable {r.int()} {b.get_bound_arguments_count()}")
		loop v in [one, two, nine, r] {
			v.drop()
		}

		# rc testing
		rc := godot.RefCounted.new()
		rc_before := rc.get_reference_count()
		vrc := Variant.(rc)
		rc_boxed := rc.get_reference_count()
		vrc.drop()
		rc_after := rc.get_reference_count()
		print("oi: refcount variant {rc_before} {rc_boxed} {rc_after}")
		rc2 := godot.RefCounted.new()
		rc2_before := rc2.get_reference_count()
		raw := godot.Object.from_ptr(rc2.object)
		vraw := Variant.(raw)
		rc2_boxed := rc2.get_reference_count()
		vraw.drop()
		rc2_after := rc2.get_reference_count()
		print("oi: refcount object {rc2_before} {rc2_boxed} {rc2_after}")
	}

	@godot.func
	add :: fn(self, a: i64, b: i64) i64 { a + b }

	@godot.signal
	hit :: fn(self, damage: i64) {}

	@godot.func
	fire :: fn(self, damage: i64) {
		o := godot.Object.from_ptr(self.object)
		v := godot.gd.int(damage)
		known := o.has_signal("hit")
		print("oi: has_signal {known}")
		sg := godot.Signal.of(self.object, "hit")
		sg.emit([v])
		v.drop()
	}
}
