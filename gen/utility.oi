module main

## Generate the `@GlobalScope` utility functions.

## A vararg utility fn.
## The ptr fn reads every cell as a `Variant`.
utility_vararg :: fn(fname: string, bind: string, rt: Typ) string {
	rptr, made, back := match rt.kind {
		"void" => ("ptr.(0)", "", ""),
		"variant" => ("rv.at", "rv := gd.variant()", "rv"),
		_ => ("out", "out := unsafe calloc(1, usize.({rt.size}))", "{rt.sig}.from_bytes(out)"),
	}

	lines := [
		"blk := unsafe malloc(ptr.size * usize.(varargs.len()))",
		"loop i in ..varargs.len() {{ unsafe ptr.(blk.0 + ptr.size * usize.(i)).write(varargs[i].at) }}",
	]
	if made != "" do lines << made
	lines << bind << "unsafe UtilityFunction.(mb)({rptr}, blk, i32.(varargs.len()))" << "unsafe free(blk)"
	if back != "" do lines << back

	"""
		pub {fname} :: fn(varargs: ..Variant){ret_sig(rt, false)} {{
			{lines.join(nl1)}
		}}
		"""
}

utility :: fn(api: Api) string {
	fns := loop f in api.utility_functions {
		g := sig(f) or {
			skipped += 1
			continue
		}
		bind := """mb := gd.ptr_bind({slot}, .nil, "{f.name}", {f.hash})"""
		slot += 1
		fname := safe(f.name, [])
		d := doc(f, "## ")

		if f.is_vararg {
			d + utility_vararg(fname, bind, g.rt)
		} else {
			lines := ptrcall_body(g.args, g.rt, g.ropt, Call.{ "utility", "", bind, "" })
			ps := params(g.args, "")
			d + """
				pub {fname} :: fn({ps}){ret_sig(g.rt, g.ropt)} {{
					{lines.join(nl1)}
				}}
				"""
		}
	}

	emit("{out}/api_utility.oi", source(fns))
	"{fns.len()} utility fns"
}
