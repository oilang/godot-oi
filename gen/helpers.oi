module main

use fs
use json.{ Json, Arr, Obj, parse }

at :: fn(o: Obj, k: string) Json {
	if k in o.keys { o[k] } else { :null }
}
has :: fn(o: Obj, k: string) bool {
	k in o.keys
}
text :: fn(o: Obj, k: string) string {
	match at(o, k) {
		v @ string => v,
		_ => ""
	}
}
flag :: fn(o: Obj, k: string) bool {
	match at(o, k) {
		v @ bool => v,
		_ => false
	}
}
num :: fn(o: Obj, k: string) int {
	match at(o, k) {
		v @ float => int.(v),
		_ => 0
	}
}
node :: fn(o: Obj, k: string) Obj {
	match at(o, k) {
		v @ Obj => v,
		_ => []
	}
}

arr :: fn(o: Obj, k: string) []Obj {
	out: []Obj = []
	raw: Arr = match at(o, k) {
		v @ Arr => v,
		_ => []
	}
	loop item in raw {
		out << match item {
			v @ Obj => v,
			_ => []
		}
	}
	out
}

INT_MIN :: "-9223372036854775807 - 1"
INT_MAX :: "9223372036854775807"

lit :: fn(o: Obj, k: string) string {
	s := match at(o, k) {
		v @ float => v.str(),
		_ => "0.0"
	}
	if s.contains("e") {
		return if s.starts_with("-") { INT_MIN } else { INT_MAX }
	}
	s[..s.len - 2]
}

## The `float_64` row of a per-build table.
config :: fn(api: Obj, table: string) Obj {
	loop c in arr(api, table) {
		if text(c, "build_configuration") == "float_64" do return c
	}
	[]
}

load :: fn(path: string) Obj {
	src := fs.read(path) or {
		panic!("gen: {$.message()}, run `just api`")
		""
	}
	parsed :: parse(src) or {
		panic!("gen: {path}: {$.message()}")
		:null
	}
	match parsed {
		v @ Obj => v,
		_ => []
	}
}

caps :: fn(c: u8) bool { c >= 65 && c <= 90 }
low :: fn(c: u8) bool { c >= 97 && c <= 122 }
digit :: fn(c: u8) bool { c >= 48 && c <= 57 }

## `AStar2D` to `a_star_2d`.
snake :: fn(name: string) string {
	out := ""
	loop i in 0..name.len {
		c := name[i]
		if i > 0 {
			p := name[i - 1]
			nl := if i + 1 < name.len {
				low(name[i + 1])
			} else {
				false
			}
			split := if caps(c) {
				low(p) || nl
			} else {
				digit(c) && low(p)
			}
			if split { out += "_" }
		}
		out += name[i..i + 1].lower()
	}
	out
}

## The `Type` variant of a builtin, `PackedInt32Array` to `packed_int32_array`.
vtype :: fn(name: string) string {
	s := snake(name)
	out := ""
	loop i in 0..s.len {
		if s[i] == 95 && i + 1 < s.len && digit(s[i + 1]) do continue
		out += s[i..i + 1]
	}
	out
}

keywords: []string = [
	"break", "comp", "continue", "else", "enum", "fn", "foreign", "if", "in", "is", "loop", "match",
	"module", "move", "mut", "none", "or", "pub", "return", "struct", "trait", "unsafe", "use",
]

## `name` as an identifier, `clash` naming what else is taken where it lands.
safe :: fn(name: string, clash: []string) string {
	if name in keywords || name in clash {
		name + "_"
	} else {
		name
	}
}

## `INHERIT` to `inherit`, `2D` to `_2d`.
variant :: fn(name: string) string {
	if digit(name[0]) {
		"_" + name.lower()
	} else {
		safe(name.lower(), [])
	}
}

## Hand-written in `godot/`: `skip` entirely, `hand` only the struct.
skip: []string = ["StringName"]
hand: []string = ["Object", "RefCounted"]
scalars: []string = ["Nil", "bool", "int", "float"]

rename :: fn(name: string) string {
	if name == "Error" { "GodotError" } else { name }
}
