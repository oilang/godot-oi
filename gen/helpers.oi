module main

use fs
use json

## Fields from `extension_api.json`.
Api :: struct {
	builtin_class_sizes: []Config,
	builtin_class_member_offsets: []Config,
	global_constants: []Const,
	global_enums: []Enum,
	utility_functions: []Method,
	builtin_classes: []Builtin,
	classes: []Class,
	singletons: []Singleton,
	native_structures: []Native,
}

Config :: struct {
	build_configuration: string,
	sizes: ?[]Size,
	classes: ?[]Layout,
}
Size :: struct {
	name: string,
	size: int,
}
Layout :: struct {
	name: string,
	members: []Field,
}
Field :: struct {
	member: string,
	meta: string,
	offset: int,
}

## A global or class constant, or an enum value.
Const :: struct {
	name: string,
	value: float,
	brief_description: ?string,
	description: ?string,
}
Enum :: struct {
	name: string,
	is_bitfield: ?bool,
	values: []Const,
}
Singleton :: struct {
	name: string,
	type: string,
}
Native :: struct {
	name: string,
	format: string,
}

Builtin :: struct {
	name: string,
	has_destructor: bool,
	constructors: []Ctor,
	constants: ?[]Value,
	enums: ?[]Enum,
	methods: ?[]Method,
	brief_description: ?string,
	description: ?string,
}
Ctor :: struct { index: int, arguments: ?[]Param }

## A builtin constant, its value a constructor call like `Vector2(0, 0)`.
Value :: struct {
	name: string,
	value: string,
}

Class :: struct {
	name: string,
	inherits: ?string,
	is_refcounted: bool,
	is_instantiable: bool,
	constants: ?[]Const,
	enums: ?[]Enum,
	methods: ?[]Method,
	properties: ?[]Property,
	signals: ?[]Signal,
	brief_description: ?string,
	description: ?string,
}
Property :: struct {
	name: string,
	getter: string,
	setter: ?string,
	index: ?int,
	brief_description: ?string,
	description: ?string,
}
Signal :: struct {
	name: string,
	brief_description: ?string,
	description: ?string,
}

## A class or builtin method, or a utility fn.
## Classes return a `return_value` node and others return a bare `return_type`.
Method :: struct {
	name: string,
	hash: int,
	is_const: ?bool,
	is_static: ?bool,
	is_vararg: bool,
	is_virtual: ?bool,
	is_required: ?bool,
	arguments: ?[]Param,
	return_value: ?Ret,
	return_type: ?string,
	brief_description: ?string,
	description: ?string,
}
Param :: struct {
	name: string,
	type: string,
	meta: ?string,
	default_value: ?string,
}
Ret :: struct { type: string, meta: ?string }

INT_MIN :: "-9223372036854775807 - 1"
INT_MAX :: "9223372036854775807"

lit :: fn(v: float) string {
	s := v.str()
	if s.contains("e") {
		return if s.starts_with("-") { INT_MIN } else { INT_MAX }
	}
	s[..s.len() - 2]
}

## The `float_64` row of a per-build table.
config :: fn(rows: []Config) Config {
	loop c in rows {
		if c.build_configuration == "float_64" do return c
	}
	Config.{}
}

load :: fn(path: string) Api {
	src := fs.read(path) or {
		panic!("gen: cannot read {path}, run `just api`")
	}
	json.decode[Api](src) or {
		panic!("gen: {path}: {$.message()}")
	}
}

caps :: fn(c: u8) bool { c >= 65 && c <= 90 }
low :: fn(c: u8) bool { c >= 97 && c <= 122 }
digit :: fn(c: u8) bool { c >= 48 && c <= 57 }

## `AStar2D` to `a_star_2d`.
snake :: fn(name: string) string {
	out := ""
	loop i in ..name.len() {
		c := name[i]
		if i > 0 {
			p := name[i - 1]
			nl := if i + 1 < name.len() {
				low(name[i + 1])
			} else {
				false
			}
			split := if caps(c) {
				low(p) || nl
			} else {
				digit(c) && low(p)
			}
			if split { out += "_" }
		}
		out += name[i..i + 1].lower()
	}
	out
}

## The `Type` variant of a builtin, `PackedInt32Array` to `packed_int32_array`.
vtype :: fn(name: string) string {
	s := snake(name)
	out := ""
	loop i in ..s.len() {
		if s[i] == 95 && i + 1 < s.len() && digit(s[i + 1]) do continue
		out += s[i..i + 1]
	}
	out
}

## Godot's BBCode-ish doc markup as plain text.
plain :: fn(s: string) string {
	out := ""
	i := 0
	loop i < s.len() {
		if s[i] != 91 {
			out += s[i..i + 1]
			i += 1
			continue
		}
		j := i + 1
		loop j < s.len() && s[j] != 93 {
			j += 1
		}
		if j == s.len() do break

		tag := s[i + 1..j]
		i = j + 1
		if tag == "code" || tag == "/code" {
			out += "`"
			continue
		}
		if tag.len() == 0 do continue

		# `[method foo]`, `[Node]` and `[@GlobalScope.x]` name something, `[b]` and `[url=..]` are markup
		words := tag.split(" ")
		if words.len() > 1 || caps(tag[0]) || tag[0] == 64 {
			last := words[words.len() - 1]
			out += "`{last}`"
		}
	}
	out
}

## The docs for an api item as comment lines.
## `--dump-extension-api-with-docs` writes whole manual pages.
doc[T] :: fn(o: T, lead: string) string {
	src := o.brief_description or ""
	if src == "" {
		src = o.description or ""
	}
	if src == "" do return ""

	out := ""
	n := 0
	loop line in plain(src).split("\n") {
		t := line.trim()
		if t == "" {
			if n > 0 do break
			continue
		}
		out += "{lead}{t}\n"
		n += 1
		if n == 4 do break
	}
	out
}

keywords :: [
	"and", "break", "cancel", "comp", "continue", "defer", "discard", "do", "else", "enum", "fallthrough", "fn",
	"foreign", "if", "in", "is", "loop", "match", "module", "move", "mut", "none", "or", "pub", "return", "struct",
	"trait", "unsafe", "use", "via", "with",
]

## Method names the core `Drop`, `Copy`, `Display`, and `Debug` traits own.
hooks :: [ "copy", "drop", "fmt", "str", "debug", "repr" ]

## `name` as an identifier, `clash` naming what else is taken where it lands.
safe :: fn(name: string, clash: []string) string {
	if name in keywords || name in clash {
		name + "_"
	} else {
		name
	}
}

## `INHERIT` to `inherit`, `2D` to `_2d`.
variant :: fn(name: string) string {
	if digit(name[0]) {
		"_" + name.lower()
	} else {
		safe(name.lower(), [])
	}
}

## Hand-written overrides.
skip :: [ "StringName" ]
hand :: [ "Object" "RefCounted" ]
scalars :: [ "Nil" "bool" "int" "float" ]

rename :: fn(name: string) string {
	if name == "Error" { "GodotError" } else { name }
}
