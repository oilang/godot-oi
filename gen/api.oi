module main

## Generate Godot types.
## Enums, constants, structs, builtins, etc.

n_enums := 0

## The prefix every value of a Godot enum shares.
prefix :: fn(names: []string) string {
	if names.len() < 2 do return ""
	pre := ""
	loop word in names[0].split("_") {
		cand := pre + word + "_"
		loop name in names {
			if !name.starts_with(cand) do return pre
		}
		pre = cand
	}
	pre
}

## A flat enum, or an `i64` plus consts for a bitfield in `masks`.
enum_block :: fn(label, name, owner: string; values: []Const, bitfield: bool) s: string {
	pre := prefix(loop v in values do v.name)
	raw := bitfield && name in masks
	tag := if bitfield do " (bitfield)" else do ""
	if raw {
		s += "## {label}{tag}\npub {name} :: i64\n"
	} else {
		s += "## {label}{tag}\npub {name} :: enum {{\n"
	}

	seen: []string
	aliases: []string
	combos: []Const
	loop v in values {
		vname := v.name
		n := lit(v.value)
		if raw {
			s += doc(v, "## ") + "pub {owner}{vname} :: {n}\n"
			continue
		}

		vn := variant(vname[pre.len()..vname.len()])
		key := "{name}:{n}"
		m := int.(v.value)
		if bitfield && (n in seen || m <= 0 || m & (m - 1) != 0) {
			combos << v
			continue
		}
		if n in seen {
			aliases << "\tpub {vn} :: fn() {name} {{ {name}.{enum_values[key]} }}\n"
			continue
		}

		seen << n
		bit := 0
		loop bitfield && 1 << bit < m do bit += 1
		s += doc(v, "\t# ") + "\t{vn} = " + if bitfield do "{bit}\n" else do "{n}\n"
		if !(name in enum_first.keys) {
			enum_first[name] = vn
		}
		enum_values[key] = vn
	}
	aliases << loop v in combos {
		vn := variant(v.name[pre.len()..v.name.len()])
		"\tpub {vn} :: fn() Bits[{name}] {{ {bits_lit(name, int.(v.value))} }}\n"
	}

	n_enums += 1
	body := if raw { "{s}\n" } else { "{s}}}\n\n" }
	if aliases.len() > 0 {
		body + "{name} :< {{\n" + aliases.join("") + "}}\n\n"
	} else do body
}

## A mask as a `Bits` literal over the flags of `name`.
bits_lit :: fn(name: string, mask: int) string {
	flags: []string
	loop b in ..63 {
		if mask & 1 << b == 0 do continue
		key := "{name}:{1 << b}"
		if !(key in enum_values.keys) do return ""
		flags << "." + enum_values[key]
	}
	".[" + flags.join(" ") + "]"
}

## The enums nested in builtins or classes, as `{Owner}{Enum}`.
owner_enums[T] :: fn(items: []T) s: string {
	loop c in items {
		pre := snake(c.name).upper() + "_"
		loop e in c.enums or [] {
			s += enum_block(
				"{c.name}.{e.name}",
				c.name + e.name,
				pre,
				e.values,
				e.is_bitfield or false
			)
		}
	}
	s
}

enums :: fn(api: Api) s: string {
	loop e in api.global_enums {
		s += enum_block(e.name, enum_name(e.name), "", e.values, e.is_bitfield or false)
	}
	emit(
		"{out}/api_enums.oi",
		head + s + owner_enums(api.builtin_classes) + owner_enums(api.classes)
	)
	"{n_enums} enums"
}

constants :: fn(api: Api) s: string {
	items := api.global_constants
	loop c in items {
		s += "## @GlobalScope.{c.name}\n" + doc(c, "## ") + "pub {c.name} :: {lit(c.value)}\n"
	}
	emit("{out}/api_constants.oi", head + s)
	"{items.len()} constants"
}

## Get the C type for a native struct format.
ctype :: fn(t: string) string {
	match t {
		"int" => "i32",
		"int32_t" => "i32",
		"int64_t" => "i64",
		"uint8_t" => "u8",
		"uint16_t" => "u16",
		"uint32_t" => "u32",
		"uint64_t" => "u64",
		"float" => "f32",
		"real_t" => "f32",
		"double" => "f64",
		"bool" => "bool",
		_ => if t.contains("::") { "i32" } else { t },
	}
}

## A native struct as a `@c` struct, "" when a field has no C layout in Oi.
struct_block :: fn(s: Native) string {
	body := ""
	loop field in s.format.split(";") {
		parts := field.split(" = ")[0].split(" ")
		typ := ctype(parts[0])
		fname := parts[parts.len() - 1]
		if fname.starts_with("*") {
			typ = "ptr"
			fname = fname[1..fname.len()]
		}
		if fname.contains("[") {
			if !(typ in [ "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "bool", "ptr" ]) do return ""
			halves := fname.split("[")
			count := halves[1].split("]")[0]
			fname = halves[0]
			typ = "[{count}]{typ}"
		}
		fname = safe(fname, [])
		body += "\tpub {fname}: {typ}\n"
	}
	"## {s.name}\n@c pub {s.name} :: struct {{\n{body}}}\n\n"
}

structs :: fn(api: Api) s: string {
	n := 0
	loop item in api.native_structures {
		block := struct_block(item)
		if block == "" do continue
		s += block
		n += 1
	}
	emit("{out}/api_structs.oi", head + s)
	"{n} structs"
}

## The member layout of a math builtin, empty when it is opaque.
layout :: fn(offsets: []Layout, name: string) []Field {
	loop c in offsets {
		if c.name == name {
			return c.members
		}
	}
	[]
}

member_type :: fn(meta: string) string {
	match meta {
		"float" => "f32",
		"int32" => "i32",
		_ => meta
	}
}

builtins :: fn(api: Api) string {
	items := api.builtin_classes
	offsets := config(api.builtin_class_member_offsets).classes or []
	opaques: []string = []
	loop b in items {
		if layout(offsets, b.name).len() == 0 && !(b.name in scalars) {
			opaques << b.name
		}
	}
	n := 0
	nm := slot
	loop b in items {
		name := b.name
		if name in skip || name in scalars { continue }

		ms := ""
		loop m in b.methods or [] {
			ms += builtin_method(name, m)
		}

		fields := layout(offsets, name)
		body := if fields.len() > 0 {
			math(name, sizes[name], fields, b.constants or [], ms)
		} else {
			opaque(name, sizes[name], b.has_destructor, b.constructors, opaques, ms)
		}

		body += conv(name, vtype(name), sizes[name], false, false)
		d := doc(b, "## ")
		emit("{out}/api_builtin_{snake(name)}.oi", "{head}## {name}\n{d}{body}")
		n += 1
	}
	"{n} builtins, {slot - nm} methods"
}

## Wrap in quotes.
q :: fn(s: string) string { "\"{s}\"" }

## Write index.json.
index :: fn(api: Api) {
	entries :: loop c in api.classes {
		virtuals :: loop m in c.methods or [] {
			if !(m.is_virtual or false) do continue

			args :: loop a in m.arguments or [] do q(a.type)
			ret := if r := m.return_value do r.type else do "void"
			req := m.is_required or false
			mname := q(m.name)
			open := "{{\"name\":{mname},\"hash\":{m.hash},\"required\":{req},\"args\":["
			open + args.join(",") + "],\"ret\":" + q(ret) + "}}"
		}
		names :: loop e in c.enums or [] do q(e.name)
		body := ",\"virtuals\":[" + virtuals.join(",") + "],\"enums\":[" + names.join(",") + "]}}"
		q(c.name) + ":{{\"parent\":" + q(c.inherits or "") + body
	}
	emit("{out}/api_index.json", "{{" + entries.join(",") + "}}\n")
}
