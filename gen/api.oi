module main

use json.{ Json, Arr, Obj }

## Generate Godot types.
## Enums, constants, structs, builtins, etc.

n_enums := 0

## The prefix every value of a Godot enum shares.
prefix :: fn(names: []string) string {
	if names.len() < 2 do return ""
	pre := ""
	loop word in names[0].split("_") {
		cand := pre + word + "_"
		loop name in names {
			if !name.starts_with(cand) do return pre
		}
		pre = cand
	}
	pre
}

## A flat enum, or an `i64` plus consts for a bitfield in `masks`.
enum_block :: fn(label, name, owner: string; values: []Const, bitfield: bool) []string {
	pre := prefix(loop v in values do v.name)
	tag := if bitfield do " (bitfield)" else do ""
	n_enums += 1
	if bitfield && name in masks {
		consts := loop v in values do doc(v, "## ") + "pub {owner}{v.name} :: {lit(v.value)}"
		return [ [ "## {label}{tag}", "pub {name} :: i64", ..consts ].join(nl) ]
	}

	seen: []string
	variants: []string
	bits: []string
	aliases: []string
	combos: []Const
	loop v in values {
		n := lit(v.value)
		vn := variant(v.name[pre.len()..v.name.len()])
		key := "{name}:{n}"
		m := int.(v.value)
		if bitfield && (n in seen || m <= 0 || m & (m - 1) != 0) {
			combos << v
			continue
		}
		if n in seen {
			aliases << "\tpub {vn} :: fn() {name} {{ {name}.{enum_values[key]} }}"
			continue
		}

		seen << n
		bit := 0
		loop bitfield && 1 << bit < m do bit += 1
		discriminant := if bitfield do "{bit}" else do n
		line := doc(v, "\t# ") + "\t{vn} = {discriminant}"
		if bitfield {
			loop bits.len() <= bit do bits << ""
			bits[bit] = line
		} else {
			variants << line
		}
		if !(name in enum_first.keys) {
			enum_first[name] = vn
		}
		enum_values[key] = vn
	}

	# declaration position is the bit, so unnamed bits get placeholders
	variants << loop i in ..bits.len() {
		if bits[i] == "" do "\tbit_{i} = {i}" else do bits[i]
	}
	aliases << loop v in combos {
		vn := variant(v.name[pre.len()..v.name.len()])
		"\tpub {vn} :: fn() Bits[{name}] {{ {bits_lit(name, int.(v.value))} }}"
	}

	decl := """
		## {label}{tag}
		pub {name} :: enum {{
		{variants.join(nl)}
		}}
		"""
	if aliases.len() == 0 do return [ decl ]
	return [ decl, "{name} :< {{\n{aliases.join(nl)}\n}}" ]
}

## A mask as a `Bits` literal over the flags of `name`.
bits_lit :: fn(name: string, mask: int) string {
	flags: []string
	loop b in ..63 {
		if mask & 1 << b == 0 do continue
		key := "{name}:{1 << b}"
		if !(key in enum_values.keys) do return ""
		flags << "." + enum_values[key]
	}
	".[" + flags.join(" ") + "]"
}

## The enums nested in builtins or classes, as `{Owner}{Enum}`.
owner_enums[T] :: fn(items: []T) blocks: []string {
	loop c in items {
		pre := snake(c.name).upper() + "_"
		loop e in c.enums {
			blocks << enum_block("{c.name}.{e.name}", c.name + e.name, pre, e.values, e.is_bitfield)
		}
	}
	blocks
}

enums :: fn(api: Api) string {
	blocks: []string
	loop e in api.global_enums {
		blocks << enum_block(e.name, enum_name(e.name), "", e.values, e.is_bitfield)
	}
	blocks << owner_enums(api.builtin_classes) << owner_enums(api.classes)
	emit("{out}/api_enums.oi", source(blocks))
	"{n_enums} enums"
}

constants :: fn(api: Api) string {
	items := api.global_constants
	consts := loop c in items do "## @GlobalScope.{c.name}\n" + doc(c, "## ") + "pub {c.name} :: {lit(c.value)}"
	emit("{out}/api_constants.oi", source([ consts.join(nl) ]))
	"{items.len()} constants"
}

## Get the C type for a native struct format.
ctype :: fn(t: string) string {
	match t {
		"int" => "i32",
		"int32_t" => "i32",
		"int64_t" => "i64",
		"uint8_t" => "u8",
		"uint16_t" => "u16",
		"uint32_t" => "u32",
		"uint64_t" => "u64",
		"float" => "f32",
		"real_t" => "f32",
		"double" => "f64",
		"bool" => "bool",
		_ => if t.contains("::") { "i32" } else { t },
	}
}

## A native struct as a `@c` struct, none when a field has no C layout in Oi.
struct_block :: fn(s: Native) ?string {
	fields := loop field in s.format.split(";") {
		parts := field.split(" = ")[0].split(" ")
		typ := ctype(parts[0])
		fname := parts[parts.len() - 1]
		if fname.starts_with("*") {
			typ = "ptr"
			fname = fname[1..fname.len()]
		}
		if fname.contains("[") {
			if !(typ in [ "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "bool", "ptr" ]) do return none
			halves := fname.split("[")
			count := halves[1].split("]")[0]
			fname = halves[0]
			typ = "[{count}]{typ}"
		}
		"pub {safe(fname, [])}: {typ}"
	}
	"""
		## {s.name}
		@c pub {s.name} :: struct {{
			{fields.join(nl1)}
		}}
		"""
}

structs :: fn(api: Api) string {
	blocks := loop item in api.native_structures do struct_block(item) or do continue
	emit("{out}/api_structs.oi", source(blocks))
	"{blocks.len()} structs"
}

## The member layout of a math builtin, empty when it is opaque.
layout :: fn(offsets: []Layout, name: string) []Field {
	loop c in offsets {
		if c.name == name {
			return c.members
		}
	}
	[]
}

member_type :: fn(meta: string) string {
	match meta {
		"float" => "f32",
		"int32" => "i32",
		_ => meta
	}
}

builtins :: fn(api: Api) string {
	items := api.builtin_classes
	offsets := config(api.builtin_class_member_offsets).classes
	opaques: []string = []
	loop b in items {
		if layout(offsets, b.name).len() == 0 && !(b.name in scalars) {
			opaques << b.name
		}
	}
	n := 0
	nm := slot
	loop b in items {
		name := b.name
		if name in scalars do continue

		ms := loop m in b.methods do builtin_method(name, m) or do continue
		fields := layout(offsets, name)
		blocks := if fields.len() > 0 {
			math(name, sizes[name], fields, b.constants, ms)
		} else {
			opaque(name, sizes[name], b.has_destructor, b.constructors, opaques, ms)
		}
		d := doc(b, "## ")
		blocks[0] = "## {name}\n{d}{blocks[0]}"
		blocks << collection(name, b.methods) << conv(name, vtype(name), sizes[name], false, false)
		emit("{out}/api_builtin_{snake(name)}.oi", source(blocks))
		n += 1
	}
	"{n} builtins, {slot - nm} methods"
}

## Write index.json, the parents, virtuals, and enums `godot/attr.oi` reads at comptime.
index :: fn(api: Api) {
	root: Obj = []
	loop c in api.classes {
		virtuals: Arr = loop m in c.methods {
			if !m.is_virtual do continue
			args: Arr = loop a in m.arguments do Json.(a.type)
			ret := if r := m.return_value do r.type else do "void"
			Json.(Obj.[
				"name" = m.name,
				"hash" = float.(m.hash),
				"required" = m.is_required,
				"args" = args,
				"ret" = ret,
			])
		}
		nested: Arr = loop e in c.enums do Json.(e.name)
		root[c.name] = Obj.[ "parent" = c.inherits or "", "virtuals" = virtuals, "enums" = nested ]
	}
	emit("{out}/api_index.json", Json.(root).str() + nl)
}
