module main

## Generate Godot classes.

slot := 0
skipped := 0
accs := 0
sizes: [string]int
class_set: [string]bool
refcounted: [string]bool

## Classes by name and their inheritors.
all_classes: []Class
class_at: [string]int
parents: [string]string

## Builtins with a Drop hook.
hooked: [string]bool

## Member metas per math builtin, comma-joined, to `fill` a default.
member_metas: [string]string

## Params of these types take a plain `string`, built into the engine type inside the wrapper.
strargs :: [ "String" "StringName" "NodePath" ]

## Enum to first variant, and `<enum>:<value>` to variant, for defaults.
enum_first: [string]string
enum_values: [string]string
narrow :: [ "int8" "int16" "int32" "uint8" "uint16" ]

## Arg names that would shadow a local of the wrapper.
taken :: [ "bool" "string" "int" "float" "ptr" "i64" "i32" "f64" "f32" "u8" "usize" "gd" "blk" "mb" "rv" "at" "all" ]

enum_name :: fn(raw: string) string {
	rename(raw.split(".").join(""))
}

prepare :: fn(api: Api) {
	loop s in config(api.builtin_class_sizes).sizes {
		sizes[s.name] = s.size
	}
	all_classes = api.classes
	loop c, i in all_classes {
		class_set[c.name] = true
		refcounted[c.name] = c.is_refcounted
		class_at[c.name] = i
		parents[c.name] = c.inherits or ""
	}
	loop b in api.builtin_classes {
		hooked[b.name] = b.has_destructor
	}
	loop c in config(api.builtin_class_member_offsets).classes {
		member_metas[c.name] = (loop m in c.members do m.meta).join(",")
	}
}

## How a value crosses a ptrcall.
Typ :: struct {
	kind: string,
	sig: string,
	size: int,
	name: string,
}

resolve :: fn(t: string, meta: string) ?Typ {
	match t {
		"int" => {
			return Typ.{
				"int",
				if meta in narrow { "i32" } else { "i64" },
				8,
				t,
			}
		},
		"float" => {
			return Typ.{
				"float",
				if meta == "float" { "f32" } else { "f64" },
				8,
				t,
			}
		},
		"bool" => {
			return Typ.{ "bool", "bool", 8, t }
		},
		"Variant" => {
			return Typ.{ "variant", "Variant", 0, t }
		},
	}

	match {
		t.starts_with("enum::") => {
			name := enum_name(t[6..t.len()])
			if !(name in enum_first.keys) do return none
			return Typ.{ "enum", name, 8, name }
		},
		t.starts_with("bitfield::") => {
			name := enum_name(t[10..t.len()])
			if name in masks do return Typ.{ "bitfield", "i64", 8, t }
			return Typ.{ "flags", "Bits[{name}]", 8, name }
		},
		t.starts_with("typedarray::") => {
			return Typ.{ "builtin", "Array", sizes["Array"], "Array" }
		},
		t.starts_with("typeddictionary::") => {
			return Typ.{ "builtin", "Dictionary", sizes["Dictionary"], "Dictionary" }
		},
		t.ends_with("*") => {
			return Typ.{ "ptr", "ptr", 8, t }
		},
		t in class_set.keys => {
			return Typ.{
				if refcounted[t] { "refobj" } else { "object" },
				t,
				8,
				t,
			}
		},
		t in sizes.keys => {
			return Typ.{ "builtin", t, sizes[t], t }
		},
	}

	none
}

zeroish :: fn(d: string) bool {
	loop c in 1..=9 {
		if d.contains("{c}") do return false
	}
	true
}

## An api `String` / `StringName` / `NodePath` default as an Oi string literal.
str_default :: fn(d: string) string {
	lit := match {
		d.starts_with("&\"") => { d[1..d.len()] },
		d.starts_with("NodePath(\"") => { d[9..d.len() - 1] },
		d.starts_with("\"") => { d },
		_ => { "" }
	}
	# a brace would read as interpolation
	if lit.contains("{{") do "" else do lit
}

## The Oi default for an api default.
default :: fn(typ: Typ, d: string) string {
	if d == "" do return ""
	if typ.sig == "string" do return str_default(d)

	key := "{typ.name}:{d}"
	match typ.kind {
		"int" => d,
		"bitfield" => d,
		"flags" => bits_lit(typ.name, int.try_from(d) or 0),
		"bool" => d,
		"float" => match {
			d.contains("e") || d.contains("inf") || d.contains("nan") => "",
			d.contains(".") => d,
			_ => "{d}.0",
		},
		"enum" => if key in enum_values.keys { "." + enum_values[key] },
		"object" => if d == "null" do "none",
		"refobj" => if d == "null" do "none",
		"variant" => if d == "null" do "none",
		"builtin" => match {
			hooked[typ.name] => "godot.{typ.sig}.new()",
			typ.name in member_metas.keys => {
				if f := fill(typ.name, d, member_metas[typ.name].split(",")) do "godot.{f}" else do ""
			},
			zeroish(d) => "none",
			_ => ""
		},
		_ => "",
	}
}

Arg :: struct {
	name: string,
	typ: Typ,
	opt: bool,
	def: string,
}

## The raw value stored for arg `i`, the converted local when it came in as a `string`.
value :: fn(a: Arg, i: int) string {
	n := if a.typ.sig == "string" do "sa_{i}" else do a.name
	match a.typ.kind {
		"int" => if a.typ.sig == "i32" do "i64.({n})" else do n,
		"float" => if a.typ.sig == "f32" do "f64.({n})" else do n,
		"enum" => "i64.({n})",
		"flags" => "{n}.mask()",
		"object" => if a.opt {
			"match {n} {{ .some.(o_) => o_.object, .none => ptr.(0) }}"
		} else do "{n}.object",
		"refobj" => if a.opt {
			"match {n} {{ .some.(o_) => o_.object, .none => ptr.(0) }}"
		} else do "{n}.object",
		_ => n,
	}
}

round8 :: fn(n: int) int { (n + 7) / 8 * 8 }

Sig :: struct {
	args: []Arg,
	rt: Typ,
	ropt: bool,
}

## Args of a method, `none` when a type does not resolve.
args_of :: fn(raw: []Param) ?[]Arg {
	typs := []Typ.[]
	defs := []string.[]

	loop a in raw {
		typ := resolve(a.type, a.meta or "") or do return none
		if typ.name in strargs {
			typ.sig = "string"
		}
		typs << typ
		defs << default(typ, a.default_value or "")
	}

	first := defs.len()
	loop i in ..defs.len() {
		if defs[defs.len() - 1 - i] == "" do break
		first = defs.len() - 1 - i
	}

	args: []Arg
	loop i in ..raw.len() {
		def := if i >= first do defs[i]
		byref := typs[i].kind in [ "object", "refobj" ]
		opt := if byref {
			(raw[i].meta or "") != "required"
		} else {
			def == "none"
		}
		args << Arg.{
			safe(raw[i].name, taken),
			typs[i],
			opt,
			def,
		}
	}

	args
}

## Args and return signatures.
sig :: fn(m: Method) ?Sig {
	args := args_of(m.arguments) or do return none

	rt := Typ.{ "void", "", 0, "" }
	ropt := false
	ret := m.return_value or Ret.{ type = m.return_type or "" }
	if ret.type != "" {
		meta := ret.meta or ""
		rt = resolve(ret.type, meta) or do return none
		ropt = rt.kind in [ "object", "refobj" ] && meta != "required"
	}
	Sig.{ args, rt, ropt }
}

params :: fn(args: []Arg, recv: string, tail := "") string {
	list := loop a in args {
		t := if a.opt do "?{a.typ.sig}" else do a.typ.sig
		if a.def == "" { "{a.name}: {t}" } else { "{a.name}: {t} = {a.def}" }
	}
	if tail != "" { list << tail }
	ps := list.join(", ")
	# NOTE: `;` is for param grouping
	if recv == "" || ps == "" { recv + ps } else { "{recv}; {ps}" }
}

## A string param as the engine type it stands for.
strarg :: fn(a: Arg, i: int) string {
	"sa_{i} := {a.typ.name}.({a.name})"
}

## Write arg `i` into its storage.
put :: fn(a: Arg, i: int, store: string) []string {
	n :: a.name
	cell :: "unsafe ptr.(blk.0 + {8 * i}).write"
	pre := if a.typ.sig == "string" do [ strarg(a, i) ] else do []string.[]

	match {
		a.typ.kind == "variant" && a.opt => [ "va_{i} := {n} or gd.variant()", "{cell}(va_{i}.at)" ],
		a.typ.kind == "variant" => [ ..pre, "{cell}({value(a, i)}.at)" ],
		a.opt && a.typ.kind == "builtin" => [
			..pre,
			"{cell}({store})",
			"match {n} {{ .some.(b_) => unsafe {store}.write(b_), .none => {{}} }}",
		],
		_ => [ ..pre, "{cell}({store})", "unsafe {store}.write({value(a, i)})" ],
	}
}

object_return :: fn(rt: Typ, opt: bool, p: string) []string {
	if !opt do return [ "rv := {rt.sig}.from_ptr({p})" ]
	return [
		"p_ := {p}",
		"r_ := {rt.sig}.from_ptr(p_)",
		"rv := if p_.is_null() {{ ?{rt.sig}.(none) }} else {{ ?{rt.sig}.(r_) }}",
	]
}

## What an enum code the enum lacks reads as, a failure for `GodotError` and the first variant otherwise.
lacking :: fn(rt: Typ) string {
	if rt.sig == "GodotError" do "failed" else do enum_first[rt.name]
}

## Read the return out of the ptrcall storage.
get :: fn(rt: Typ, ropt: bool, roff: int) []string {
	read :: "unsafe ptr.(blk.0 + {roff}).read"
	rv := match rt.kind {
		"int" => if rt.sig == "i32" do "i32.({read}[i64]())" else do "{read}[i64]()",
		"float" => if rt.sig == "f32" do "f32.({read}[f64]())" else do "{read}[f64]()",
		"bool" => "{read}[bool]()",
		"bitfield" => "{read}[i64]()",
		"flags" => "bits_of[{rt.name}]({read}[i64]())",
		"ptr" => "{read}[ptr]()",
		"enum" => "{rt.sig}.from({read}[i64]()) or .{lacking(rt)}",
		"builtin" => "{read}[{rt.sig}]()",
		"object" => return object_return(rt, ropt, "{read}[ptr]()"),
		"refobj" => return object_return(rt, ropt, "gd.ref_get_object(ptr.(blk.0 + {roff}))"),
		_ => return [],
	}
	return [ "rv := {rv}" ]
}

## Fixed args boxed into `Variant`s, then `Godot.call` with the trailing `varargs`.
vararg :: fn(bind: string, this: string, args: []Arg, rt: Typ) lines: []string {
	if args.len() > 0 {
		lines << "blk := unsafe calloc(1, usize.({8 * args.len()}))"
	}
	lines << "all: []Variant"
	loop a, i in args {
		if a.typ.sig == "string" {
			lines << strarg(a, i)
		}
		store := "ptr.(blk.0 + {8 * i})"
		lines << "va_{i} := gd.variant()"
		lines << "unsafe {store}.write({value(a, i)})"
		lines << "gd.from_type(.{vtype(a.typ.name)}, va_{i}, {store})"
		lines << "all << va_{i}"
	}
	lines << "all << varargs" << bind << "rv := gd.call({this}, mb, all)"
	if args.len() > 0 {
		lines << "unsafe free(blk)"
	}
	if rt.kind != "enum" do return lines << "rv"
	lines << "code := {rt.sig}.from(rv.int()) or .{lacking(rt)}" << "if code != .ok do return error(code)"
}

## The engine fn a wrapper wraps, what it is called on, and how it disposes of the receiver.
Call :: struct {
	kind: string,
	this: string,
	bind: string,
	after: string,
}

invoke :: fn(c: Call, argp: string, rptr: string, argc: int) string {
	match c.kind {
		"builtin" => "unsafe BuiltinMethod.(mb)({c.this}, {argp}, {rptr}, {argc})",
		"utility" => "unsafe UtilityFunction.(mb)({rptr}, {argp}, {argc})",
		"operator" => {
			right := if argc > 0 do "unsafe blk.read[ptr]()" else do "ptr.(0)"
			"unsafe Evaluator.(mb)({c.this}, {right}, {rptr})"
		},
		_ => "gd.method_bind_ptrcall(mb, {c.this}, {argp}, {rptr})",
	}
}

ret_sig :: fn(rt: Typ, ropt: bool) string {
	match {
		rt.kind == "void" => "",
		rt.sig == "GodotError" => " !()",
		ropt => " ?{rt.sig}",
		_ => " {rt.sig}"
	}
}

## Storage is a pointer cell per arg, then 8-aligned storage per arg, then the return.
ptrcall_body :: fn(args: []Arg, rt: Typ, ropt: bool, c: Call) lines: []string {
	cursor := 8 * args.len()
	offs: []int
	loop a in args {
		offs << cursor
		if a.typ.kind == "variant" {
			continue
		}
		cursor += round8(a.typ.size)
	}

	roff := cursor
	if !(rt.kind in ["void", "variant"]) {
		cursor += round8(rt.size)
	}
	if cursor > 0 {
		lines << "blk := unsafe calloc(1, usize.({cursor}))"
	}
	loop a, i in args, off in offs {
		lines << put(a, i, "ptr.(blk.0 + {off})")
	}

	rptr := match {
		rt.kind == "variant" => "rv.at",
		rt.kind == "void" => "ptr.(0)",
		_ => "ptr.(blk.0 + {roff})",
	}

	if rt.kind == "variant" {
		lines << "rv := gd.variant()"
	}
	argp := if args.len() > 0 do "blk" else do "ptr.(0)"
	lines << c.bind << invoke(c, argp, rptr, args.len()) << get(rt, ropt, roff)
	if c.after != "" {
		lines << c.after
	}

	if cursor > 0 {
		lines << "unsafe free(blk)"
	}
	if rt.sig == "GodotError" {
		lines << "if rv != .ok do return error(rv)"
	} else if rt.kind != "void" {
		lines << "rv"
	}

	lines
}

method :: fn(cname: string, m: Method) ?string {
	g :: sig(m) or {
		skipped += 1
		return none
	}
	static := m.is_static
	this := if static do "ptr.(0)" else do "self.object"
	recv := if static do "" else do "self"
	tail := if m.is_vararg do "varargs: ..Variant" else do ""
	ps := params(g.args, recv, tail)
	bind := """mb := gd.bind({slot}, "{cname}", "{m.name}", {m.hash})"""
	slot += 1

	lines := if m.is_vararg {
		vararg(bind, this, g.args, g.rt)
	} else {
		ptrcall_body(g.args, g.rt, g.ropt, Call.{ "class", this, bind, "" })
	}
	rs := match {
		!m.is_vararg => ret_sig(g.rt, g.ropt),
		g.rt.kind == "enum" => " !()",
		_ => " Variant",
	}
	doc(m, "\t## ") + """
			pub {safe(m.name, hooks)} :: fn({ps}){rs} {{
				{lines.join(nl2)}
			}}
		"""
}

## Get the non-virtual method named `name`, from `cname` or an ancestor.
## The dump omits underscore-prefixed accessors (`_set_anchor`, `_get_filters`), so those properties stay without a getter or setter.
## Reaching them needs `Object.call` by name.
member :: fn(cname: string, name: string) ?Method {
	n := cname
	loop n != "" {
		if !(n in class_at.keys) do break
		loop m in all_classes[class_at[n]].methods {
			if m.name != name do continue
			if m.is_virtual do continue
			return m
		}
		n = parents[n]
	}
	none
}

## `properties` accessors over the getter and setter, wherever they are declared.
accessors :: fn(c: Class, used: []string) fns: []string {
	cname := c.name
	names := used
	loop p in c.properties {
		raw := p.name
		pname := safe(raw, [])
		gname := p.getter
		gm := member(cname, gname) or do continue
		gs := sig(gm) or do continue

		nidx := if p.index == none do 0 else do 1
		if gs.args.len() != nidx do continue
		idx := ""
		if iv := p.index {
			idx = default(gs.args[0].typ, "{iv}")
			if idx == "" do continue
		}

		d := doc(p, "\t## ")
		if !(pname in names) {
			names << pname
			accs += 1
			g := safe(gname, hooks)
			fns << d + "\tpub {pname} :: fn(self){ret_sig(gs.rt, gs.ropt)} {{ self.{g}({idx}) }}"
		}

		sname := p.setter or do continue
		sfn := "set_{raw}"
		if sfn in names do continue
		sm := member(cname, sname) or do continue
		ss := sig(sm) or do continue
		if ss.args.len() != nidx + 1 do continue

		names << sfn
		accs += 1
		one: []Arg
		one << ss.args[ss.args.len() - 1]
		lead := if idx != "" do "{idx}, "
		st := safe(sname, hooks)
		ps := params(one, "self")
		fns << d + "\tpub {sfn} :: fn({ps}){ret_sig(ss.rt, ss.ropt)} {{ self.{st}({lead}{one[0].name}) }}"
	}
	fns
}

## The members of a class's fill.
## `cast` from a bare `Object`, `new` when instantiable, then signals, every non-virtual method, and accessors.
members :: fn(c: Class) fns: []string {
	name := c.name

	if name != "Object" {
		cast := if refcounted[name] {
			[ "r_ := {name}.from_ptr(o.object)", "_ := r_.init_ref()", "rv := ?{name}.(r_)", "rv" ]
		} else do [ "{name}.from_ptr(o.object)" ]
		fns << """
				pub cast :: fn(o: Object) ?{name} {{
					if !o.is_a("{name}") {{ return ?{name}.(none) }}
					{cast.join(nl2)}
				}}
			"""
	}

	names :: loop m in c.methods do m.name

	if c.is_instantiable && !("new" in names) {
		fns << """
				pub new :: fn() {name} {{
					name := gd.string_name("{name}")
					p_ := gd.construct_object(name)
					gd.free_name(name)
					n_ := {name}.from_ptr(p_)
					n_.notification(0)
					n_
				}}
			"""
	}

	used: []string = [ "cast", "new", "from_ptr" ]
	used << loop m in c.methods do safe(m.name, hooks)

	loop sg in c.signals {
		raw := sg.name
		fname := safe(snake(raw), [ "cast", "new", "from_ptr" ])
		used << fname
		fns << doc(sg, "\t## ") + """\tpub {fname} :: fn(self) Signal {{ Signal.of(self.object, "{raw}") }}"""
	}

	fns << loop m in c.methods {
		if m.is_virtual do continue
		method(name, m) or do continue
	}

	fns << accessors(c, used)
}

## `Variant` to and from a builtin or class.
conv :: fn(name: string, vt: string, size: int, obj: bool, refc: bool) []string {
	box := if obj do [ "b := unsafe malloc(8)", "unsafe b.write(v.object)" ] else do [ "b := v.bytes()" ]
	unbox := match {
		!obj => [ "{name}.from_bytes(out)" ],
		refc => [ "p_ := unsafe out.read[ptr]()", "unsafe free(out)", "r_ := {name}.from_ptr(p_)", "_ := r_.init_ref()", "r_" ],
		_ => [ "p_ := unsafe out.read[ptr]()", "unsafe free(out)", "{name}.from_ptr(p_)" ],
	}
	to := """
		Variant : From[{name}] < {{
			from :: fn(v: {name}) Variant {{
				x := gd.variant()
				{box.join(nl2)}
				gd.from_type(.{vt}, x, b)
				unsafe free(b)
				x
			}}
		}}
		"""
	from := """
		{name} : From[Variant] < {{
			from :: fn(v: Variant) {name} {{
				out := unsafe malloc({size})
				gd.to_type(.{vt}, v, out)
				{unbox.join(nl2)}
			}}
		}}
		"""
	return [ to, from ]
}

## Size after which to split files.
part_size :: 2**16

## The fill of `name`, cut into one fill per `part_size` of members.
fill_parts :: fn(name: string, ms: []string) parts: []string {
	cur: []string
	size := 0
	loop m in ms {
		if size > part_size {
			parts << "{name} :< {{\n{cur.join(nl)}\n}}"
			cur = []
			size = 0
		}
		cur << m
		size += m.len()
	}
	parts << "{name} :< {{\n{cur.join(nl)}\n}}"
}

classes :: fn(api: Api) string {
	items := api.classes
	loop c in items {
		name := c.name

		ms: []string = []
		if !(name in hand) {
			ms << """
					pub from_ptr :: fn(p: ptr) {name} {{
						x: {name} = .{{}}
						x.object = p
						x
					}}
				"""
		}
		ms << loop k in c.constants {
			doc(k, "\t## ") + "\tpub {k.name} :: {lit(k.value)}"
		}
		ms << members(c)
		fills := fill_parts(name, ms)
		fill := fills[0]

		blocks := if name in hand {
			[ "## The rest of `{name}`, the struct is hand-written in `godot/`.\n{fill}" ]
		} else {
			[ "## {name}\n" + doc(c, "## ") + "@c pub {name} :: struct {{ {parents[name]} }}", fill ]
		}
		blocks << conv(name, "object", 8, true, refcounted[name])
		emit("{out}/api_class_{snake(name)}.oi", source(blocks))

		loop i in 1..fills.len() {
			emit("{out}/api_class_{snake(name)}_{i}.oi", source([ fills[i] ]))
		}
	}
	"{items.len()} classes, {slot} methods, {accs} accessors, {skipped} skipped"
}

## Slot counts.
binds :: fn(api: Api) string {
	emit("{out}/api_binds.oi", source([ """
		## Slots in `Godot.binds`, one per generated call, and in `Godot.singletons`.
		pub BINDS :: {slot}
		pub SINGLETONS :: {api.singletons.len()}
		""" ]))
	"{slot} binds"
}

singletons :: fn(api: Api) string {
	list := api.singletons
	blocks := loop sg, i in list {
		"""
			{sg.type} :< {{
				pub singleton :: fn() {sg.type} {{
					cell := ptr.(gd.singletons.0 + ptr.size * {i})
					p_ := unsafe cell.read[ptr]()
					if p_.is_null() {{
						name := gd.string_name("{sg.name}")
						unsafe cell.write(gd.get_singleton(name))
						gd.free_name(name)
					}}
					{sg.type}.from_ptr(unsafe cell.read[ptr]())
				}}
			}}
			"""
	}
	note := "## Engine singletons, fetched through `global_get_singleton` on first use."
	emit("{out}/api_singletons.oi", source([ note, ..blocks ]))
	"{list.len()} singletons"
}
