module main

## Generate Godot builtins.

Member :: struct {
	name: string,
	typ: string,
	off: int,
}

## `bytes` / `from_bytes` / `set_bytes`.
movers :: fn(name: string, size: int, writes, reads: []string) string {
	"""
			## A malloc'd copy of the bytes for the ptr fns, which free it.
			pub bytes :: fn(self) ptr {{
				b := unsafe malloc({size})
				{writes.join(nl2)}
				b
			}}

			## Take `b` back in place, for a method that mutates its base. Frees `b`.
			pub set_bytes :: fn(mut self; b: ptr) {{
				{reads.join(nl2)}
				unsafe free(b)
			}}

			pub from_bytes :: fn(b: ptr) {name} {{
				v := {name}.{{}}
				v.set_bytes(b)
				v
			}}
		"""
}

## A math builtin as a `@c` struct with real fields, its constants as fills.
math :: fn(name: string, size: int, members: []Field, consts: []Value, methods: []string) []string {
	ms := loop m in members do Member.{ m.member, member_type(m.meta), m.offset }
	fields := loop m in ms do "pub {m.name}: {m.typ}"
	fills := loop k in consts {
		f := fill(name, k.value) or do continue
		"\tpub {k.name} :: {f}"
	}
	writes := loop m in ms do "unsafe b.offset({m.off}).write(self.{m.name})"
	reads := loop m in ms do "self.{m.name} = unsafe b.offset({m.off}).read[{m.typ}]()"
	body := [ movers(name, size, writes, reads), ..fills, ..methods ].join(nl)
	decl := """
		@c pub {name} :: struct {{
			{fields.join(nl1)}
		}}
		"""
	[ decl, "{name} :< {{\n{body}\n}}" ]
}

## An opaque builtin, one `[N]u64` field sized to the engine's.
opaque :: fn(
	name: string,
	size: int,
	destructor: bool,
	ctors: []Ctor,
	opaques: []string,
	methods: []string
) []string {
	t := vtype(name)
	words := (size + 7) / 8

	froms := loop c in ctors {
		args := c.arguments
		if args.len() != 1 do continue

		at := args[0].type
		if at == name || !(at in opaques) do continue

		an := args[0].name
		"""
				pub from_{vtype(at)} :: fn({an}: {at}) {name} {{
					{name}.from_bytes(construct(.{t}, {size}, {c.index}, [{an}.bytes()]))
				}}
			"""
	}
	new := "\tpub new :: fn() {name} {{ {name}.from_bytes(construct(.{t}, {size}, 0, [])) }}"
	writes := [ "unsafe b.write(self)" ]
	reads := [ "self.w = (unsafe b.read[{name}]()).w" ]
	fixed := [ movers(name, size, writes, reads), new, ..froms ].join(para)
	body := [ fixed, ..methods ].join(nl)

	blocks := [
		"@c pub {name} :: struct {{ w: [{words}]u64 }}",
		"{name} :< {{\n{body}\n}}",
	]
	if destructor {
		blocks << "{name} : Drop < {{ drop :: fn(mut self) {{ destroy(.{t}, self.bytes()) }} }}"
		blocks << """
			{name} : Copy < {{
				copy :: fn(mut self) {{ self.set_bytes(construct(.{t}, {size}, 1, [self.bytes()])) }}
			}}
			"""
	}
	blocks << """
		{name} : Eq < {{
			eq :: fn(self; other: {name}) bool {{ equal(.{t}, self.bytes(), other.bytes()) }}
		}}
		"""
}

## Core collection claims off a builtin's `size`, `has`, and `get`, plus `From[[]T]` and `Keyed` on sequences.
collection :: fn(name: string, methods: []Method) []string {
	loop m in methods {
		g := sig(m) or do continue
		a := if g.args.len() > 0 do g.args[0].typ.sig else do ""
		r := g.rt.sig
		match m.name {
			"size" => "{name} : Length < {{ len :: fn(self) int {{ int.(self.size()) }} }}",
			"has" => "{name} : Contains[{a}] < {{ contains :: fn(self; v: {a}) bool {{ self.has(v) }} }}",
			"get" => "{name} : Index[{a}, {r}] < {{ index :: fn(self; i: {a}) {r} {{ self.get(i) }} }}",
			"push_back" => {
				# packed arrays resize once and write in place
				elem := match name {
					"PackedByteArray" => "u8",
					"PackedInt32Array" => "i32",
					"PackedFloat32Array" => "f32",
					"PackedStringArray" => "String",
					_ => a,
				}

				got := if elem == "String" do "self.get(i).str()" else do "self.get(i)"
				fill := if name == "Array" do "loop x in xs do s.push_back(x)" else do [
					"_ := s.resize(i64.(xs.len()))",
					"base := s.bytes()",
					"""at := unsafe OperatorIndex.(gd.proc("{vtype(name)}_operator_index"))""",
					"loop x, i in xs do unsafe at(base, i64.(i)).write({elem}.(x))",
					"unsafe free(base)",
				].join(nl2)

				"""
				{name} : From[[]{a}] < {{
					from :: fn(xs: []{a}) {name} {{
						s := {name}.new()
						{fill}
						s
					}}
				}}

				{name} : Keyed[i64, {a}] < {{
					pairs :: fn(self; after: ?i64) ?({a}, i64) {{
						i := (after or -1) + 1
						if i >= self.size() do return none
						({got}, i)
					}}
				}}
				"""
			},
			_ => continue,
		}
	}
}

## A vararg builtin method over `variant_call`, the base and fixed args boxed into Variants.
## Const instance methods only.
variant_call :: fn(bname: string, name: string, fname: string, g: Sig) string {
	lines := [ "base := self.bytes()", "sv := gd.variant()", "gd.from_type(.{vtype(bname)}, sv, base)", "unsafe free(base)" ]

	all := "varargs"
	if g.args.len() > 0 {
		all = "all"
		lines << "blk := unsafe calloc(1, usize.({8 * g.args.len()}))" << "all: []Variant = []"
		loop a, i in g.args {
			store := "ptr.(blk.0 + {8 * i})"
			lines << "va_{i} := gd.variant()"
			lines << "unsafe {store}.write({value(a, i)})"
			lines << "gd.from_type(.{vtype(a.typ.name)}, va_{i}, {store})"
			lines << "all << va_{i}"
		}
		lines << "all << varargs"
	}

	lines << """mn := gd.string_name("{name}")""" << "rv := gd.variant_call(sv, mn, {all})" << "gd.free_name(mn)"
	if g.args.len() > 0 do lines << "unsafe free(blk)"
	lines << match g.rt.kind {
		"void" => []string.[],
		"variant" => [ "rv" ],
		_ => [
			"out := unsafe malloc(usize.({g.rt.size}))",
			"gd.to_type(.{vtype(g.rt.name)}, rv, out)",
			"{g.rt.sig}.from_bytes(out)",
		],
	}

	ps := params(g.args, "self", "varargs: ..Variant")
	"""
			pub {fname} :: fn({ps}){ret_sig(g.rt, g.ropt)} {{
				{lines.join(nl2)}
			}}
		"""
}

## A builtin method over `variant_get_ptr_builtin_method`.
builtin_method :: fn(bname: string, m: Method) ?string {
	g :: sig(m) or {
		skipped += 1
		return none
	}
	name := m.name
	own := [ "new", "bytes", "from_bytes", "set_bytes", "copy", "drop", "eq", "fmt", "str", "debug", "repr" ]
	fname := safe(name, own)
	d := doc(m, "\t## ")

	static := m.is_static
	if m.is_vararg {
		if static || !m.is_const || g.rt.kind in [ "object" "refobj" ] {
			skipped += 1
			return none
		}
		return d + variant_call(bname, name, fname, g)
	}

	bind := """mb := gd.ptr_bind({slot}, .{vtype(bname)}, "{name}", {m.hash})"""
	slot += 1

	# static vs. const vs. non-const
	recv := match {
		static => "",
		m.is_const => "self",
		_ => "mut self",
	}

	# a const method just frees its copy of the base, a mutating one reads it back
	after := match {
		static => "",
		recv == "self" => "unsafe free(base)",
		_ => "self.set_bytes(base)",
	}

	c := Call.{ "builtin", if static do "ptr.(0)" else do "base", bind, after }
	lines := if static do []string.[] else do [ "base := self.bytes()" ]
	lines << ptrcall_body(g.args, g.rt, g.ropt, c)
	ps := params(g.args, recv)
	d + """
			pub {fname} :: fn({ps}){ret_sig(g.rt, g.ropt)} {{
				{lines.join(nl2)}
			}}
		"""
}

## A builtin literal from a Godot constructor string like `Transform2D(1, 0, ..)`, builtins named with `pre`.
fill :: fn(name: string, value: string, pre := "") ?string {
	open := value.split("(")
	if open.len() != 2 do return none
	nest(name, open[1].split(")")[0].split(", "), pre)
}

## How many of a constructor string's flat numbers a builtin's literal takes.
width :: fn(name: string) int {
	if !(name in member_metas.keys) do return 1
	n := 0
	loop meta in member_metas[name].split(",") do n += width(meta)
	n
}

## `name`'s literal over flat numbers, a builtin member taking its own `width` of them.
nest :: fn(name: string, toks: []string, pre: string) ?string {
	if !(name in member_metas.keys) || toks.len() != width(name) do return none
	parts: []string = []
	at := 0
	loop meta in member_metas[name].split(",") {
		n := width(meta)
		tok := toks[at]
		parts << match meta {
			"float" => match {
				tok == "inf" => "1e400",
				tok.contains(".") => tok,
				_ => "{tok}.0",
			},
			"int32" => tok,
			_ => nest(meta, toks[at..at + n], pre) or do return none,
		}
		at += n
	}
	"{pre}{name}.{{ " + parts.join(", ") + " }}"
}
