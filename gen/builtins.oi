module main

## Generate Godot builtins.

Member :: struct {
	name: string,
	typ: string,
	off: int,
}

## `bytes` / `from_bytes` / `set_bytes`.
movers :: fn(name: string, size: int, ms: []Member) lines: []string {
	lines << "\t## A malloc'd copy of the bytes for the ptr fns, which free it."
	lines << "\tpub bytes :: fn(self) ptr {{"
	lines << "\t\tb := unsafe malloc({size})"

	loop m in ms {
		lines << "\t\tunsafe b.offset({m.off}).write(self.{m.name})"
	}

	lines << "\t\tb"
	lines << "\t}}"
	lines << ""
	lines << "\t## Take `b` back in place, for a method that mutates its base. Frees `b`."
	lines << "\tpub set_bytes :: fn(mut self, b: ptr) {{"

	loop m in ms {
		lines << "\t\tself.{m.name} = unsafe b.offset({m.off}).read[{m.typ}]()"
	}

	lines << "\t\tunsafe free(b)"
	lines << "\t}}"
	lines << ""
	lines << "\tpub from_bytes :: fn(b: ptr) {name} {{"
	lines << "\t\tv := {name}.{{}}"
	lines << "\t\tv.set_bytes(b)"
	lines << "\t\tv"
	lines << "\t}}"

	lines
}

## A math builtin as a `@c` struct with real fields, its constants as fills.
math :: fn(name: string, size: int, members: []Obj, consts: []Obj, methods: string) s: string {
	metas: []string = []
	ms: []Member = []

	s += "@c pub {name} :: struct {{\n"
	loop m in members {
		meta := text(m, "meta")
		mname := text(m, "member")
		metas << meta
		ms << Member.{ mname, member_type(meta), num(m, "offset") }
		s += "\tpub {mname}: {member_type(meta)}\n"
	}
	s += "}}\n\n"

	lines := movers(name, size, ms)
	loop k in consts {
		kname := text(k, "name")
		f := fill(name, text(k, "value"), metas) or { continue }
		lines << "\tpub {kname} :: {f}"
	}

	"{s}{name} :< {{\n" + lines.join("\n") + "\n{methods}}}\n"
}

## An opaque builtin, sized in `u64` words because a fixed array field comes back garbage.
opaque :: fn(
	name: string,
	size: int,
	destructor: bool,
	ctors: []Obj,
	opaques: []string,
	methods: string
) string {
	t := vtype(name)
	ms: []Member = []
	decls: []string = []
	loop i in 0..(size + 7) / 8 {
		ms << Member.{ "w{i}", "u64", 8 * i }
		decls << "w{i}: u64"
	}

	lines: []string = [ "@c pub {name} :: struct {{ " + decls.join(", ") + " }}", "", "{name} :< {{" ]
	lines << movers(name, size, ms)
	lines << ""
	lines << "\tpub new :: fn() {name} {{ {name}.from_bytes(construct(.{t}, {size}, 0, [])) }}"

	loop c in ctors {
		args := arr(c, "arguments")
		if args.len != 1 { continue }

		at := text(args[0], "type")
		if at == name || !(at in opaques) { continue }

		an := text(args[0], "name")
		idx := lit(c, "index")
		vt := vtype(at)

		lines << ""
		lines << "\tpub from_{vt} :: fn({an}: {at}) {name} {{"
		lines << "\t\t{name}.from_bytes(construct(.{t}, {size}, {idx}, [{an}.bytes()]))"
		lines << "\t}}"
	}

	body := lines.join("\n") + "\n{methods}}}\n"

	if destructor {
		body += "\n{name} : Drop < {{ drop :: fn(mut self) {{ destroy(.{t}, self.bytes()) }} }}\n"
		body += "\n{name} : Copy < {{\n"
		body += "\tcopy :: fn(mut self) {{ self.set_bytes(construct(.{t}, {size}, 1, [self.bytes()])) }}\n"
		body += "}}\n"
	}

	body += "\n{name} : Eq < {{\n\teq :: fn(self, other: {name}) bool {{ equal(.{t}, self.bytes(), other.bytes()) }}\n}}\n"

	body
}

## A vararg builtin method over `variant_call`, the base and fixed args boxed into Variants.
## Const instance methods only.
variant_call :: fn(bname: string, name: string, fname: string, g: Sig) string {
	t := vtype(bname)
	lines: []string = []
	lines << "\t\tbase := self.bytes()"
	lines << "\t\tsv := gd.variant()"
	lines << "\t\tgd.from_type(.{t}, sv, base)"
	lines << "\t\tunsafe free(base)"

	all := "varargs"
	drops: []string = []
	if g.args.len > 0 {
		all = "all"
		lines << "\t\tblk := unsafe calloc(1, usize.({8 * g.args.len}))"
		lines << "\t\tall: []Variant = []"
		loop i in 0..g.args.len {
			a := g.args[i]
			store := "ptr(blk.0 + {8 * i})"
			lines << "\t\tva_{i} := gd.variant()"
			lines << "\t\tunsafe {store}.write({value(a, i)})"
			lines << "\t\tgd.from_type(.{vtype(a.typ.name)}, va_{i}, {store})"
			lines << "\t\tall << va_{i}"
			drops << "\t\tva_{i}.drop()"
		}
		lines << "\t\tall << varargs"
		drops << "\t\tunsafe free(blk)"
	}

	lines << "\t\tmn := gd.string_name(\"{name}\")"
	lines << "\t\trv := gd.variant_call(sv, mn, {all})"
	lines << "\t\tmn.destroy()"
	lines << drops
	lines << "\t\tsv.drop()"

	match g.rt.kind {
		"void" => { lines << "\t\trv.drop()" },
		"variant" => { lines << "\t\trv" },
		_ => {
			lines << "\t\tout := unsafe malloc(usize.({g.rt.size}))"
			lines << "\t\tgd.to_type(.{vtype(g.rt.name)}, rv, out)"
			lines << "\t\trv.drop()"
			lines << "\t\t{g.rt.sig}.from_bytes(out)"
		},
	}

	ps := params(g.args, "self")
	"\tpub {fname} :: fn({ps}, varargs: []Variant){ret_sig(g.rt, g.ropt)} {{\n" + lines.join("\n") + "\n\t}}\n"
}

## A builtin method over `variant_get_ptr_builtin_method`.
builtin_method :: fn(bname: string, m: Obj) string {
	g :: sig(m) or {
		skipped += 1
		return ""
	}
	name := text(m, "name")
	fname := safe(name, [ "new", "bytes", "from_bytes", "set_bytes", "copy", "drop", "eq", "str" ])
	d := doc(m, "\t## ")

	if flag(m, "is_vararg") {
		if flag(m, "is_static") || !flag(m, "is_const") || g.rt.kind in [ "object", "refobj" ] {
			skipped += 1
			return ""
		}
		return d + variant_call(bname, name, fname, g)
	}

	n := slot
	slot += 1
	hash := lit(m, "hash")
	bind := "mb := gd.ptr_bind({n}, .{vtype(bname)}, \"{name}\", {hash})"

	# static vs. const vs. non-const
	static := flag(m, "is_static")
	recv := match true {
		static => { "" },
		flag(m, "is_const") => { "self" },
		_ => { "mut self" }
	}
	base := if static { "" } else { "\t\tbase := self.bytes()\n" }

	# a const method just frees its copy of the base, a mutating one reads it back
	after := match true {
		static => { "" },
		recv == "self" => { "\t\tunsafe free(base)\n" },
		_ => { "\t\tself.set_bytes(base)\n" }
	}

	c := Call.{ "builtin", if static { "ptr(0)" } else { "base" }, bind, after }
	ps := params(g.args, recv)

	d + "\tpub {fname} :: fn({ps}){ret_sig(g.rt, g.ropt)} {{\n{base}" + ptrcall_body(g.args, g.rt, g.ropt, c) + "\t}}\n"
}

## Fill a struct.
fill :: fn(name: string, value: string, metas: []string) ?string {
	open := value.split("(")
	if open.len != 2 do return none

	parts: []string = []
	toks := open[1].split(")")[0].split(", ")
	if toks.len != metas.len do return none

	loop i in 0..toks.len {
		tok := toks[i]
		match metas[i] {
			"float" => {
				parts << match true {
					tok == "inf" => { "1e400" },
					tok.contains(".") => { tok },
					_ => { "{tok}.0" }
				}
			},
			"int32" => { parts << tok },
			_ => { return none },
		}
	}
	"{name}.{{ " + parts.join(", ") + " }}"
}
