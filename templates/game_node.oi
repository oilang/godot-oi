gd :: use godot

@gd.class!
GameNode :: struct {
	gd.Node,
	frames: u64,
	speed: f64 = 1.0 @gd.export.{ .range, "0,10,0.5" },
}

@gd.constant.{ "GameNode" }
Mode :: enum { idle, run }

@gd.class!
GameNode :< {
	ready :: fn(mut self) {}

	process :: fn(mut self; delta: f64) {
		self.frames += 1
	}

	@gd.func
	hello :: fn(self) {}

	@gd.hidden
	helper :: fn(self) {}

	@gd.signal
	hit :: fn(self; damage: i64) {}
}
